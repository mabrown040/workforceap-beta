---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="WorkforceAP — Empowering People. Advancing Futures.">
<div class="bold">

  <!-- HERO — full-bleed crimson block -->
  <section class="blk blk--crimson hero">
    <div class="wrap hero__in">
      <span class="pill"><span class="pill__star">★</span>501(c)(3) nonprofit · Employer-recognized certificates</span>
      <h1 class="hero__h">Empowering People.<br><span class="gold">Advancing Futures.</span></h1>
      <p class="hero__sub">Employer-aligned training, professional certificates, and real career support — at no cost to qualifying members.</p>
      <div class="acts">
        <a class="bbtn bbtn--gold" href="/apply">Start your application →</a>
        <a class="bbtn bbtn--outline" href="/find-your-path">Find your path</a>
      </div>
      <div class="hero__stats">
        <div class="hstat"><b>25+ yrs</b><span>in workforce development</span></div>
        <div class="hstat"><b>$0</b><span>for qualifying members</span></div>
        <div class="hstat"><b>~5 min</b><span>to apply, real-team review</span></div>
      </div>
    </div>
  </section>

  <!-- CERT PARTNERS — cream marquee strip -->
  <section class="blk blk--cream creds">
    <div class="wrap">
      <p class="creds__lab">Employer-recognized credentials you can earn</p>
      <div class="creds__row">
        <span class="logo">IBM</span>
        <span class="logo">Google</span>
        <span class="logo">Microsoft</span>
        <span class="logo">AWS</span>
        <span class="logo">CompTIA</span>
        <span class="creds__extra">+ CPT &amp; CLT</span>
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS — crimson block, 4 huge numbered steps -->
  <section class="blk blk--crimson">
    <div class="wrap">
      <div class="head head--light">
        <span class="kick">Simple process</span>
        <h2>Four steps.<br><span class="gold">One application.</span></h2>
      </div>
      <div class="journey">
        <a class="jstep" href="/apply">
          <span class="jnum">01</span>
          <h3>Apply</h3>
          <p>Takes about 5 minutes. No cost for qualifying members — a real team reviews it.</p>
        </a>
        <div class="jstep">
          <span class="jnum">02</span>
          <h3>Get matched</h3>
          <p>We match you to the program track that fits your goals and background.</p>
        </div>
        <div class="jstep">
          <span class="jnum">03</span>
          <h3>Train &amp; certify</h3>
          <p>Build job-ready skills and earn an employer-recognized professional certificate.</p>
        </div>
        <div class="jstep">
          <span class="jnum">04</span>
          <h3>Launch</h3>
          <p>Move into the workforce with resume, interview, and mentor support behind you.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- WHO WE SERVE — cream block, bold tri cards -->
  <section class="blk blk--cream">
    <div class="wrap">
      <div class="head">
        <span class="kick kick--crimson">A connected network</span>
        <h2>Built for members,<br>employers &amp; partners.</h2>
      </div>
      <div class="tri">
        <div class="tcard">
          <span class="tcard__tag tcard__tag--c">Members</span>
          <p>No-cost, employer-aligned training, professional certificates, and a team that supports you to job-ready.</p>
          <a class="tlink" href="/apply">Start your application →</a>
        </div>
        <div class="tcard">
          <span class="tcard__tag tcard__tag--b">Employers</span>
          <p>Build a pipeline of training-aligned candidates for in-demand roles — no per-placement fees.</p>
          <a class="tlink" href="/employers">Talk with us about hiring →</a>
        </div>
        <div class="tcard">
          <span class="tcard__tag tcard__tag--g">Partners</span>
          <p>Extend workforce impact in your community through referral and program partnerships.</p>
          <a class="tlink" href="/partners">Explore partnership →</a>
        </div>
      </div>
      <p class="truth">We're a nonprofit — so we don't inflate outcomes. We publish verified placement data as cohorts complete, with the methodology shown. <a href="/outcomes">See our outcomes →</a></p>
    </div>
  </section>

  <!-- TRUST FACTS — crimson block, big gold numbers -->
  <section class="blk blk--crimson">
    <div class="wrap facts">
      <div class="fact"><div class="fk">25+</div><p>years in workforce development</p></div>
      <div class="fact"><div class="fk">501(c)(3)</div><p>nonprofit organization</p></div>
      <div class="fact"><div class="fk">$0</div><p>for qualifying members</p></div>
      <div class="fact"><div class="fk">5</div><p>employer-recognized cert tracks</p></div>
    </div>
  </section>

  <!-- CLOSING CTA — cream block with crimson slab -->
  <section class="blk blk--cream cta-wrap">
    <div class="wrap">
      <div class="cta">
        <span class="pill pill--onlight"><span class="pill__star">★</span>Reviewed by a real team in 1–2 business days</span>
        <h2>Your next step starts with<br><span class="gold">one application.</span></h2>
        <p>Apply in about 5 minutes — no cost for qualifying members. A real team reviews it and follows up in 1 to 2 business days.</p>
        <div class="acts acts--center">
          <a class="bbtn bbtn--gold" href="/apply">Start your application</a>
          <a class="bbtn bbtn--outline" href="/find-your-path">Find your path</a>
          <a class="bbtn bbtn--outline" href="/employers">For employers</a>
        </div>
      </div>
    </div>
  </section>

</div>
</Layout>

<style>
  .bold{ --ink:#fff; }

  /* full-bleed alternating blocks */
  .blk{ width:100%; }
  .blk--crimson{ background:var(--grad); color:#fff; }
  .blk--cream{ background:var(--bg); color:var(--text); }
  .blk{ padding:96px 0; }
  .cta-wrap{ padding:80px 0; }

  .gold{ color:#e9c879; }

  /* gold PILL — assertive, never clipped (no overflow parent, inline-flex) */
  .pill{
    display:inline-flex; align-items:center; gap:8px; white-space:nowrap;
    background:linear-gradient(135deg,#e3bd6a,#a47f38);
    color:#3a2a08; font-weight:800; font-size:13px; letter-spacing:.02em;
    line-height:1; padding:11px 20px; border-radius:999px;
    box-shadow:0 12px 30px -10px rgba(0,0,0,.45); margin-bottom:26px;
  }
  .pill--onlight{ box-shadow:0 12px 30px -12px rgba(164,127,56,.55); }
  .pill__star{ font-size:12px; }

  /* HERO */
  .hero{ padding:104px 0 96px; position:relative; overflow:hidden; }
  .hero::after{
    content:""; position:absolute; inset:0;
    background:url('https://www.workforceap.org/images/hero-people.webp') center/cover;
    opacity:.10; mix-blend-mode:luminosity; pointer-events:none;
  }
  .hero__in{ position:relative; z-index:1; max-width:880px; }
  .hero__h{
    font-family:'Plus Jakarta Sans',sans-serif; font-weight:800;
    font-size:clamp(46px,8.5vw,108px); line-height:.95; letter-spacing:-.035em;
    margin:0 0 24px;
  }
  .hero__sub{ font-size:clamp(19px,2.4vw,24px); color:rgba(255,255,255,.92); max-width:34em; line-height:1.45; }
  .acts{ display:flex; gap:16px; flex-wrap:wrap; margin:36px 0 0; }
  .acts--center{ justify-content:center; }

  /* big assertive buttons */
  .bbtn{
    display:inline-flex; align-items:center; gap:10px; font-weight:800;
    font-size:18px; padding:18px 34px; border-radius:14px;
    border:2px solid transparent; transition:transform .15s,box-shadow .2s,background .2s,color .2s;
  }
  .bbtn:hover{ transform:translateY(-3px); }
  .bbtn--gold{
    background:linear-gradient(135deg,#e9c879,#a47f38); color:#3a2a08;
    box-shadow:0 16px 38px -12px rgba(164,127,56,.7);
  }
  .bbtn--gold:hover{ box-shadow:0 22px 50px -12px rgba(164,127,56,.8); }
  .bbtn--outline{ background:transparent; color:#fff; border-color:rgba(255,255,255,.55); }
  .bbtn--outline:hover{ background:#fff; color:var(--accent-dark); border-color:#fff; }
  .blk--cream .bbtn--outline{ color:var(--accent-dark); border-color:var(--accent-dark); }
  .blk--cream .bbtn--outline:hover{ background:var(--accent-dark); color:#fff; }

  .hero__stats{ display:flex; gap:40px; flex-wrap:wrap; margin-top:48px; }
  .hstat b{ display:block; font-family:'Plus Jakarta Sans',sans-serif; font-weight:800; font-size:clamp(28px,3.6vw,40px); color:#e9c879; line-height:1; }
  .hstat span{ display:block; font-size:14px; color:rgba(255,255,255,.85); margin-top:6px; }

  /* CERT STRIP */
  .creds{ padding:42px 0; border-top:3px solid var(--gold); border-bottom:1px solid var(--border); }
  .creds__lab{ text-align:center; color:var(--muted); font-size:12px; font-weight:800; letter-spacing:.16em; text-transform:uppercase; margin-bottom:18px; }
  .creds__row{ display:flex; align-items:center; justify-content:center; gap:clamp(24px,5vw,56px); flex-wrap:wrap; }
  .logo{ font-family:'Plus Jakarta Sans',sans-serif; font-weight:800; font-size:clamp(22px,3vw,30px); color:#3a3331; }
  .creds__extra{ color:var(--gold-dark); font-weight:800; font-size:16px; }

  /* SECTION HEADS */
  .head{ margin-bottom:56px; }
  .head h2{ font-family:'Plus Jakarta Sans',sans-serif; font-weight:800; font-size:clamp(38px,6vw,76px); line-height:.96; letter-spacing:-.03em; }
  .kick{ display:inline-block; font-size:13px; font-weight:800; letter-spacing:.16em; text-transform:uppercase; margin-bottom:18px; }
  .head--light .kick{ color:#e9c879; }
  .kick--crimson{ color:var(--crimson); }

  /* JOURNEY — huge numbered steps */
  .journey{ display:grid; grid-template-columns:repeat(4,1fr); gap:0; border-top:1px solid rgba(255,255,255,.25); }
  .jstep{ padding:36px 28px 36px 0; border-left:1px solid rgba(255,255,255,.25); padding-left:28px; color:#fff; display:block; transition:background .2s; }
  .jstep:first-child{ border-left:0; padding-left:0; }
  a.jstep:hover{ background:rgba(255,255,255,.07); }
  .jnum{ font-family:'Plus Jakarta Sans',sans-serif; font-weight:800; font-size:64px; line-height:1; color:#e9c879; display:block; margin-bottom:18px; }
  .jstep h3{ font-family:'Plus Jakarta Sans',sans-serif; font-weight:800; font-size:24px; margin-bottom:10px; }
  .jstep p{ color:rgba(255,255,255,.88); font-size:15px; line-height:1.5; }

  /* TRI CARDS */
  .tri{ display:grid; grid-template-columns:repeat(3,1fr); gap:24px; }
  .tcard{ background:var(--surface); border:1px solid var(--border); border-radius:var(--radius); padding:34px 30px; box-shadow:var(--shadow); border-top:6px solid var(--crimson); transition:transform .2s,box-shadow .25s; }
  .tcard:hover{ transform:translateY(-5px); box-shadow:var(--shadow-lg); }
  .tcard__tag{ display:inline-flex; font-family:'Plus Jakarta Sans',sans-serif; font-weight:800; font-size:22px; margin-bottom:14px; }
  .tcard__tag--c{ color:var(--crimson); }
  .tcard__tag--b{ color:var(--blue); }
  .tcard__tag--g{ color:var(--gold-dark); }
  .tcard:nth-child(2){ border-top-color:var(--blue); }
  .tcard:nth-child(3){ border-top-color:var(--gold); }
  .tcard p{ color:var(--muted); font-size:16px; line-height:1.55; margin-bottom:20px; }
  .tlink{ font-weight:800; color:var(--crimson); font-size:15px; }
  .tcard:nth-child(2) .tlink{ color:var(--blue); }
  .tcard:nth-child(3) .tlink{ color:var(--gold-dark); }
  .truth{ max-width:720px; margin:36px auto 0; text-align:center; color:var(--muted); font-size:14px; background:var(--surface-2); border:1px dashed var(--border); border-radius:14px; padding:18px 22px; }
  .truth a{ color:var(--crimson); font-weight:800; }

  /* FACTS */
  .facts{ display:grid; grid-template-columns:repeat(4,1fr); gap:32px; text-align:center; }
  .fact .fk{ font-family:'Plus Jakarta Sans',sans-serif; font-weight:800; font-size:clamp(40px,6vw,72px); color:#e9c879; line-height:1; }
  .fact p{ color:rgba(255,255,255,.9); font-size:15px; margin-top:10px; }

  /* CTA slab */
  .cta{ background:var(--grad); border-radius:32px; padding:clamp(48px,7vw,84px) clamp(28px,5vw,64px); text-align:center; color:#fff; position:relative; overflow:hidden; }
  .cta::after{ content:""; position:absolute; inset:0; background:url('https://www.workforceap.org/images/hero-people.webp') center/cover; opacity:.10; mix-blend-mode:luminosity; }
  .cta > *{ position:relative; z-index:1; }
  .cta h2{ font-family:'Plus Jakarta Sans',sans-serif; font-weight:800; font-size:clamp(34px,5.5vw,68px); line-height:.98; letter-spacing:-.03em; margin-bottom:18px; }
  .cta p{ font-size:clamp(17px,2.2vw,21px); color:rgba(255,255,255,.92); max-width:38em; margin:0 auto 30px; line-height:1.5; }

  /* responsive */
  @media(max-width:980px){
    .journey{ grid-template-columns:1fr 1fr; }
    .jstep{ border-left:0; padding-left:0; border-top:1px solid rgba(255,255,255,.22); padding-top:30px; }
    .journey{ border-top:0; }
    .tri{ grid-template-columns:1fr; }
    .facts{ grid-template-columns:1fr 1fr; gap:36px; }
  }
  @media(max-width:560px){
    .blk{ padding:64px 0; }
    .journey{ grid-template-columns:1fr; }
    .hero__stats{ gap:28px; }
    .acts .bbtn{ width:100%; justify-content:center; }
  }
</style>
