---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';

// ── Faithful content from the Next route (app/apply/thank-you/page.tsx →
// ConversionThankYouPage) and messages/en.json marketing.thankYou.apply.
// This page is a post-application confirmation; the Next route is noindex.
const title = "You're in.";
const lead = "We'll email next steps within 1 business day.";

// "What to expect" — verbatim bullet copy.
const steps = [
  {
    icon: 'users',
    title: 'Advisor review',
    desc: 'An advisor reviews your application and program fit.',
  },
  {
    icon: 'mail',
    title: 'Email with next steps',
    desc: "You'll get a concrete next step — paperwork, a call, or enrollment instructions.",
  },
  {
    icon: 'award',
    title: 'Training kickoff',
    desc: 'Once enrolled, you start milestones with advisor support through placement.',
  },
];

// CTAs — verbatim labels + destinations.
const ctas = [
  { label: 'Open your dashboard', href: '/dashboard', kind: 'solid' },
  { label: 'Browse programs', href: '/programs', kind: 'glass' },
  { label: 'Back to home', href: '/', kind: 'glass' },
];
---
<Layout
  title="Application received"
  description="Your WorkforceAP application is in. Here is what happens next."
>
<div class="tydepth">

<!-- ══════════════════════════════ HERO — DEPTH STAGE ══════════════════════════════ -->
<section class="stage">
  <div class="aura aura--1"></div>
  <div class="aura aura--2"></div>
  <div class="aura aura--3"></div>
  <div class="grain"></div>

  <div class="wrap stage-inner">
    <span class="pill"><span class="pill__star"><Icon name="check-circle" size={13} /></span>Application received</span>
    <h1>{title} <span class="shimmer">Welcome aboard.</span></h1>
    <p class="sub">{lead}</p>
    <div class="acts acts--center">
      <a class="dbtn dbtn--solid" href="/dashboard">Open your dashboard <span>→</span></a>
      <a class="dbtn dbtn--glass" href="/programs">Browse programs</a>
    </div>
    <p class="reassure"><Icon name="calendar" size={15} /> Reviewed by a real team — next steps within 1 business day.</p>
  </div>
</section>

<!-- ══════════════════════════════ WHAT TO EXPECT ══════════════════════════════ -->
<section class="band band--surface"><div class="wrap">
  <div class="sec-head">
    <span class="eyebrow">What to expect</span>
    <h2>What happens <span class="grad-text">next</span></h2>
    <p>No tests, no gatekeeping. Here's how we move from your application to your first milestone.</p>
  </div>
  <ol class="steps">
    {steps.map((s, i) => (
      <li class="stepcard">
        <div class="num">0{i + 1}</div>
        <div class="sic"><Icon name={s.icon} size={22} /></div>
        <h3>{s.title}</h3>
        <p>{s.desc}</p>
      </li>
    ))}
  </ol>
</div></section>

<!-- ══════════════════════════════ CLOSING CTA — DEPTH crimson band ══════════════════════════════ -->
<section class="close">
  <div class="close__media" aria-hidden="true"></div>
  <div class="close__veil" aria-hidden="true"></div>
  <div class="close__inner wrap">
    <span class="pill pill--solid"><span class="pill__star"><Icon name="sparkle" size={11} /></span>While you wait</span>
    <h2>Keep exploring</h2>
    <p>Check your dashboard, browse training programs, or head back home — we'll be in touch soon.</p>
    <div class="acts acts--center">
      {ctas.map((c) => (
        <a class={`bbtn ${c.kind === 'solid' ? 'bbtn--gold' : 'bbtn--outline'}`} href={c.href}>{c.label}{c.kind === 'solid' ? ' →' : ''}</a>
      ))}
    </div>
  </div>
</section>

</div>

<style>
  /* ===================================================================
     APPLY / THANK-YOU — DEPTH aesthetic (matches programs.astro /
     how-it-works.astro). Crimson depth stage hero → light "what to
     expect" band → crimson closing CTA. Visual-only confirmation page.
     =================================================================== */
  .tydepth{--glass:rgba(255,255,255,.10);--glass-line:rgba(255,255,255,.18)}

  /* ---------------- DEPTH HERO STAGE ---------------- */
  .stage{
    position:relative;overflow:hidden;isolation:isolate;
    background:radial-gradient(140% 120% at 80% -10%, #b8334f 0%, var(--accent-dark) 42%, var(--plum) 74%, #4a0e26 100%);
    color:#fff;padding:96px 0 104px;text-align:center;
  }
  .stage-inner{position:relative;z-index:2;max-width:760px;margin:0 auto;display:flex;flex-direction:column;align-items:center}

  /* glow auras — gold + crimson + white */
  .aura{position:absolute;border-radius:50%;filter:blur(70px);z-index:0;pointer-events:none}
  .aura--1{width:520px;height:520px;top:-170px;right:-120px;background:radial-gradient(circle,rgba(196,154,72,.55),transparent 68%)}
  .aura--2{width:460px;height:460px;bottom:-200px;left:-140px;background:radial-gradient(circle,rgba(173,44,77,.6),transparent 70%)}
  .aura--3{width:360px;height:360px;top:18%;left:46%;background:radial-gradient(circle,rgba(255,255,255,.16),transparent 70%)}

  /* luminosity-masked photo bleeding in from the right */
  .grain{position:absolute;inset:0;z-index:1;mix-blend-mode:overlay;pointer-events:none;
    background-image:url('/images/hero-people.webp');background-size:cover;background-position:center;
    -webkit-mask-image:linear-gradient(90deg,transparent 0%,transparent 42%,#000 100%);
    mask-image:linear-gradient(90deg,transparent 0%,transparent 42%,#000 100%);opacity:.16}

  /* gold PILL */
  .pill{display:inline-flex;align-items:center;gap:7px;max-width:100%;white-space:nowrap;
    background:linear-gradient(135deg,#e3bd6a,#a47f38);color:#3a2c10;font-weight:800;font-size:12.5px;
    letter-spacing:.02em;line-height:1.1;padding:9px 17px;border-radius:999px;
    box-shadow:0 10px 28px -8px rgba(164,127,56,.6),0 1px 0 rgba(255,255,255,.4) inset}
  .pill__star{display:inline-flex;align-items:center}
  @media(max-width:430px){.pill{white-space:normal;text-align:left}}

  .stage h1{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:clamp(40px,6vw,68px);
    line-height:1.02;letter-spacing:-.03em;margin:22px 0 0}
  .shimmer{background:linear-gradient(100deg,#fff 10%,#f3d28f 50%,#fff 90%);
    -webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
  .stage .sub{font-size:20px;line-height:1.55;color:rgba(255,255,255,.86);max-width:34em;margin:22px 0 30px}

  .acts{display:flex;gap:14px;flex-wrap:wrap}
  .acts--center{justify-content:center}

  .reassure{display:inline-flex;align-items:center;gap:8px;margin-top:26px;font-size:14px;font-weight:600;
    color:#fff;background:rgba(255,255,255,.1);border:1px solid var(--glass-line);
    padding:9px 16px;border-radius:999px}

  /* ---------------- LIGHT BODY BAND ---------------- */
  .band{padding:var(--sec-pad) 0}
  .band--surface{background:var(--surface)}

  .sec-head{max-width:720px;margin:0 auto 44px;text-align:center;display:flex;flex-direction:column;align-items:center}
  .sec-head h2{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:clamp(30px,4.4vw,48px);line-height:1.05;letter-spacing:-.02em;margin-bottom:12px}
  .sec-head p{color:var(--muted);font-size:19px;line-height:1.55}
  .eyebrow{display:inline-block;font-size:13px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;color:var(--crimson);margin-bottom:14px}

  /* steps grid */
  .steps{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;list-style:none;margin:0;padding:0;counter-reset:none}
  .stepcard{position:relative;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);
    padding:28px;box-shadow:var(--shadow);transition:transform .2s,box-shadow .25s}
  .stepcard:hover{transform:translateY(-5px);box-shadow:var(--shadow-lg)}
  .stepcard .num{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:30px;
    background:var(--grad-text);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;line-height:1;margin-bottom:14px}
  .stepcard .sic{width:46px;height:46px;border-radius:12px;background:rgba(173,44,77,.1);color:var(--crimson);
    display:grid;place-items:center;margin-bottom:14px}
  .stepcard h3{font-size:18px;font-weight:800;margin-bottom:8px}
  .stepcard p{color:var(--muted);font-size:15px;line-height:1.55}
  @media(max-width:900px){.steps{grid-template-columns:1fr}}

  /* ---------------- DEPTH CLOSING CTA (full-bleed crimson) ---------------- */
  .close{
    position:relative;overflow:hidden;
    width:100vw;left:50%;right:50%;margin-left:-50vw;margin-right:-50vw;
  }
  .close__media{position:absolute;inset:0;background:url('/images/hero-people.webp') center 40%/cover no-repeat}
  .close__veil{position:absolute;inset:0;
    background:linear-gradient(120deg,rgba(173,44,77,.92) 0%,rgba(140,15,55,.9) 50%,rgba(109,20,55,.92) 100%)}
  .close__inner{position:relative;z-index:2;color:#fff;text-align:center;padding:88px 24px 96px;max-width:var(--max);margin:0 auto;display:flex;flex-direction:column;align-items:center}
  .pill--solid{margin-bottom:24px}
  .close__inner h2{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:clamp(34px,5.5vw,64px);line-height:.98;letter-spacing:-.03em;margin-bottom:18px}
  .close__inner p{font-size:clamp(17px,2.2vw,21px);color:rgba(255,255,255,.92);max-width:38em;margin:0 auto 30px;line-height:1.5}

  /* ---------------- RESPONSIVE ---------------- */
  @media(max-width:880px){
    .stage{padding:72px 0 84px}
    .grain{-webkit-mask-image:none;mask-image:none;opacity:.12}
  }
  @media(max-width:560px){
    .acts .bbtn,.acts .dbtn{width:100%;justify-content:center}
  }
</style>
</Layout>
