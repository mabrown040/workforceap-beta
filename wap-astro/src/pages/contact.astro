---
import Layout from '../layouts/Layout.astro';
---
<Layout
  title="Contact Us — WorkforceAP"
  description="Contact Workforce Advancement Project for program questions, enrollment support, and partnership opportunities."
>
<!-- HERO -->
<section class="band band--surface" style="padding-top:64px">
  <div class="wrap" style="text-align:center;max-width:760px;margin:0 auto">
    <span class="eyebrow"><span class="dot"></span>Get in Touch</span>
    <h1 style="font-family:'Plus Jakarta Sans';font-weight:800;font-size:clamp(34px,5vw,56px);margin:18px 0">
      We're here for <span class="grad-text">members, employers, and partners</span> alike.
    </h1>
    <p style="color:var(--muted);font-size:19px;max-width:46em;margin:0 auto">
      Whether you're a current or prospective member with program questions, an employer looking to hire or build a pipeline, a community partner exploring a referral relationship, or a donor interested in supporting no-cost training, reach out and a WorkforceAP team member will respond within 1–2 business days.
    </p>
  </div>
</section>

<!-- CONTACT GRID -->
<section class="band">
  <div class="wrap">
    <div class="cgrid">
      <!-- LEFT: form (static visual) -->
      <div class="formpanel">
        <h2>Send Us a Message</h2>
        <form class="cform" onsubmit="return false">
          <div class="frow">
            <div class="fgroup">
              <label for="first_name">First name <span aria-hidden="true">*</span></label>
              <input id="first_name" type="text" name="first_name" autocomplete="given-name" />
            </div>
            <div class="fgroup">
              <label for="last_name">Last name <span aria-hidden="true">*</span></label>
              <input id="last_name" type="text" name="last_name" autocomplete="family-name" />
            </div>
          </div>
          <div class="fgroup">
            <label for="email">Email <span aria-hidden="true">*</span></label>
            <input id="email" type="email" name="email" autocomplete="email" />
          </div>
          <div class="fgroup">
            <label for="phone">Phone number</label>
            <input id="phone" type="tel" name="phone" autocomplete="tel" />
          </div>
          <div class="fgroup">
            <label class="cbox">
              <input type="checkbox" name="sms_preferred" value="true" />
              <span>I'd prefer to be contacted by text message</span>
            </label>
          </div>
          <div class="fgroup">
            <label for="topic">What can we help with? <span aria-hidden="true">*</span></label>
            <select id="topic" name="topic">
              <option value="">Select a topic…</option>
              <option>Program information</option>
              <option>Eligibility or no-cost member training</option>
              <option>Application help</option>
              <option>Schedule a tour</option>
              <option>Partnership or sponsorship</option>
              <option>Media or press inquiry</option>
              <option>Accessibility issue</option>
              <option>Other</option>
            </select>
          </div>
          <div class="fgroup">
            <label for="message">Your message <span aria-hidden="true">*</span></label>
            <textarea id="message" name="message" rows="5"></textarea>
          </div>
          <button type="submit" class="btn btn--primary" style="width:100%;justify-content:center">Send message</button>
          <p class="footnote">A WorkforceAP team member responds within 1–2 business days.</p>
        </form>
      </div>

      <!-- RIGHT: info tiles + austin card -->
      <div class="infostack">
        <div class="cardgrid">
          <div class="infocard">
            <div class="ic ic--c" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 21s-7-6.3-7-11a7 7 0 0 1 14 0c0 4.7-7 11-7 11z" />
                <circle cx="12" cy="10" r="2.5" />
              </svg>
            </div>
            <h3>Our Location</h3>
            <p>Built in Austin.<br>Available nationwide.</p>
          </div>

          <div class="infocard">
            <div class="ic ic--b" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="5" width="18" height="14" rx="2" />
                <path d="M3 7l9 6 9-6" />
              </svg>
            </div>
            <h3>Email</h3>
            <p><a class="ilink" href="mailto:info@workforceap.org">info@workforceap.org</a></p>
          </div>

          <div class="infocard infocard--gold">
            <div class="ic ic--g" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z" />
              </svg>
            </div>
            <h3>Phone</h3>
            <p class="mono"><a class="ilink" href="tel:+15127771808">(512) 777-1808</a></p>
            <p class="hours">Mon–Fri, 9:00 AM – 5:00 PM CT</p>
          </div>

          <div class="infocard">
            <div class="ic ic--gr" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="9" />
                <path d="M12 7v5l3 2" />
              </svg>
            </div>
            <h3>Response Time</h3>
            <p>We reply within 1–2 business days for most inquiries.</p>
          </div>
        </div>

        <div class="austincard">
          <span class="eyebrow"><span class="dot"></span>Austin-based team</span>
          <h3>Built in Austin, supporting members nationwide</h3>
          <p>We work from Austin, Texas and support members, partners, and employers across the country. Use the form, email, or phone to reach the right WorkforceAP team member. We coordinate with partner organizations, but counselors and partner organizations are not the same thing.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- QUOTE BAND -->
<section class="band band--surface">
  <div class="wrap">
    <div class="quotecard">
      <div class="qmark" aria-hidden="true">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor">
          <path d="M7 7h4v4c0 3-2 5-4 5v-2c1 0 2-1 2-3H7V7zm8 0h4v4c0 3-2 5-4 5v-2c1 0 2-1 2-3h-2V7z" />
        </svg>
      </div>
      <blockquote>We believe everyone deserves a clear path to a meaningful career. That starts with being available and responsive to the people we serve.</blockquote>
      <div class="by">Workforce Advancement Project Team</div>
    </div>
  </div>
</section>

<style>
  .cgrid{display:grid;grid-template-columns:1.05fr .95fr;gap:36px;align-items:start}
  @media(max-width:880px){.cgrid{grid-template-columns:1fr;gap:28px}}

  /* form panel */
  .formpanel{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:32px;box-shadow:var(--shadow)}
  .formpanel h2{font-family:'Plus Jakarta Sans';font-weight:800;font-size:26px;margin-bottom:22px}
  .cform{display:flex;flex-direction:column;gap:18px}
  .frow{display:grid;grid-template-columns:1fr 1fr;gap:16px}
  @media(max-width:480px){.frow{grid-template-columns:1fr}}
  .fgroup{display:flex;flex-direction:column;gap:7px}
  .fgroup label{font-size:14px;font-weight:600;color:var(--text)}
  .fgroup label span[aria-hidden]{color:var(--crimson)}
  .cform input[type=text],.cform input[type=email],.cform input[type=tel],.cform select,.cform textarea{
    font-family:inherit;font-size:15px;color:var(--text);background:var(--surface-2);
    border:1px solid var(--border);border-radius:12px;padding:12px 14px;width:100%;transition:border-color .15s,box-shadow .15s}
  .cform input:focus,.cform select:focus,.cform textarea:focus{
    outline:none;border-color:var(--crimson);box-shadow:0 0 0 3px rgba(173,44,77,.12)}
  .cform textarea{resize:vertical;min-height:120px}
  .cbox{flex-direction:row;align-items:center;gap:10px;font-weight:500!important;color:var(--muted)!important;cursor:pointer}
  .cbox input{width:18px;height:18px;accent-color:var(--crimson);flex-shrink:0}
  .footnote{font-size:13px;color:var(--muted);text-align:center;margin-top:2px}

  /* info tiles */
  .infostack{display:flex;flex-direction:column;gap:20px}
  .cardgrid{display:grid;grid-template-columns:1fr 1fr;gap:18px}
  @media(max-width:480px){.cardgrid{grid-template-columns:1fr}}
  .infocard{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:24px;box-shadow:var(--shadow)}
  .infocard--gold{border-color:rgba(164,127,56,.35);background:linear-gradient(180deg,var(--surface),rgba(164,127,56,.05))}
  .infocard .ic{width:46px;height:46px;border-radius:12px;display:grid;place-items:center;margin-bottom:14px}
  .infocard h3{font-size:17px;font-weight:700;margin-bottom:6px}
  .infocard p{color:var(--muted);font-size:14px}
  .infocard .mono{font-family:'Plus Jakarta Sans';font-weight:700;font-size:18px;color:var(--text);margin-bottom:2px}
  .infocard .hours{font-size:13px;margin-top:6px}
  .ilink{color:var(--crimson);font-weight:600}
  .ilink:hover{text-decoration:underline}

  .austincard{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:28px;box-shadow:var(--shadow)}
  .austincard h3{font-family:'Plus Jakarta Sans';font-weight:800;font-size:20px;margin:14px 0 10px}
  .austincard p{color:var(--muted);font-size:15px}

  /* quote */
  .quotecard{max-width:760px;margin:0 auto;text-align:center;background:var(--surface-2);border:1px solid var(--border);border-radius:var(--radius);padding:44px 36px;box-shadow:var(--shadow)}
  .qmark{width:54px;height:54px;border-radius:14px;background:var(--grad);color:#fff;display:grid;place-items:center;margin:0 auto 20px}
  .quotecard blockquote{font-family:'Plus Jakarta Sans';font-weight:700;font-size:clamp(20px,2.6vw,28px);line-height:1.3;letter-spacing:-.01em;color:var(--text)}
  .quotecard .by{margin-top:18px;font-size:14px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;color:var(--crimson)}
</style>
</Layout>
