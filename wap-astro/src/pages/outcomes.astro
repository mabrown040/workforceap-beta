---
import Layout from '../layouts/Layout.astro';

// Truth-lock: this is a transparency page. The live Next page pulls placement
// counts, follow-up signal rates, and PII-stripped story cards from internal
// placement records at request time (getPublicPlacementOutcomes / socialProof).
// For this static spike we do NOT fabricate any number, rate, or testimonial:
// the data slots render as "awaiting published data" placeholders so the page
// stays visually complete and structurally identical to the real page while
// remaining honest about having no live records to show.

// Real breakdown sections, in the same order the Next page renders them
// (by program → by funding source → by retention status).
const breakdowns = [
  { id: 'outcomes-by-program', title: 'By program (where recorded)' },
  { id: 'outcomes-by-funding', title: 'By funding source (where recorded)' },
  { id: 'outcomes-by-retention', title: 'Retention status (where recorded)' },
];
---
<Layout
  title="Outcomes snapshot — WorkforceAP"
  description="Aggregate placement counts from WorkforceAP internal records — no guaranteed outcomes; funded access for qualifying members."
>
<!-- HERO / INTRO -->
<section class="band band--surface ohero"><div class="wrap">
  <div class="ogrid">
    <div class="olead">
      <span class="eyebrow"><span class="dot"></span>Transparency</span>
      <h1>Placement outcomes <span class="grad-text">(aggregate)</span></h1>
      <p class="ointro">
        These counts come from internal placement records — not a promise of future results.
        Programs may be available at no upfront cost for qualifying members through WorkforceAP
        and partner-backed pathways. <a href="/programs">Browse programs</a>.
      </p>
    </div>

    <!-- BIG STAT CARD (truth-lock: no live records, so the count is published per cohort) -->
    <div class="statcard">
      <div class="num">—</div>
      <div class="lab">Members with a placement on file</div>
      <div class="asof">Published per cohort as records are verified</div>
      <div class="signal">
        Follow-up signal rate: <strong>—</strong> (— of —) — approximate 95% interval
        published once enough placements are on file (Wilson score).
      </div>
    </div>
  </div>
</div></section>

<!-- VERIFIED PLACEMENT STORIES (static, PII-stripped representation) -->
<section class="band" aria-labelledby="placement-stories"><div class="wrap">
  <div class="sec-head">
    <h2 id="placement-stories">Verified placement stories</h2>
    <p>PII-stripped cards pulled from live placement records. No seeded or illustrative outcomes are shown.</p>
  </div>
  <div class="stories">
    <article class="scard scard--empty">
      <span class="tag">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
        Verified placement
      </span>
      <h3>Job title from record</h3>
      <p class="meta">Program not specified · month / year</p>
    </article>
    <article class="scard scard--empty">
      <span class="tag">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
        Verified placement
      </span>
      <h3>Job title from record</h3>
      <p class="meta">Program not specified · month / year</p>
    </article>
    <article class="scard scard--empty">
      <span class="tag">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
        Verified placement
      </span>
      <h3>Job title from record</h3>
      <p class="meta">Program not specified · month / year</p>
    </article>
  </div>
  <p class="method">Story cards appear here as cohorts complete. See the admin outcomes methodology before using any claim externally.</p>
</div></section>

<!-- AGGREGATE BREAKDOWNS: by program → by funding → by retention -->
{breakdowns.map((s) => (
  <section class="band band--tight" aria-labelledby={s.id}><div class="wrap">
    <div class="sec-head sec-head--sm">
      <h2 id={s.id}>{s.title}</h2>
    </div>
    <ul class="blist">
      <li class="brow"><span>Awaiting published data</span><strong>—</strong></li>
      <li class="brow"><span>Awaiting published data</span><strong>—</strong></li>
      <li class="brow"><span>Unspecified</span><strong>—</strong></li>
    </ul>
  </div></section>
))}

<!-- CLOSING CTA -->
<section class="band" aria-labelledby="outcomes-cta"><div class="wrap"><div class="cta">
  <h2 id="outcomes-cta">Ready to start your own pathway?</h2>
  <p>Apply in about 5 minutes — no cost for qualifying members. A real team reviews it and follows up in 1 to 2 business days.</p>
  <div class="acts">
    <a class="btn btn--light" href="/apply">Start your application</a>
    <a class="btn btn--translucent" href="/programs">Browse programs</a>
  </div>
</div></div></section>

<style>
  .ohero{padding-top:64px}
  .ogrid{display:grid;grid-template-columns:1.05fr .95fr;gap:48px;align-items:center}
  .olead h1{font-size:clamp(36px,5vw,58px);font-weight:800;margin:18px 0}
  .ointro{font-size:19px;color:var(--muted);max-width:34em}
  .ointro a{color:var(--crimson);font-weight:700}
  @media(max-width:880px){.ogrid{grid-template-columns:1fr;gap:32px}}

  .statcard{background:var(--grad);border-radius:var(--radius);padding:34px;color:#fff;box-shadow:var(--shadow-lg);position:relative;overflow:hidden}
  .statcard .num{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:clamp(56px,9vw,84px);line-height:1}
  .statcard .lab{font-weight:700;font-size:17px;margin-top:6px}
  .statcard .asof{color:rgba(255,255,255,.78);font-size:13px;margin-top:6px;text-transform:uppercase;letter-spacing:.05em;font-weight:600}
  .statcard .signal{margin-top:18px;padding-top:18px;border-top:1px solid rgba(255,255,255,.22);font-size:14px;color:rgba(255,255,255,.9)}
  .statcard .signal strong{color:#fff}

  .stories{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
  .scard{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:24px;box-shadow:var(--shadow)}
  .scard--empty{border-style:dashed;background:var(--surface-2)}
  .scard .tag{display:inline-flex;align-items:center;gap:7px;font-size:12px;font-weight:700;padding:5px 11px;border-radius:999px;background:rgba(74,155,79,.12);color:var(--green)}
  .scard .tag svg{display:block}
  .scard h3{font-size:19px;font-weight:700;margin:14px 0 6px;color:var(--muted)}
  .scard .meta{color:var(--muted);font-size:14px}
  .method{margin-top:20px;font-size:13px;color:var(--muted)}
  @media(max-width:880px){.stories{grid-template-columns:1fr}}

  .band--tight{padding-top:0}
  .sec-head--sm{margin-bottom:18px}
  .sec-head--sm h2{font-size:clamp(22px,3vw,30px)}
  .blist{list-style:none;display:flex;flex-direction:column;gap:2px;max-width:720px}
  .brow{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:14px 0;border-bottom:1px solid var(--border);font-size:15px}
  .brow:last-child{border-bottom:none}
  .brow span{color:var(--muted)}
  .brow strong{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;color:var(--text)}
</style>
</Layout>
</output>
