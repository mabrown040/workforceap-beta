# Supabase (public - safe for client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase (server-only - never expose)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Storage: create a private bucket named member-resumes (Dashboard → Storage) for member resume uploads.

# Database (Prisma) - Supabase integration adds these to Vercel automatically
# For local dev, use DATABASE_URL or add both from Supabase Dashboard → Project Settings → Database
POSTGRES_PRISMA_URL=postgresql://user:password@host:6543/database?pgbouncer=true
POSTGRES_URL_NON_POOLING=postgresql://user:password@host:5432/database
# Fallback for local dev:
DATABASE_URL=postgresql://user:password@host:5432/database

# Upstash Redis (rate limiting)
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# Resend (email)
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=noreply@workforceap.org

# Site URL — REQUIRED in production (used in email links, password resets, invite redirects)
NEXT_PUBLIC_SITE_URL=https://www.workforceap.org

# Cron job secret — REQUIRED in production (protects /api/cron/* endpoints)
# Generate with: openssl rand -hex 32
CRON_SECRET=your-cron-secret-here

# Optional: staff MFA enforcement. Off by default for launch; set to 1 to require
# admin/counselor MFA setup and verification again.
STAFF_MFA_ENFORCEMENT=0
# Set true on dev/staging only to create portal QA users in prisma/seed.ts (see seed file for password note)
# SEED_TEST_ACCOUNTS=true

# Optional: Coursera Enterprise integration
# Shared API base for Enterprise REST endpoints.
COURSERA_API_BASE_URL=https://api.coursera.com/ent/api/rest/v1
# Bearer token for Coursera Enterprise API access.
COURSERA_API_TOKEN=
# Default Coursera program ID, or use the JSON map below for per-program overrides.
COURSERA_PROGRAM_ID=
COURSERA_PROGRAM_ID_MAP={}
# Member launch destination. Use either a fixed URL or a template with {programId}, {programSlug}, {userId}, {email}.
COURSERA_PROGRAM_HOME_URL=
COURSERA_PROGRAM_URL_TEMPLATE=
# Default skillset ids for learner-progress sync, comma-separated.
COURSERA_DEFAULT_SKILLSET_IDS=
# Optional per-program skillset mapping, JSON object of slug -> string[].
COURSERA_SKILLSET_ID_MAP={}
# Shared secret for inbound Coursera completion webhooks.
COURSERA_WEBHOOK_SECRET=

# Optional: learning path deep-linking (preferred over course-level deep-linking)
# URL template with {learningPathId}, {programId}, {programSlug}, {userId}, {email}
COURSERA_LEARNING_PATH_URL_TEMPLATE=
# Per-program learning path ID mapping: programSlug -> Coursera learning path ID
COURSERA_LEARNING_PATH_ID_MAP={}

# Optional: Google Tag Manager (analytics)
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# AI tools — provider fallback chain: Anthropic → Groq → Gemini
# At least one is required for member AI tools. All three recommended for production
# (a single provider outage will not break the cohort experience).
ANTHROPIC_API_KEY=sk-ant-...
GROQ_API_KEY=gsk_...
GEMINI_API_KEY=AIza...
# Optional: override Groq model (default: llama-3.3-70b-versatile)
# GROQ_MODEL=llama-3.1-8b-instant
# Optional: override Gemini model (default: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-pro

# Optional: Tavily for web search when drafting blog posts (blog AI tools)
# TAVILY_API_KEY=tvly-...

# Optional: Firecrawl for employer job import from URLs (LinkedIn, JS-rendered sites)
# When set, used as fallback when plain fetch fails — improves success rate for job board imports
# FIRECRAWL_API_KEY=fc-...

# Optional: Sentry (error monitoring) — @sentry/nextjs is wired in next.config.ts
# Server/edge: use SENTRY_DSN (Vercel env). Browser: same DSN in NEXT_PUBLIC_SENTRY_DSN for client errors.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Build-time source map upload (Vercel): SENTRY_AUTH_TOKEN, SENTRY_ORG, SENTRY_PROJECT
SENTRY_AUTH_TOKEN=

# Optional: Cloudflare Turnstile (employer contact + other public forms)
# Set NEXT_PUBLIC_CAPTCHA_ENABLED=true only when both keys are configured in Vercel.
NEXT_PUBLIC_CAPTCHA_ENABLED=false
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=


# Optional: ElevenLabs — TTS + Conversational AI (signed URLs)
# https://elevenlabs.io/app/settings/api-keys
# Without ELEVENLABS_API_KEY, interview coach uses text-only; voice UIs return 503.
ELEVENLABS_API_KEY=

# Conversational AI agent IDs (ElevenLabs → Agents). Interview + counselor have code fallbacks if unset.
# Agent IDs for ConvAI (see lib/ai/elevenlabsPortalContext.ts for dynamic variables passed per route).
ELEVENLABS_INTERVIEW_AGENT_ID=
ELEVENLABS_COUNSELOR_AGENT_ID=
ELEVENLABS_EMPLOYER_AGENT_ID=
ELEVENLABS_READINESS_AGENT_ID=
ELEVENLABS_RESUME_COACH_AGENT_ID=
# Optional: partner portal voice (see /partner home)
ELEVENLABS_PARTNER_AGENT_ID=

# Optional public TTS override IDs for portal voice surfaces
# WIOA defaults to Sarah (female, mature, reassuring) with slightly slower, steadier delivery.
NEXT_PUBLIC_ELEVENLABS_WIOA_VOICE_ID=
NEXT_PUBLIC_ELEVENLABS_COUNSELOR_VOICE_ID=
NEXT_PUBLIC_ELEVENLABS_INTERVIEWER_FEMALE_VOICE_ID=
NEXT_PUBLIC_ELEVENLABS_INTERVIEWER_MALE_VOICE_ID=

# O*NET Web Services (legacy username/password — optional)
ONET_API_USERNAME=
ONET_API_PASSWORD=

# O*NET Web Services v2 — Header: X-API-Key
# https://api-v2.onetcenter.org/
ONET_API_KEY=
