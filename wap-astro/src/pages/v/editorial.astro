---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="WorkforceAP — Empowering People. Advancing Futures.">
<div class="ed">

  <!-- MASTHEAD -->
  <header class="ed-mast wrap">
    <div class="ed-rule">
      <span>The Workforce Quarterly</span>
      <span>No. 25 · Issue: Careers</span>
      <span>501(c)(3) Nonprofit</span>
    </div>
  </header>

  <!-- HERO / COVER -->
  <section class="ed-hero wrap">
    <div class="ed-hero__type">
      <span class="ed-section-no">§ 01</span>
      <span class="pill">★ Employer-recognized certificates</span>
      <h1 class="ed-display">
        Empowering People.<br>
        <em>Advancing</em> Futures.
      </h1>
      <p class="ed-lede">
        Employer-aligned training, professional certificates, and real career
        support — <span class="ed-accent">at no cost</span> to qualifying members.
      </p>
      <div class="ed-cta">
        <a class="ed-btn ed-btn--ink" href="/apply">Start your application</a>
        <a class="ed-btn ed-btn--line" href="/find-your-path">Find your path →</a>
      </div>
      <dl class="ed-stats">
        <div><dt>25+</dt><dd>years in workforce development</dd></div>
        <div><dt>$0</dt><dd>for qualifying members</dd></div>
        <div><dt>1–2 days</dt><dd>reviewed by a real team</dd></div>
      </dl>
    </div>

    <figure class="ed-figure">
      <div class="ed-figure__frame">
        <img src="https://www.workforceap.org/images/hero-people.webp"
             alt="People building careers through WorkforceAP" loading="eager" />
      </div>
      <figcaption>
        <span class="ed-fig-no">Fig. 1</span>
        Members move from application to a recognized credential — with a team behind them the whole way.
      </figcaption>
    </figure>
  </section>

  <!-- CREDENTIALS BYLINE -->
  <section class="ed-byline wrap">
    <span class="ed-byline__lab">Credentials you can earn</span>
    <div class="ed-byline__logos">
      <span>IBM</span><span class="ed-d">/</span>
      <span>Google</span><span class="ed-d">/</span>
      <span>Microsoft</span><span class="ed-d">/</span>
      <span>AWS</span><span class="ed-d">/</span>
      <span>CompTIA</span>
      <span class="ed-byline__extra">+ CPT &amp; CLT</span>
    </div>
  </section>

  <!-- FEATURE: HOW IT WORKS -->
  <section class="ed-feature wrap">
    <div class="ed-feature__head">
      <span class="ed-section-no">§ 02</span>
      <h2 class="ed-display ed-display--md">The journey, in four movements.</h2>
      <p class="ed-feature__stand">
        A clear path from application to a recognized credential and the
        career support that comes after it. No fees for those who qualify.
      </p>
    </div>

    <ol class="ed-journey">
      <li>
        <span class="ed-num">01</span>
        <h3>Apply</h3>
        <p>Takes about five minutes. No cost for qualifying members — and a real team reviews every application.</p>
      </li>
      <li>
        <span class="ed-num">02</span>
        <h3>Get matched</h3>
        <p>We match you to the program track that fits your goals and background, drawn from our catalog.</p>
      </li>
      <li>
        <span class="ed-num">03</span>
        <h3>Train &amp; certify</h3>
        <p>Build job-ready skills and earn an employer-recognized professional certificate that carries weight.</p>
      </li>
      <li>
        <span class="ed-num">04</span>
        <h3>Launch</h3>
        <p>Move into the workforce with resume, interview, and mentor support standing behind you.</p>
      </li>
    </ol>
  </section>

  <!-- PULL QUOTE -->
  <section class="ed-quote wrap">
    <span class="ed-section-no">§ 03</span>
    <blockquote>
      “We're a nonprofit — so we don't inflate outcomes. We publish verified
      placement data as cohorts complete, with the methodology shown.”
    </blockquote>
    <a class="ed-quote__link" href="/outcomes">See our outcomes →</a>
  </section>

  <!-- WHO WE SERVE -->
  <section class="ed-serve wrap">
    <div class="ed-feature__head">
      <span class="ed-section-no">§ 04</span>
      <h2 class="ed-display ed-display--md">Built for members, employers &amp; partners.</h2>
    </div>
    <div class="ed-columns">
      <article>
        <span class="ed-col-no">I.</span>
        <h3>Members</h3>
        <p>No-cost, employer-aligned training, professional certificates, and a team that supports you all the way to job-ready.</p>
        <a href="/apply">Start your application →</a>
      </article>
      <article>
        <span class="ed-col-no">II.</span>
        <h3>Employers</h3>
        <p>Build a pipeline of training-aligned candidates for in-demand roles — with no per-placement fees.</p>
        <a href="/employers">Talk with us about hiring →</a>
      </article>
      <article>
        <span class="ed-col-no">III.</span>
        <h3>Partners</h3>
        <p>Extend workforce impact in your community through referral and program partnerships.</p>
        <a href="/partners">Explore partnership →</a>
      </article>
    </div>
  </section>

  <!-- TRUST LEDGER -->
  <section class="ed-ledger wrap">
    <div class="ed-ledger__item"><b>25+ yrs</b><span>In workforce development</span></div>
    <div class="ed-ledger__item"><b>501(c)(3)</b><span>Nonprofit organization</span></div>
    <div class="ed-ledger__item"><b>$0</b><span>For qualifying members</span></div>
    <div class="ed-ledger__item"><b>5</b><span>Employer-recognized cert tracks</span></div>
  </section>

  <!-- CLOSING CTA -->
  <section class="ed-close wrap">
    <span class="ed-section-no ed-section-no--light">§ 05</span>
    <h2 class="ed-display ed-display--lg">Your next step starts<br>with one application.</h2>
    <p>Apply in about five minutes — no cost for qualifying members. A real team reviews it and follows up in 1 to 2 business days.</p>
    <div class="ed-cta">
      <a class="ed-btn ed-btn--paper" href="/apply">Start your application</a>
      <a class="ed-btn ed-btn--outline" href="/find-your-path">Find your path</a>
      <a class="ed-btn ed-btn--outline" href="/employers">For employers</a>
    </div>
  </section>

</div>
</Layout>

<style>
  /* ============================================================
     EDITORIAL — magazine. Ink + one crimson accent, oversized
     display type, baseline grid, numbered sections, framed photo.
     ============================================================ */
  .ed{ --ink:#1a1414; --ink-soft:#3a3030; --line:#d9d1cb;
       font-family:'Inter',system-ui,sans-serif; color:var(--ink); }
  .ed .wrap{ max-width:1140px; margin:0 auto; padding:0 28px; }

  .ed-display{ font-family:'Plus Jakarta Sans',sans-serif; font-weight:800;
               letter-spacing:-.03em; line-height:.98; }
  .ed-display em{ font-style:italic; font-weight:800;
                  background:var(--grad-text); -webkit-background-clip:text;
                  background-clip:text; -webkit-text-fill-color:transparent; }
  .ed-section-no{ display:inline-block; font-family:'Plus Jakarta Sans';
                  font-weight:800; font-size:13px; letter-spacing:.18em;
                  text-transform:uppercase; color:var(--crimson); margin-bottom:18px; }

  /* MASTHEAD */
  .ed-mast{ padding-top:34px; }
  .ed-rule{ display:flex; justify-content:space-between; gap:18px; flex-wrap:wrap;
            border-top:2px solid var(--ink); border-bottom:1px solid var(--line);
            padding:12px 0; font-size:12px; font-weight:600; letter-spacing:.12em;
            text-transform:uppercase; color:var(--ink-soft); }
  .ed-rule span:first-child{ font-family:'Plus Jakarta Sans'; font-weight:800;
                             color:var(--ink); letter-spacing:.06em; }

  /* HERO */
  .ed-hero{ display:grid; grid-template-columns:1.08fr .92fr; gap:64px;
            align-items:end; padding:64px 28px 56px; }
  .pill{ display:inline-flex; align-items:center; gap:7px; white-space:nowrap;
         background:linear-gradient(135deg,#cda44e,#9a7733); color:#fff;
         font-weight:800; font-size:12px; letter-spacing:.03em; line-height:1;
         padding:9px 17px; border-radius:999px; margin:0 0 22px;
         box-shadow:0 10px 26px -10px rgba(164,127,56,.7); }
  .ed-hero__type h1.ed-display{ font-size:clamp(52px,8.2vw,104px); margin:0 0 26px; }
  .ed-lede{ font-size:clamp(19px,2.1vw,24px); line-height:1.45; color:var(--ink-soft);
            max-width:24em; margin-bottom:32px; }
  .ed-accent{ color:var(--crimson); font-weight:600; }

  .ed-cta{ display:flex; gap:16px; flex-wrap:wrap; align-items:center; }
  .ed-btn{ display:inline-flex; align-items:center; font-weight:700; font-size:15px;
           letter-spacing:.01em; padding:15px 28px; border-radius:2px;
           border:1.5px solid transparent; transition:transform .15s,background .2s,color .2s; }
  .ed-btn:hover{ transform:translateY(-2px); }
  .ed-btn--ink{ background:var(--ink); color:#fff; }
  .ed-btn--ink:hover{ background:var(--crimson); }
  .ed-btn--line{ background:transparent; color:var(--ink); border-color:var(--ink);
                 border-radius:2px; padding:13px 22px; }
  .ed-btn--line:hover{ border-color:var(--crimson); color:var(--crimson); }

  .ed-stats{ display:flex; gap:40px; flex-wrap:wrap; margin-top:42px;
             padding-top:26px; border-top:1px solid var(--line); }
  .ed-stats dt{ font-family:'Plus Jakarta Sans'; font-weight:800;
                font-size:30px; letter-spacing:-.02em; line-height:1; }
  .ed-stats dd{ font-size:13px; color:var(--ink-soft); margin-top:6px; max-width:13em; }

  /* FRAMED PHOTO */
  .ed-figure{ margin:0; }
  .ed-figure__frame{ position:relative; border:1px solid var(--line);
                     padding:12px; background:var(--surface); box-shadow:var(--shadow); }
  .ed-figure__frame::before{ content:""; position:absolute; inset:5px;
                             border:1px solid var(--line); pointer-events:none; }
  .ed-figure img{ display:block; width:100%; height:clamp(360px,46vw,520px);
                  object-fit:cover; filter:grayscale(.18) contrast(1.03); }
  .ed-figure figcaption{ display:flex; gap:12px; margin-top:14px; font-size:13px;
                         line-height:1.5; color:var(--ink-soft); max-width:34em; }
  .ed-fig-no{ font-family:'Plus Jakarta Sans'; font-weight:800; color:var(--crimson);
              white-space:nowrap; }

  /* CREDENTIALS BYLINE */
  .ed-byline{ display:flex; align-items:baseline; gap:28px; flex-wrap:wrap;
              padding:30px 28px; border-top:2px solid var(--ink);
              border-bottom:2px solid var(--ink); margin:8px auto 0; }
  .ed-byline__lab{ font-size:12px; font-weight:700; letter-spacing:.14em;
                   text-transform:uppercase; color:var(--ink-soft); }
  .ed-byline__logos{ display:flex; align-items:baseline; gap:14px; flex-wrap:wrap;
                     font-family:'Plus Jakarta Sans'; font-weight:800;
                     font-size:clamp(20px,2.6vw,30px); letter-spacing:-.02em; }
  .ed-d{ color:var(--line); font-weight:400; }
  .ed-byline__extra{ font-family:'Inter'; font-size:15px; font-weight:700;
                     color:var(--gold-dark); align-self:center; }

  /* FEATURE HEAD */
  .ed-feature{ padding:80px 28px 40px; }
  .ed-feature__head{ max-width:780px; margin-bottom:54px; }
  .ed-display--md{ font-size:clamp(34px,5vw,60px); line-height:1.02; margin:0 0 22px; }
  .ed-feature__stand{ font-size:19px; line-height:1.55; color:var(--ink-soft); max-width:38em; }

  /* JOURNEY — baseline-grid columns with hairline rules */
  .ed-journey{ list-style:none; margin:0; padding:0;
               display:grid; grid-template-columns:repeat(4,1fr); }
  .ed-journey li{ padding:30px 26px 38px 0; border-top:1px solid var(--ink); }
  .ed-journey li + li{ border-left:1px solid var(--line); padding-left:26px; }
  .ed-num{ display:block; font-family:'Plus Jakarta Sans'; font-weight:800;
           font-size:46px; letter-spacing:-.03em; color:var(--crimson);
           line-height:1; margin-bottom:24px; }
  .ed-journey h3{ font-family:'Plus Jakarta Sans'; font-weight:800; font-size:22px;
                  margin-bottom:10px; }
  .ed-journey p{ font-size:14.5px; line-height:1.55; color:var(--ink-soft); }

  /* PULL QUOTE */
  .ed-quote{ padding:70px 28px; text-align:center; max-width:980px; }
  .ed-quote blockquote{ font-family:'Plus Jakarta Sans'; font-weight:800;
                        font-size:clamp(26px,3.8vw,44px); line-height:1.18;
                        letter-spacing:-.02em; margin:14px 0 20px; text-wrap:balance; }
  .ed-quote__link{ font-weight:700; color:var(--crimson); border-bottom:2px solid var(--crimson);
                   padding-bottom:2px; }

  /* WHO WE SERVE */
  .ed-serve{ padding:40px 28px 80px; }
  .ed-columns{ display:grid; grid-template-columns:repeat(3,1fr); gap:0;
               border-top:2px solid var(--ink); }
  .ed-columns article{ padding:34px 30px 36px 0; }
  .ed-columns article + article{ border-left:1px solid var(--line); padding-left:30px; }
  .ed-col-no{ font-family:'Plus Jakarta Sans'; font-weight:800; font-size:15px;
              color:var(--crimson); letter-spacing:.04em; }
  .ed-columns h3{ font-family:'Plus Jakarta Sans'; font-weight:800; font-size:26px;
                  margin:10px 0 14px; }
  .ed-columns p{ font-size:15px; line-height:1.6; color:var(--ink-soft); margin-bottom:18px; }
  .ed-columns a{ font-weight:700; color:var(--ink); border-bottom:1.5px solid var(--ink);
                 padding-bottom:2px; transition:color .2s,border-color .2s; }
  .ed-columns a:hover{ color:var(--crimson); border-color:var(--crimson); }

  /* TRUST LEDGER */
  .ed-ledger{ display:grid; grid-template-columns:repeat(4,1fr);
              border-top:2px solid var(--ink); border-bottom:2px solid var(--ink); }
  .ed-ledger__item{ padding:30px 24px; }
  .ed-ledger__item + .ed-ledger__item{ border-left:1px solid var(--line); }
  .ed-ledger__item b{ display:block; font-family:'Plus Jakarta Sans'; font-weight:800;
                      font-size:clamp(28px,3.4vw,42px); letter-spacing:-.02em;
                      line-height:1; }
  .ed-ledger__item span{ display:block; margin-top:8px; font-size:13.5px; color:var(--ink-soft); }

  /* CLOSING CTA — full-bleed ink */
  .ed-close{ background:var(--ink); color:#fff; max-width:none !important;
             padding:90px 28px 96px; margin-top:80px; text-align:center; }
  .ed-close > *{ max-width:980px; margin-left:auto; margin-right:auto; }
  .ed-section-no--light{ color:#cda44e; }
  .ed-display--lg{ font-size:clamp(38px,6vw,76px); line-height:1.0; margin-bottom:24px; }
  .ed-close p{ font-size:19px; line-height:1.55; color:rgba(255,255,255,.78);
               max-width:36em; margin-bottom:34px; }
  .ed-close .ed-cta{ justify-content:center; }
  .ed-btn--paper{ background:#fff; color:var(--ink); }
  .ed-btn--paper:hover{ background:#cda44e; color:#fff; }
  .ed-btn--outline{ background:transparent; color:#fff; border-color:rgba(255,255,255,.4);
                    border-radius:2px; }
  .ed-btn--outline:hover{ border-color:#fff; background:rgba(255,255,255,.08); }

  /* RESPONSIVE */
  @media(max-width:960px){
    .ed-hero{ grid-template-columns:1fr; gap:44px; align-items:start; padding-top:48px; }
    .ed-journey{ grid-template-columns:1fr 1fr; }
    .ed-journey li,.ed-journey li + li{ border-left:0; padding-left:0; }
    .ed-journey li:nth-child(2){ border-left:0; }
    .ed-columns{ grid-template-columns:1fr; }
    .ed-columns article + article{ border-left:0; padding-left:0; border-top:1px solid var(--line); }
    .ed-ledger{ grid-template-columns:1fr 1fr; }
    .ed-ledger__item:nth-child(3){ border-left:0; }
    .ed-ledger__item:nth-child(3),.ed-ledger__item:nth-child(4){ border-top:1px solid var(--line); }
  }
  @media(max-width:560px){
    .ed-journey{ grid-template-columns:1fr; }
    .ed-journey li + li{ border-top:1px solid var(--line); }
    .ed-stats{ gap:26px; }
  }
</style>
