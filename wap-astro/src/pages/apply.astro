---
import Layout from '../layouts/Layout.astro';
---
<Layout
  title="Start Your Application — WorkforceAP"
  description="Apply to WorkforceAP, a 501(c)(3) nonprofit. Programs are offered at no cost for qualifying members. Takes about 5 minutes — a member advisor follows up within 1–2 business days."
>
<!-- HERO -->
<section class="hero"><div class="wrap grid">
  <div>
    <span class="eyebrow"><span class="dot"></span>Member application</span>
    <h1>Start Your <span class="grad-text">Application</span></h1>
    <p class="sub">Share how we can reach you and answer three quick eligibility questions — work situation, household income, and work authorization. Then you'll pick programs and create your account.</p>
    <p class="hi-line"><strong>Programs are offered no cost for qualifying members.</strong> No prior experience required. We'll help you confirm fit and eligibility for next steps.</p>
    <div class="cta">
      <a class="btn btn--primary" href="#apply-form-start">Start your application →</a>
      <a class="btn btn--ghost" href="/contact">Contact an advisor</a>
    </div>
    <div class="trustline">
      <span><b>About 5 min</b> to start</span><span class="sep"></span>
      <span><b>$0</b> for qualifying members</span><span class="sep"></span>
      <span>Follow-up in <b>1–2 business days</b></span>
    </div>
    <p class="callhint">Questions? Call <a href="tel:+15127771808">(512) 777-1808</a></p>
  </div>
  <div style="position:relative">
    <div class="panel">
      <div class="floatbadge">501(c)(3) nonprofit</div>
      <div class="phead">
        <div><small>Application progress</small><div class="big">3 quick steps</div></div>
        <div class="ring">
          <svg viewBox="0 0 100 100" style="transform:rotate(-90deg)"><circle cx="50" cy="50" r="42" fill="none" stroke="rgba(255,255,255,.22)" stroke-width="9"/><circle cx="50" cy="50" r="42" fill="none" stroke="#fff" stroke-width="9" stroke-dasharray="264" stroke-dashoffset="176" stroke-linecap="round"/></svg>
        </div>
      </div>
      <div class="step active"><div class="n">1</div><div class="t"><b>You &amp; eligibility</b><span>Contact details + three quick questions</span></div><span class="pill">~5 min</span></div>
      <div class="step"><div class="n">2</div><div class="t"><b>Program choices</b><span>Rank up to three programs</span></div></div>
      <div class="step"><div class="n">3</div><div class="t"><b>Account</b><span>Save your spot and create your login</span></div></div>
      <p class="note">A member advisor reviews every application and follows up within 1–2 business days in most cases.</p>
    </div>
  </div>
</div></section>

<!-- TRUST BAR -->
<div class="creds"><div class="wrap" style="display:block">
  <div class="row" style="display:flex">
    <span class="logo" style="font-size:15px;font-weight:700">✓ At no cost to members</span>
    <span class="logo" style="font-size:15px;font-weight:700">✓ 501(c)(3) nonprofit · EIN 41-2612389</span>
    <span class="logo" style="font-size:15px;font-weight:700">✓ Reviewed by a real team</span>
    <span class="extra">✓ (512) 777-1808</span>
  </div>
</div></div>

<!-- APPLICATION FORM (static representation) -->
<section class="band band--surface" id="apply-form-start"><div class="wrap apply-grid">
  <!-- Sidebar -->
  <aside class="apply-side" aria-label="Application steps">
    <div class="side-card">
      <h2>Application Progress</h2>
      <ol class="prog">
        <li class="active"><span class="pn">1</span> You &amp; eligibility</li>
        <li><span class="pn">2</span> Program choices</li>
        <li><span class="pn">3</span> Account</li>
      </ol>
    </div>
    <div class="side-card">
      <h3>What happens next?</h3>
      <ol class="next">
        <li>Submit your application and tell us what kind of work or training you want.</li>
        <li>A WorkforceAP advisor reviews your information and follows up within 1–2 business days in most cases.</li>
        <li>We talk through fit, eligibility, and the best next step for your situation.</li>
        <li>If needed, we guide you to screening, documentation, interview, or program-readiness steps.</li>
        <li>You get a clearer recommendation for training, support, and job-readiness next steps.</li>
      </ol>
      <p class="callsmall">Questions? Call <a href="tel:+15127771808">(512) 777-1808</a></p>
    </div>
  </aside>

  <!-- Main form -->
  <div class="apply-main" role="region" aria-label="Application form">
    <p class="form-kicker">Step 1 of 3 — your details &amp; eligibility · About 5 minutes · Save and finish later on this device</p>
    <div class="form-card">
      <h2 class="form-title">Quick eligibility check + how to reach you</h2>
      <p class="form-lead">Answer three quick questions first to estimate funding fit. Then share your contact details so we can follow up. Next you'll choose programs (step 2) and create your login (step 3).</p>

      <!-- Eligibility questions -->
      <fieldset class="fset">
        <legend>Employment status</legend>
        <p class="q">Are you currently unemployed, working part-time when you want full-time work, or in a job that pays below what your skills or training should command (underemployed)?</p>
        <div class="radio-row">
          <label class="radio-card selected"><input type="radio" name="q1" checked disabled /> Yes</label>
          <label class="radio-card"><input type="radio" name="q1" disabled /> No</label>
        </div>
      </fieldset>

      <fieldset class="fset">
        <legend>Household income</legend>
        <p class="q">Is your household's total annual income below $60,000 before taxes?</p>
        <div class="radio-row">
          <label class="radio-card"><input type="radio" name="q2" disabled /> Yes</label>
          <label class="radio-card"><input type="radio" name="q2" disabled /> No</label>
        </div>
      </fieldset>

      <fieldset class="fset">
        <legend>Work authorization</legend>
        <p class="q">Are you in the United States with permission to work here (for example, U.S. citizen, permanent resident, or other valid work authorization)?</p>
        <div class="radio-row">
          <label class="radio-card"><input type="radio" name="q3" disabled /> Yes</label>
          <label class="radio-card"><input type="radio" name="q3" disabled /> No</label>
        </div>
      </fieldset>

      <p class="exception-note">These questions do not automatically accept or deny you. If you're between situations, slightly over the threshold, or unsure how to answer, continue anyway — we review real-life circumstances individually.</p>

      <!-- Contact details -->
      <h3 class="block-title">How we reach you</h3>
      <div class="fgrid">
        <div class="field">
          <label>First Name *</label>
          <input type="text" placeholder="First name" disabled />
        </div>
        <div class="field">
          <label>Last Name *</label>
          <input type="text" placeholder="Last name" disabled />
        </div>
        <div class="field">
          <label>Email Address *</label>
          <input type="email" placeholder="you@example.com" disabled />
        </div>
        <div class="field">
          <label>Phone Number *</label>
          <input type="tel" placeholder="(512) 555-0100" disabled />
          <p class="hint">10-digit US number — your advisor uses this for follow-ups and application updates.</p>
        </div>
      </div>

      <h3 class="block-title">Eligibility screening details</h3>
      <div class="fgrid">
        <div class="field">
          <label>Age group *</label>
          <select disabled><option>Select age group</option><option>18–24</option><option>25–50</option><option>50+</option></select>
        </div>
        <div class="field">
          <label>County *</label>
          <input type="text" placeholder="County" disabled />
        </div>
        <div class="field">
          <label>City *</label>
          <input type="text" placeholder="City" disabled />
        </div>
        <div class="field field--row">
          <div>
            <label>State *</label>
            <input type="text" placeholder="State" disabled />
          </div>
          <div>
            <label>ZIP code *</label>
            <input type="text" placeholder="ZIP" disabled />
          </div>
        </div>
      </div>

      <p class="consent">By continuing you agree to our <a href="/terms">Terms</a> and <a href="/privacy">Privacy Policy</a>.</p>

      <a class="btn btn--primary cta-full" href="/apply/results">Continue — choose your programs →</a>
      <p class="autosave">Progress saved automatically on this device. You can close the tab and return anytime to finish.</p>
    </div>

    <!-- Documents checklist -->
    <details class="docs">
      <summary>Documents we may ask for later (not needed to start)</summary>
      <div class="docs-body">
        <p>You don't need every document to start — nothing uploads on this page. If we move forward together, we sometimes ask for:</p>
        <ul>
          <li>Government-issued photo ID</li>
          <li>Proof of income or unemployment status (pay stub, unemployment letter, or self-certification)</li>
          <li>Work authorization (if not a US citizen)</li>
          <li>Social Security card or number (for tax reporting)</li>
        </ul>
        <p class="docs-note">Don't worry if you don't have everything right now — our team will help.</p>
      </div>
    </details>
  </div>
</div></section>

<!-- SUPPLEMENTAL CARDS -->
<section class="band"><div class="wrap">
  <div class="tri">
    <div class="acard">
      <div class="ic ic--c">🔒</div>
      <h3>Secure data handling</h3>
      <p>Your information is sent over encrypted connections and protected with access controls. We do not sell your personal information, and any limited sharing follows our <a href="/privacy">Privacy Policy</a>.</p>
    </div>
    <div class="acard">
      <div class="ic ic--b">⚡</div>
      <h3>Someone will follow up</h3>
      <p>A member advisor reviews every application within 1–2 business days in most cases and reaches out to help you find the right program fit.</p>
    </div>
    <div class="acard">
      <div class="ic ic--gr">📞</div>
      <h3>Need help getting started?</h3>
      <p>You can still reach us directly. Call an advisor or send a message, and we'll help you start the application manually.</p>
      <a href="tel:+15127771808">Call (512) 777-1808 →</a>
    </div>
  </div>
</div></section>

<!-- CTA -->
<section class="band"><div class="wrap">
  <div class="cta">
    <h2>Your next step takes about 5 minutes</h2>
    <p>Programs are offered at no cost for qualifying members. A real team reviews your application and follows up within 1–2 business days.</p>
    <div class="acts">
      <a class="btn btn--light" href="#apply-form-start">Start your application</a>
      <a class="btn btn--translucent" href="/programs">Explore programs</a>
    </div>
  </div>
</div></section>

<style>
  .hi-line{color:var(--muted);font-size:16px;max-width:32em;margin-top:14px}
  .hi-line strong{color:var(--text)}
  .callhint{margin-top:14px;color:var(--muted);font-size:14px}
  .callhint a{color:var(--crimson);font-weight:700}

  .apply-grid{display:grid;grid-template-columns:300px 1fr;gap:32px;align-items:start}
  @media(max-width:880px){.apply-grid{grid-template-columns:1fr}}

  .apply-side{display:flex;flex-direction:column;gap:18px;position:sticky;top:96px}
  @media(max-width:880px){.apply-side{position:static}}
  .side-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:22px;box-shadow:var(--shadow)}
  .side-card h2{font-size:16px;font-weight:800;margin-bottom:16px}
  .side-card h3{font-size:16px;font-weight:800;margin-bottom:14px}
  .prog{list-style:none;display:flex;flex-direction:column;gap:12px}
  .prog li{display:flex;align-items:center;gap:12px;color:var(--muted);font-size:15px;font-weight:600}
  .prog li.active{color:var(--text)}
  .prog .pn{width:30px;height:30px;border-radius:9px;background:var(--border);color:var(--muted);display:grid;place-items:center;font-weight:800;font-size:14px;flex-shrink:0}
  .prog li.active .pn{background:var(--grad);color:#fff}
  .next{margin:0 0 14px 18px;display:flex;flex-direction:column;gap:10px;color:var(--muted);font-size:14px;line-height:1.5}
  .callsmall{font-size:14px;color:var(--muted)}
  .callsmall a{color:var(--crimson);font-weight:700}

  .form-kicker{font-size:13px;font-weight:700;color:var(--gold-dark);background:rgba(164,127,56,.1);border:1px solid rgba(164,127,56,.22);border-radius:999px;padding:8px 16px;display:inline-block;margin-bottom:18px}
  .form-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:32px;box-shadow:var(--shadow)}
  .form-title{font-size:26px;font-weight:800;margin-bottom:10px}
  .form-lead{color:var(--muted);font-size:16px;margin-bottom:26px}

  .fset{border:1px solid var(--border);border-radius:16px;padding:20px;margin-bottom:18px;background:var(--surface-2)}
  .fset legend{font-size:13px;font-weight:800;letter-spacing:.04em;text-transform:uppercase;color:var(--crimson);padding:0 8px}
  .fset .q{font-size:15px;margin-bottom:14px;color:var(--text)}
  .radio-row{display:flex;gap:12px}
  .radio-card{flex:1;display:flex;align-items:center;gap:10px;padding:12px 16px;border:1.5px solid var(--border);border-radius:12px;background:var(--surface);font-weight:600;font-size:15px;cursor:default}
  .radio-card.selected{border-color:var(--crimson);background:rgba(173,44,77,.06);color:var(--crimson)}
  .radio-card input{accent-color:var(--crimson)}

  .exception-note{font-size:13px;color:var(--muted);background:var(--surface-2);border:1px dashed var(--border);border-radius:12px;padding:14px 16px;margin-bottom:26px;line-height:1.5}

  .block-title{font-size:17px;font-weight:800;margin:22px 0 16px}
  .fgrid{display:grid;grid-template-columns:1fr 1fr;gap:16px}
  @media(max-width:560px){.fgrid{grid-template-columns:1fr}}
  .field{display:flex;flex-direction:column;gap:6px}
  .field--row{display:grid;grid-template-columns:1fr 1fr;gap:12px}
  .field--row > div{display:flex;flex-direction:column;gap:6px}
  .field label{font-size:13px;font-weight:700;color:var(--text)}
  .field input,.field select{padding:12px 14px;border:1.5px solid var(--border);border-radius:11px;background:var(--surface);font-size:15px;font-family:inherit;color:var(--text)}
  .field input::placeholder{color:#b7b0aa}
  .field .hint{font-size:12px;color:var(--muted);line-height:1.4}

  .consent{font-size:13px;color:var(--muted);margin:22px 0 18px}
  .consent a{color:var(--crimson);font-weight:700}
  .cta-full{width:100%;justify-content:center}
  .autosave{font-size:13px;color:var(--muted);text-align:center;margin-top:14px}

  .docs{margin-top:20px;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:8px 22px;box-shadow:var(--shadow)}
  .docs summary{font-weight:700;font-size:15px;padding:14px 0;cursor:pointer}
  .docs-body{padding:0 0 18px;color:var(--muted);font-size:14px;line-height:1.6}
  .docs-body ul{margin:12px 0 12px 20px;display:flex;flex-direction:column;gap:8px}
  .docs-note{margin-top:10px;font-style:italic}

  .tri .acard a{display:inline-block;margin-top:8px}
</style>
</Layout>
