---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';

const whyItems = [
  {
    title: 'Mission that shows up in the work',
    body: 'Every feature, coaching session, and ops workflow exists to move a real person closer to a better job — not vanity metrics.',
    ic: 'ic--c',
    icon: 'target',
  },
  {
    title: 'AI-native team',
    body: 'We ship practical AI where counselors and members feel the lift — copilots, automation, and data — not slide-deck experiments.',
    ic: 'ic--b',
    icon: 'sparkle',
  },
  {
    title: 'Equity and transparency',
    body: 'Competitive pay, clear growth paths, and a nonprofit model where outcomes and member trust come before growth hacks.',
    ic: 'ic--g',
    icon: 'shield',
  },
];

const interestAreas = [
  { value: '', label: 'Select…' },
  { value: 'counselor', label: 'Counseling / member success' },
  { value: 'engineering', label: 'Engineering / product' },
  { value: 'operations', label: 'Operations' },
  { value: 'other', label: 'Other' },
];
---
<Layout
  title="Careers at WorkforceAP"
  description="Join Workforce Advancement Project — we hire counselors, engineers, and operations leaders building the workforce engine that gets people to work."
>
<div class="careers-depth">

  <!-- ============================================================
       HERO — SHORT DEPTH STAGE: crimson→plum band, glow auras,
       luminosity-masked photo, gold pill + glass card.
       ============================================================ -->
  <section class="stage">
    <div class="aura aura--1"></div>
    <div class="aura aura--2"></div>
    <div class="aura aura--3"></div>
    <div class="grain"></div>

    <div class="wrap stage-grid">
      <div class="lede">
        <span class="pill"><span class="pill__star">★</span>Work at WorkforceAP</span>
        <h1>Build the workforce engine that <span class="shimmer">gets people to work</span></h1>
        <p class="sub">We are a mission-driven, AI-native nonprofit hiring counselors, engineers, and operations leaders who want member outcomes to scale.</p>
        <div class="acts">
          <a class="dbtn dbtn--solid" href="#open-roles">See open roles <span>→</span></a>
        </div>
      </div>

      <!-- glass card -->
      <div class="glass-card">
        <div class="gc-tag">Now hiring across</div>
        <ul class="gc-list">
          <li><span class="gc-ic gc-ic--c"><Icon name="target" size={18} /></span>Counseling &amp; member success</li>
          <li><span class="gc-ic gc-ic--b"><Icon name="sparkle" size={18} /></span>Engineering &amp; product</li>
          <li><span class="gc-ic gc-ic--g"><Icon name="briefcase" size={18} /></span>Operations</li>
        </ul>
        <div class="gc-foot">501(c)(3) nonprofit · national impact</div>
      </div>
    </div>
  </section>

  <!-- WHY WORK HERE -->
  <section class="blk blk--surface" id="why"><div class="wrap">
    <div class="sec-head">
      <span class="kick kick--crimson">Why work here</span>
      <h2>Mission, craft, and <span class="grad-text">ownership</span></h2>
      <p>Small team, national impact — help people reach training, credentials, and jobs that change trajectories.</p>
    </div>
    <div class="tri">
      {whyItems.map((item) => (
        <div class="acard">
          <div class={`ic ${item.ic}`}><Icon name={item.icon} /></div>
          <h3>{item.title}</h3>
          <p>{item.body}</p>
        </div>
      ))}
    </div>
  </div></section>

  <!-- OPEN ROLES -->
  <section class="blk blk--cream" id="open-roles"><div class="wrap">
    <div class="sec-head">
      <span class="kick kick--crimson">Open roles</span>
      <h2>Current openings</h2>
      <p>Don't see a fit? Tell us how you'd like to contribute — we read every note.</p>
    </div>
    <div class="empty-roles">
      <div class="empty-ic">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="7" width="18" height="13" rx="2" />
          <path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
          <path d="M3 12h18" />
        </svg>
      </div>
      <p>No open roles right now. Share your background below and we'll reach out when something opens.</p>
    </div>
  </div></section>

  <!-- STAY IN TOUCH / INTEREST FORM -->
  <section class="blk blk--surface" id="careers-interest"><div class="wrap">
    <div class="sec-head">
      <span class="kick kick--crimson">Stay in touch</span>
      <h2>No perfect fit but interested?</h2>
      <p>Introduce yourself — we'll keep you in mind for future roles across counseling, engineering, and operations.</p>
    </div>
    <div class="form-card">
      <form class="careers-form" novalidate>
        <div class="frow">
          <div class="field">
            <label for="cf-first">First name <span class="req" aria-hidden="true">*</span></label>
            <input id="cf-first" name="first_name" type="text" autocomplete="given-name" required />
          </div>
          <div class="field">
            <label for="cf-last">Last name <span class="req" aria-hidden="true">*</span></label>
            <input id="cf-last" name="last_name" type="text" autocomplete="family-name" required />
          </div>
        </div>

        <div class="field">
          <label for="cf-email">Email <span class="req" aria-hidden="true">*</span></label>
          <input id="cf-email" name="email" type="email" autocomplete="email" required />
        </div>

        <div class="field">
          <label for="cf-interest">What kind of work interests you?</label>
          <select id="cf-interest" name="interest_area">
            {interestAreas.map((a) => <option value={a.value}>{a.label}</option>)}
          </select>
        </div>

        <div class="field">
          <label for="cf-message">Tell us about yourself <span class="req" aria-hidden="true">*</span></label>
          <textarea
            id="cf-message"
            name="message"
            rows="5"
            required
            placeholder="Share your background, what you're looking for, and links to LinkedIn or a portfolio if you have them."
          ></textarea>
        </div>

        <button type="submit" class="btn btn--primary">Send introduction</button>
      </form>
    </div>
  </div></section>

</div>

<style>
  /* ===================================================================
     CAREERS — DEPTH-LED restyle to match the home.
     short depth stage hero → light alternating bands w/ elevated cards.
     =================================================================== */
  .careers-depth{--glass:rgba(255,255,255,.10);--glass-line:rgba(255,255,255,.18)}

  /* ---------------- SHORT DEPTH HERO STAGE ---------------- */
  .stage{
    position:relative;overflow:hidden;isolation:isolate;
    background:radial-gradient(140% 130% at 80% -10%, #b8334f 0%, var(--accent-dark) 42%, var(--plum) 74%, #4a0e26 100%);
    color:#fff;padding:80px 0 88px;
  }
  .stage-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:56px;align-items:center;position:relative;z-index:2}

  /* glow auras — gold + crimson + white */
  .aura{position:absolute;border-radius:50%;filter:blur(70px);z-index:0;pointer-events:none}
  .aura--1{width:480px;height:480px;top:-150px;right:-110px;background:radial-gradient(circle,rgba(196,154,72,.55),transparent 68%)}
  .aura--2{width:420px;height:420px;bottom:-190px;left:-130px;background:radial-gradient(circle,rgba(173,44,77,.6),transparent 70%)}
  .aura--3{width:340px;height:340px;top:28%;left:44%;background:radial-gradient(circle,rgba(255,255,255,.16),transparent 70%)}

  /* luminosity-masked photo bleeding in from the right */
  .grain{position:absolute;inset:0;z-index:1;mix-blend-mode:overlay;pointer-events:none;
    background-image:url('/images/hero-people.webp');background-size:cover;background-position:center;
    -webkit-mask-image:linear-gradient(90deg,transparent 0%,transparent 40%,#000 100%);
    mask-image:linear-gradient(90deg,transparent 0%,transparent 40%,#000 100%);opacity:.18}

  /* gold PILL — fully visible, never clipped */
  .pill{display:inline-flex;align-items:center;gap:7px;max-width:100%;white-space:nowrap;
    background:linear-gradient(135deg,#e3bd6a,#a47f38);color:#3a2c10;font-weight:800;font-size:12.5px;
    letter-spacing:.02em;line-height:1.1;padding:9px 17px;border-radius:999px;
    box-shadow:0 10px 28px -8px rgba(164,127,56,.6),0 1px 0 rgba(255,255,255,.4) inset}
  .pill__star{font-size:11px;opacity:.95}
  @media(max-width:430px){.pill{white-space:normal;text-align:left}}

  .lede h1{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:clamp(36px,5.2vw,60px);
    line-height:1.04;letter-spacing:-.03em;margin:22px 0 0}
  .shimmer{background:linear-gradient(100deg,#fff 10%,#f3d28f 50%,#fff 90%);
    -webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
  .lede .sub{font-size:19px;line-height:1.55;color:rgba(255,255,255,.82);max-width:34em;margin:20px 0 28px}

  .acts{display:flex;gap:14px;flex-wrap:wrap}

  /* hero glass card */
  .glass-card{position:relative;z-index:2;border-radius:22px;padding:28px;
    background:var(--glass);border:1px solid var(--glass-line);backdrop-filter:blur(18px);
    box-shadow:0 30px 80px -30px rgba(0,0,0,.7),0 1px 0 rgba(255,255,255,.22) inset;color:#fff}
  .gc-tag{font-size:11px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:rgba(255,255,255,.72);margin-bottom:16px}
  .gc-list{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:12px}
  .gc-list li{display:flex;align-items:center;gap:13px;font-family:'Plus Jakarta Sans';font-weight:700;font-size:17px}
  .gc-ic{flex-shrink:0;width:40px;height:40px;border-radius:12px;display:grid;place-items:center;font-size:18px;
    background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.2)}
  .gc-foot{margin-top:20px;padding-top:16px;border-top:1px solid rgba(255,255,255,.16);
    font-size:13px;color:rgba(255,255,255,.74)}

  /* ---------------- LIGHT ALTERNATING BANDS ---------------- */
  .blk{width:100%;padding:var(--sec-pad) 0}
  .blk--surface{background:var(--surface);border-bottom:1px solid var(--border)}
  .blk--cream{background:var(--bg)}

  .sec-head{max-width:680px;margin:0 auto 52px;text-align:center}
  .sec-head h2{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:clamp(32px,4.4vw,52px);line-height:1.02;letter-spacing:-.02em;margin-bottom:14px}
  .sec-head p{color:var(--muted);font-size:18px;line-height:1.55}
  .kick{display:inline-block;font-size:13px;font-weight:800;letter-spacing:.16em;text-transform:uppercase;margin-bottom:16px}
  .kick--crimson{color:var(--crimson)}

  /* why tri-cards (elevated) */
  .tri{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
  .acard{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:32px 30px;box-shadow:var(--shadow);
    border-top:6px solid var(--crimson);transition:transform .2s,box-shadow .25s}
  .acard:nth-child(2){border-top-color:var(--blue)}
  .acard:nth-child(3){border-top-color:var(--gold)}
  .acard:hover{transform:translateY(-5px);box-shadow:var(--shadow-lg)}
  .acard .ic{width:54px;height:54px;border-radius:15px;display:grid;place-items:center;font-size:24px;margin-bottom:18px}
  .ic--c{background:rgba(173,44,77,.12);color:var(--crimson)}
  .ic--b{background:rgba(43,123,185,.12);color:var(--blue)}
  .ic--g{background:rgba(164,127,56,.14);color:var(--gold-dark)}
  .acard h3{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:20px;margin-bottom:10px}
  .acard p{color:var(--muted);font-size:16px;line-height:1.55}

  /* empty roles state */
  .empty-roles{max-width:560px;margin:0 auto;text-align:center;background:var(--surface);border:1px dashed var(--border);border-radius:var(--radius);padding:44px 32px;box-shadow:var(--shadow)}
  .empty-ic{width:60px;height:60px;border-radius:16px;margin:0 auto 18px;display:grid;place-items:center;background:rgba(173,44,77,.1);color:var(--crimson)}
  .empty-roles p{color:var(--muted);font-size:16px;margin-bottom:0}

  /* interest form */
  .form-card{max-width:680px;margin:0 auto;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:34px;box-shadow:var(--shadow-lg)}
  .careers-form .frow{display:grid;grid-template-columns:1fr 1fr;gap:18px}
  .careers-form .field{margin-bottom:18px}
  .careers-form label{display:block;font-weight:600;font-size:14px;margin-bottom:7px}
  .careers-form .req{color:var(--crimson)}
  .careers-form input,
  .careers-form select,
  .careers-form textarea{width:100%;font-family:inherit;font-size:15px;color:var(--text);background:var(--surface-2);border:1px solid var(--border);border-radius:12px;padding:12px 14px;transition:border-color .15s,box-shadow .15s}
  .careers-form input:focus,
  .careers-form select:focus,
  .careers-form textarea:focus{outline:none;border-color:var(--crimson);box-shadow:0 0 0 3px rgba(173,44,77,.12)}
  .careers-form textarea{resize:vertical;min-height:120px}
  .careers-form button{width:100%;justify-content:center;margin-top:4px}

  /* ---------------- RESPONSIVE ---------------- */
  @media(max-width:880px){
    .stage{padding:64px 0 76px}
    .stage-grid{grid-template-columns:1fr;gap:48px}
    .grain{-webkit-mask-image:none;mask-image:none;opacity:.12}
    .tri{grid-template-columns:1fr}
  }
  @media(max-width:560px){
    .careers-form .frow{grid-template-columns:1fr}
    .form-card{padding:24px}
    .acts .dbtn{width:100%;justify-content:center}
  }
</style>
</Layout>
