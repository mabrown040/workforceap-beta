// WorkforceAP Members Portal - Prisma Schema
// Database: Supabase Postgres (POSTGRES_PRISMA_URL from Vercel integration, or DATABASE_URL for local)
// Auth: Supabase Auth (auth.users) - our users.id matches auth.users.id

generator client {
  provider = "prisma-client-js"
}

// Run with: npm run db:seed
// To promote a user to admin: INSERT INTO user_roles (user_id, role_id) SELECT '<user_id>', id FROM roles WHERE name = 'admin';

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

// --- Core tables ---

model Organization {
  id               String   @id @default(uuid())
  name             String
  slug             String   @unique
  customDomain     String?  @unique @map("custom_domain")
  logo             String?
  primaryColor       String?  @map("primary_color")
  accentColor        String?  @map("accent_color")
  billingType        String   @default("flat") @map("billing_type")
  plan               String   @default("nonprofit")
  subscriptionTier   String   @default("starter") @map("subscription_tier")
  subscriptionStatus String   @default("trial") @map("subscription_status")
  active             Boolean  @default(true)
  overviewVideoUrl String?  @map("overview_video_url")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  users             User[]
  partners          Partner[]
  employers         Employer[]
  jobs              Job[]
  programCatalog    OrganizationProgramCatalog[]
  preScreenings     PreScreeningResponse[]
  applyEligibilityScreenings ApplyEligibilityScreening[]
  publicWioaScreenings PublicWioaScreening[]
  courseEnrollments CourseEnrollment[]
  courses           Course[]
  auditEvents       AuditEvent[]

  @@map("organizations")
}

model User {
  id                           String              @id @default(uuid())
  organizationId               String              @map("organization_id")
  email                        String              @unique
  fullName                     String              @map("full_name")
  phone                        String?
  assessmentCompleted          Boolean             @default(false) @map("assessment_completed")
  assessmentCompletedAt        DateTime?           @map("assessment_completed_at")
  assessmentScore              Int?                @map("assessment_score")
  assessmentScorePct           Int?                @map("assessment_score_pct")
  programInterest              String?             @map("program_interest")
  assessmentAnswers            Json?               @map("assessment_answers")
  enrolledProgram              String?             @map("enrolled_program")
  enrolledAt                   DateTime?           @map("enrolled_at")
  programChangedAt             DateTime?           @map("program_changed_at")
  coursesCompleted             Json?               @map("courses_completed") // array of course slugs
  notificationsUpdates         Boolean             @default(true) @map("notifications_updates")
  notificationsReminders       Boolean             @default(true) @map("notifications_reminders")
  /// Soft-delete for members (and other rows in `users`). Partner/employer/counselor
  /// personas also use this `users` row; filters use `deletedAt: null` for active
  /// accounts. Related portal tables (e.g. `employers`, `partner_users`) do not
  /// duplicate `deletedAt` — lifecycle is anchored on `User`.
  deletedAt                    DateTime?           @map("deleted_at")
  createdAt                    DateTime            @default(now()) @map("created_at")
  updatedAt                    DateTime            @updatedAt @map("updated_at")
  interviewEligible            Boolean             @default(false) @map("interview_eligible")
  interviewRequestedAt         DateTime?           @map("interview_requested_at")
  interviewCompletedAt         DateTime?           @map("interview_completed_at")
  onboardingCompletedAt        DateTime?           @map("onboarding_completed_at")
  onboardingPortal             String?             @map("onboarding_portal")
  tourCompletedAt              DateTime?           @map("tour_completed_at")
  workspaceEmail               String?             @map("workspace_email")
  workspaceEmailProvisioned    Boolean             @default(false) @map("workspace_email_provisioned")
  /// Set when career quiz indicates no reliable computer; counselors can follow up.
  needsComputerSupportFollowUp Boolean             @default(false) @map("needs_computer_support_follow_up")
  /// Daily cron: Coursera course progress stale for this member (see stale-training-check cron).
  staleTrainingDetectedAt      DateTime?           @map("stale_training_detected_at")
  /// Set when /api/member/coursera/auto-sync seeded CourseEnrollment + replayed
  /// xAPI for this user from B4B; the dashboard home auto-sync trigger reads
  /// this to dedupe and skip the call when fresh (≤1h). NULL = never auto-synced.
  lastCourseraAutoSyncAt       DateTime?           @map("last_coursera_auto_sync_at")
  /// Last time the member logged into the portal. Updated by auth layer.
  lastLoginAt                  DateTime?           @map("last_login_at")
  /// Eligibility gate for self-service Coursera For Business enrollment via the
  /// "Enroll in this course" button on /dashboard/training. Default false; never
  /// flipped by DB defaults — only by explicit code paths (counselor program-
  /// change approval, admin "Approve enrollment" toggle). Every flip is recorded
  /// in `audit_logs` with the actor's user id. Every B4B paid seat starts here:
  /// see `docs/COURSERA-ENROLLMENT-FLOW.md`.
  courseraEnrollmentApproved      Boolean          @default(false) @map("coursera_enrollment_approved")
  courseraEnrollmentApprovedAt    DateTime?        @map("coursera_enrollment_approved_at")
  courseraEnrollmentApprovedById  String?          @map("coursera_enrollment_approved_by")
  /// O*NET-backed quiz snapshot for dashboard / consistency (JSON CareerMatchResult shape).
  careerRecommendationJson     Json?               @map("career_recommendation_json")
  /// Self-service WIA/WIOA screening answers + eligibility signal (not a legal determination).
  wioaQualificationJson        Json?               @map("wioa_qualification_json")
  /// Staff review: pending | in_review | verified | not_eligible | needs_info
  wioaReviewStatus             String?             @map("wioa_review_status")
  wioaReviewedAt               DateTime?           @map("wioa_reviewed_at")
  wioaReviewedByUserId         String?             @map("wioa_reviewed_by_user_id")
  wioaReviewNotes              String?             @map("wioa_review_notes") @db.Text
  wioaReviewer                 User?               @relation("WioaReviewStaff", fields: [wioaReviewedByUserId], references: [id], onDelete: SetNull)
  /// Admin pipeline board column; when null, stage is derived from enrollment, courses, certs, placement.
  pipelineBoardStage           PipelineBoardStage? @map("pipeline_board_stage")

  organization           Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  profile                Profile?
  readinessChecklist     ReadinessChecklist[]
  applications           Application[]
  jobApplications        JobApplication[]
  applicationAiFeedbacks ApplicationAiFeedback[]
  benefitRequests        BenefitRequest[]
  learningProgress       LearningProgress[]
  aiToolResults          AIToolResult[]
  coachMemory            CoachMemory?
  userCertifications     UserCertification[]
  userRoles              UserRole[]
  auditLogs              AuditLog[]              @relation("ActorAuditLogs")
  auditEvents            AuditEvent[]            @relation("ActorAuditEvents")
  goals                  Goal[]
  resourceProgress       ResourceProgress[]
  memberEvents           MemberEvent[]
  workflowDiagnostics    WorkflowDiagnostic[]    @relation("WorkflowDiagnosticActor")
  weeklyRecaps           WeeklyRecap[]
  pathwayStepProgress    PathwayStepProgress[]
  trainingAccessRequests TrainingAccessRequest[]
  invitationsSent        Invitation[]            @relation("InvitationInviter")
  invitationsAccepted    Invitation[]            @relation("InvitationAccepter")

  counselorProfile     Counselor?
  counselorAssignments CounselorAssignment[] @relation("MemberAssignments")
  partnerReferrals     PartnerReferral[]     @relation("MemberReferrals")
  placementRecord      PlacementRecord?
  placedOutcome        PlacedOutcome?
  counselorNotes       CounselorNote[]       @relation("MemberNotes")
  notesAuthored        CounselorNote[]       @relation("NoteAuthor")
  partnerUser          PartnerUser?
  employer             Employer?
  employersApproved    Employer[]            @relation("EmployerApprover")

  jobPostingApplications   JobPostingApplication[]
  aiJobMatches             AIJobMatch[]
  nextBestActions          MemberNextBestAction[]
  jobsApproved             Job[]                   @relation("JobApprover")
  programChangeRequests    ProgramChangeRequest[]
  programChangeReviews     ProgramChangeRequest[]  @relation("ProgramChangeReviewer")
  partnerOutreachAbout     PartnerOutreachLog[]    @relation("PartnerOutreachMember")
  partnerOutreachAuthored  PartnerOutreachLog[]    @relation("PartnerOutreachAuthor")
  assignedPartnerReferrals PartnerReferral[]       @relation("PartnerReferralAssignee")
  portalWorkflowEvents     PortalWorkflowEvent[]

  subgroupsLed            Subgroup[]       @relation("SubgroupLeader")
  subgroupsCreated        Subgroup[]       @relation("SubgroupCreator")
  memberSubgroups         MemberSubgroup[]
  memberSubgroupsAssigned MemberSubgroup[] @relation("MemberSubgroupAssigner")
  subgroupLeaderRows      SubgroupLeader[]

  messageThreadsAsMember      MessageThread[]       @relation("MemberMessageThreads")
  messageThreadsAsCounselor   MessageThread[]       @relation("CounselorMessageThreads")
  messageThreadsAsStaff       MessageThread[]       @relation("StaffPortalMessageThreads")
  messagesAuthored            Message[]
  applicationMessagesAuthored ApplicationMessage[]
  preScreeningResponse        PreScreeningResponse?
  preScreeningDraft           PreScreeningDraft?
  applyEligibilityScreenings  ApplyEligibilityScreening[]
  /// All program enrollments for the user (multi-program support). At most
  /// one row has `isPrimary = true` (enforced by partial unique index). Use
  /// `findFirst({ where: { userId, isPrimary: true } })` for the primary
  /// enrollment, or `findUnique({ where: { userId_programSlug: ... } })`
  /// for a specific program.
  courseEnrollments           CourseEnrollment[]
  adminCourseEnrollments      CourseEnrollment[]    @relation("AdminCourseEnrollments")

  mentorProfile       Mentor?
  mentorSessions      MentorSession[] @relation("MentorSessionMember")
  membersWioaReviewed User[]          @relation("WioaReviewStaff")

  memberPoints       MemberPoints?
  pointsTransactions PointsTransaction[]
  pointsAwarded      PointsTransaction[] @relation("PointsAwarder")
  courseProgress           CourseProgress[]
  memberProgramProgress    MemberProgramProgress[]

  courseraCourseProgress   CourseraCourseProgress[]
  courseraBadgeProgress    CourseraBadgeProgress[]
  courseraSkillsetProgress CourseraSkillsetProgress[]
  courseraCanonicalCourseMappingsCreated CourseraCanonicalCourseMapping[] @relation("CourseraCanonicalCourseMappingCreatedBy")
  atRiskAlerts             AtRiskAlert[]
  memberNudgeLogs          MemberNudgeLog[]
  placementSurveys       PlacementSurvey[]
  milestoneCascades        MilestoneCascade[]
  testimonials           Testimonial[]
  reviewedTestimonials   Testimonial[] @relation("TestimonialReviewer")
  memberFeedback         MemberFeedback[]
  notifications          Notification[]

  @@index([organizationId])
  @@index([wioaReviewStatus])
  @@index([enrolledProgram])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([email])
  @@index([staleTrainingDetectedAt])
  @@index([lastCourseraAutoSyncAt])
  @@index([courseraEnrollmentApproved])
  @@index([wioaReviewedByUserId])
  @@map("users")
}

model Profile {
  id                    String    @id @default(uuid())
  userId                String    @unique @map("user_id")
  address               String?
  city                  String?
  state                 String?
  zip                   String?
  profilePhone          String?   @map("profile_phone")
  profileAddress        String?   @map("profile_address")
  profileLinkedin       String?   @map("profile_linkedin")
  profileBio            String?   @map("profile_bio")
  dob                   DateTime? @db.Date
  veteranStatus         String?   @map("veteran_status")
  employmentStatus      String?   @map("employment_status")
  educationLevel        String?   @map("education_level")
  householdIncome       String?   @map("household_income")
  referralSource        String?   @map("referral_source")
  usCitizen             Boolean?  @map("us_citizen")
  authorizedToWork      Boolean?  @map("authorized_to_work")
  hasDisability         Boolean?  @map("has_disability")
  ethnicity             String?   @map("ethnicity")
  counselorNotes        String?   @map("counselor_notes") @db.Text
  resumeOriginalPath    String?   @map("resume_original_path")
  resumeEnhancedPath    String?   @map("resume_enhanced_path")
  consentTerms          Boolean   @default(false) @map("consent_terms")
  consentCommunications Boolean   @default(false) @map("consent_communications")
  smsOptIn              Boolean   @default(false) @map("sms_opt_in")
  financialAidInterest  Boolean?  @map("financial_aid_interest")

  // WIOA grant reporting — self-reported employment barriers and status at enroll
  hasEmploymentBarrier     Boolean  @default(false) @map("has_employment_barrier")
  barrierTypes             String[] @default([]) @map("barrier_types")
  employmentStatusAtEnroll String?  @map("employment_status_at_enroll")

  // Minor (under 18) data handling for high school partnerships
  isMinor              Boolean   @default(false) @map("is_minor")
  parentGuardianName   String?   @map("parent_guardian_name")
  parentGuardianEmail  String?   @map("parent_guardian_email")
  parentGuardianPhone  String?   @map("parent_guardian_phone")
  parentalConsentGiven Boolean   @default(false) @map("parental_consent_given")
  parentalConsentDate  DateTime? @map("parental_consent_date")
  schoolName           String?   @map("school_name")
  schoolDistrict       String?   @map("school_district")
  gradeLevel           String?   @map("grade_level")
  studentId            String?   @map("student_id")
  ferpaConsentGiven    Boolean   @default(false) @map("ferpa_consent_given")

  role      String   @default("member")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model ReadinessChecklist {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  section     Int // 1–13
  itemKey     String    @map("item_key")
  completed   Boolean   @default(false)
  completedAt DateTime? @map("completed_at")
  completedBy String?   @map("completed_by") // counselor user_id
  notes       String?   @db.Text
  valueText   String?   @map("value_text") @db.Text // for free-text fields (job titles, elevator pitch, etc.)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemKey])
  @@index([userId])
  @@map("readiness_checklist")
}

model Application {
  id                     String            @id @default(uuid())
  userId                 String            @map("user_id")
  status                 ApplicationStatus @default(PENDING)
  programInterest        String            @map("program_interest")
  programRankedSlugs     Json?             @map("program_ranked_slugs")
  recommendedOnetCode    String?           @map("recommended_onet_code")
  recommendedCareerTitle String?           @map("recommended_career_title")
  notes                  String?           @db.Text
  submittedAt            DateTime?         @map("submitted_at")
  referralSource         String?           @map("referral_source")
  referralPartnerId      String?           @map("referral_partner_id")
  createdAt              DateTime          @default(now()) @map("created_at")
  updatedAt              DateTime          @updatedAt @map("updated_at")

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  referralPartner Partner? @relation(fields: [referralPartnerId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([referralPartnerId])
  @@map("applications")
}

enum FundingSource {
  GRANT
  EMPLOYER
  PARTNER_ORG
  SELF
  OTHER
}

enum ApplicationStatus {
  PENDING
  APPROVED
  DENIED
  NEEDS_INFO
}

model Role {
  id        String   @id @default(uuid())
  name      String   @unique // member, admin, case_manager
  createdAt DateTime @default(now()) @map("created_at")

  userRoles UserRole[]

  @@map("roles")
}

model UserRole {
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model Resource {
  id             String       @id @default(uuid())
  title          String
  type           ResourceType
  url            String?
  path           String?
  visibilityRule String?      @map("visibility_rule") // e.g. "member", "admin", "case_manager"
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@map("resources")
}

enum ResourceType {
  DOCUMENT
  VIDEO
  LINK
}

model JobApplication {
  id                String               @id @default(uuid())
  userId            String               @map("user_id")
  company           String
  role              String
  status            JobApplicationStatus @default(SAVED)
  appliedAt         DateTime?            @map("applied_at")
  source            JobApplicationSource @default(OTHER)
  nextInterviewDate DateTime?            @map("next_interview_date")
  notes             String?              @db.Text
  url               String?
  /// When set, this row is linked to a curated employer job on the member job board.
  curatedJobId      String?              @map("curated_job_id")
  /// Cron: pre-interview reminder email sent (idempotency).
  interviewPreReminderSentAt DateTime? @map("interview_pre_reminder_sent_at")
  /// Cron: day-after interview self-report prompt sent.
  interviewPostFollowUpSentAt DateTime? @map("interview_post_follow_up_sent_at")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)
  curatedJob Job? @relation(fields: [curatedJobId], references: [id], onDelete: SetNull)
  applicationAiFeedback ApplicationAiFeedback?

  @@index([userId])
  @@index([status])
  @@index([curatedJobId])
  @@index([nextInterviewDate])
  @@index([userId, createdAt])
  @@index([userId, status, createdAt])
  @@map("job_applications")
}

enum JobApplicationStatus {
  SAVED
  APPLIED
  PHONE_SCREEN
  INTERVIEWING
  OFFER
  ACCEPTED
  REJECTED
}

enum JobApplicationSource {
  INDEED
  LINKEDIN
  DIRECT
  OTHER
}

model BenefitRequest {
  id        String               @id @default(uuid())
  userId    String               @map("user_id")
  benefit   String // linkedin_premium, coursera
  status    BenefitRequestStatus @default(PENDING)
  createdAt DateTime             @default(now()) @map("created_at")
  updatedAt DateTime             @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, benefit])
  @@index([userId])
  @@index([status])
  @@map("benefit_requests")
}

enum BenefitRequestStatus {
  PENDING
  APPROVED
  DENIED
}

/// Member-initiated request to switch enrollment program (counselor/admin review).
model ProgramChangeRequest {
  id                   String                     @id @default(uuid())
  userId               String                     @map("user_id")
  currentProgramSlug   String?                    @map("current_program_slug")
  requestedProgramSlug String                     @map("requested_program_slug")
  reason               String                     @db.Text
  status               ProgramChangeRequestStatus @default(PENDING)
  adminNote            String?                    @map("admin_note") @db.Text
  reviewedById         String?                    @map("reviewed_by_id")
  reviewedAt           DateTime?                  @map("reviewed_at")
  createdAt            DateTime                   @default(now()) @map("created_at")
  updatedAt            DateTime                   @updatedAt @map("updated_at")

  user       User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("ProgramChangeReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([reviewedById])
  @@map("program_change_requests")
}

enum ProgramChangeRequestStatus {
  PENDING
  APPROVED
  DENIED
  CANCELLED
}

/// Columns on /admin/pipeline kanban (manual position; null = data-driven stage).
enum PipelineBoardStage {
  applied
  enrolled
  in_training
  certified
  job_searching
  placed

  @@map("pipeline_board_stage")
}

model LearningProgress {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  pathwayId String   @map("pathway_id")
  completed Boolean  @default(false)
  progress  Int      @default(0) // 0-100
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, pathwayId])
  @@index([userId])
  @@map("learning_progress")
}

model Goal {
  id                 String     @id @default(uuid())
  userId             String     @map("user_id")
  goalType           String     @map("goal_type") // build_resume, practice_interviews, apply_to_jobs, etc.
  title              String
  description        String?    @db.Text
  targetMetricType   String?    @map("target_metric_type")
  targetMetricValue  Int?       @map("target_metric_value")
  currentMetricValue Int        @default(0) @map("current_metric_value")
  status             GoalStatus @default(ACTIVE)
  targetDate         DateTime?  @map("target_date")
  completedAt        DateTime?  @map("completed_at")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([userId, createdAt])
  @@map("goals")
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  PAUSED
}

model ResourceProgress {
  id               String    @id @default(uuid())
  userId           String    @map("user_id")
  resourceId       String    @map("resource_id") // matches content id e.g. ats-resume-template
  viewedAt         DateTime? @map("viewed_at")
  completedAt      DateTime? @map("completed_at")
  downloadedAt     DateTime? @map("downloaded_at")
  savedAt          DateTime? @map("saved_at")
  viewCount        Int       @default(0) @map("view_count")
  completionStatus String    @default("not_started") @map("completion_status") // not_started, in_progress, completed
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, resourceId])
  @@index([userId])
  @@index([resourceId])
  @@map("resource_progress")
}

model MemberEvent {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  eventName  String   @map("event_name")
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json?
  sourcePage String?  @map("source_page")
  sessionId  String?  @map("session_id")
  requestId  String?  @map("request_id")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([eventName])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([userId, eventName, createdAt])
  @@index([requestId])
  @@map("member_events")
}

model WorkflowDiagnostic {
  id            String   @id @default(uuid())
  workflow      String
  status        String
  actorUserId   String?  @map("actor_user_id")
  entityType    String?  @map("entity_type")
  entityId      String?  @map("entity_id")
  summary       String
  provider      String?
  method        String?
  fallbackPath  String?  @map("fallback_path")
  failureReason String?  @map("failure_reason")
  metadata      Json?
  createdAt     DateTime @default(now()) @map("created_at")

  actor User? @relation("WorkflowDiagnosticActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([workflow, createdAt])
  @@index([status, createdAt])
  @@index([actorUserId])
  @@map("workflow_diagnostics")
}

model CronExecution {
  id               String   @id @default(uuid())
  jobName          String   @map("job_name")
  status           String   // RUNNING | SUCCESS | FAILED | SKIPPED
  startedAt        DateTime @default(now()) @map("started_at")
  completedAt      DateTime? @map("completed_at")
  errorMessage     String?  @map("error_message")
  recordsProcessed Int?     @map("records_processed")
  durationMs       Int?     @map("duration_ms")
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([jobName, createdAt])
  @@index([status, createdAt])
  @@index([startedAt])
  @@map("cron_executions")
}

model WeeklyRecap {
  id                     String    @id @default(uuid())
  userId                 String    @map("user_id")
  weekStartDate          DateTime  @map("week_start_date")
  weekEndDate            DateTime  @map("week_end_date")
  recapJson              Json      @map("recap_json")
  readinessScoreSnapshot Int?      @map("readiness_score_snapshot")
  goalsSnapshotJson      Json?     @map("goals_snapshot_json")
  generatedAt            DateTime  @default(now()) @map("generated_at")
  openedAt               DateTime? @map("opened_at")
  emailedAt              DateTime? @map("emailed_at")
  createdAt              DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

