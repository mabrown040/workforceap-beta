---
import Layout from '../layouts/Layout.astro';

const whyItems = [
  {
    title: 'Mission that shows up in the work',
    body: 'Every feature, coaching session, and ops workflow exists to move a real person closer to a better job — not vanity metrics.',
    ic: 'ic--c',
    emoji: '🎯',
  },
  {
    title: 'AI-native team',
    body: 'We ship practical AI where counselors and members feel the lift — copilots, automation, and data — not slide-deck experiments.',
    ic: 'ic--b',
    emoji: '🤖',
  },
  {
    title: 'Equity and transparency',
    body: 'Competitive pay, clear growth paths, and a nonprofit model where outcomes and member trust come before growth hacks.',
    ic: 'ic--g',
    emoji: '⚖️',
  },
];

const interestAreas = [
  { value: '', label: 'Select…' },
  { value: 'counselor', label: 'Counseling / member success' },
  { value: 'engineering', label: 'Engineering / product' },
  { value: 'operations', label: 'Operations' },
  { value: 'other', label: 'Other' },
];
---
<Layout
  title="Careers at WorkforceAP"
  description="Join Workforce Advancement Project — we hire counselors, engineers, and operations leaders building the workforce engine that gets people to work."
>
  <!-- HERO -->
  <section class="hero careers-hero"><div class="wrap">
    <div class="careers-hero-in">
      <span class="eyebrow"><span class="dot"></span>Work at WorkforceAP</span>
      <h1>Build the workforce engine that <span class="grad-text">gets people to work</span></h1>
      <p class="sub">We are a mission-driven, AI-native nonprofit hiring counselors, engineers, and operations leaders who want member outcomes to scale.</p>
      <div class="cta">
        <a class="btn btn--primary" href="#open-roles">See open roles →</a>
      </div>
    </div>
  </div></section>

  <!-- WHY WORK HERE -->
  <section class="band band--surface" id="why"><div class="wrap">
    <div class="sec-head">
      <span class="eyebrow">Why work here</span>
      <h2>Mission, craft, and <span class="grad-text">ownership</span></h2>
      <p>Small team, national impact — help people reach training, credentials, and jobs that change trajectories.</p>
    </div>
    <div class="tri">
      {whyItems.map((item) => (
        <div class="acard">
          <div class={`ic ${item.ic}`}>{item.emoji}</div>
          <h3>{item.title}</h3>
          <p>{item.body}</p>
        </div>
      ))}
    </div>
  </div></section>

  <!-- OPEN ROLES -->
  <section class="band" id="open-roles"><div class="wrap">
    <div class="sec-head">
      <span class="eyebrow">Open roles</span>
      <h2>Current openings</h2>
      <p>Don't see a fit? Tell us how you'd like to contribute — we read every note.</p>
    </div>
    <div class="empty-roles">
      <div class="empty-ic">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="7" width="18" height="13" rx="2" />
          <path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
          <path d="M3 12h18" />
        </svg>
      </div>
      <p>No open roles right now. Share your background below and we'll reach out when something opens.</p>
    </div>
  </div></section>

  <!-- STAY IN TOUCH / INTEREST FORM -->
  <section class="band band--surface" id="careers-interest"><div class="wrap">
    <div class="sec-head">
      <span class="eyebrow">Stay in touch</span>
      <h2>No perfect fit but interested?</h2>
      <p>Introduce yourself — we'll keep you in mind for future roles across counseling, engineering, and operations.</p>
    </div>
    <div class="form-card">
      <form class="careers-form" novalidate>
        <div class="frow">
          <div class="field">
            <label for="cf-first">First name <span class="req" aria-hidden="true">*</span></label>
            <input id="cf-first" name="first_name" type="text" autocomplete="given-name" required />
          </div>
          <div class="field">
            <label for="cf-last">Last name <span class="req" aria-hidden="true">*</span></label>
            <input id="cf-last" name="last_name" type="text" autocomplete="family-name" required />
          </div>
        </div>

        <div class="field">
          <label for="cf-email">Email <span class="req" aria-hidden="true">*</span></label>
          <input id="cf-email" name="email" type="email" autocomplete="email" required />
        </div>

        <div class="field">
          <label for="cf-interest">What kind of work interests you?</label>
          <select id="cf-interest" name="interest_area">
            {interestAreas.map((a) => <option value={a.value}>{a.label}</option>)}
          </select>
        </div>

        <div class="field">
          <label for="cf-message">Tell us about yourself <span class="req" aria-hidden="true">*</span></label>
          <textarea
            id="cf-message"
            name="message"
            rows="5"
            required
            placeholder="Share your background, what you're looking for, and links to LinkedIn or a portfolio if you have them."
          ></textarea>
        </div>

        <button type="submit" class="btn btn--primary">Send introduction</button>
      </form>
    </div>
  </div></section>

  <style>
    /* careers hero — single column, centered intro */
    .careers-hero{padding:80px 0 56px}
    .careers-hero-in{max-width:760px}
    .careers-hero h1{font-size:clamp(36px,5.2vw,60px);font-weight:800;margin:20px 0}
    .careers-hero .sub{max-width:34em}

    /* empty roles state */
    .empty-roles{max-width:560px;margin:0 auto;text-align:center;background:var(--surface);border:1px dashed var(--border);border-radius:var(--radius);padding:44px 32px;box-shadow:var(--shadow)}
    .empty-ic{width:60px;height:60px;border-radius:16px;margin:0 auto 18px;display:grid;place-items:center;background:rgba(173,44,77,.1);color:var(--crimson)}
    .empty-roles p{color:var(--muted);font-size:16px;margin-bottom:0}

    /* interest form */
    .form-card{max-width:680px;margin:0 auto;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:34px;box-shadow:var(--shadow-lg)}
    .careers-form .frow{display:grid;grid-template-columns:1fr 1fr;gap:18px}
    .careers-form .field{margin-bottom:18px}
    .careers-form label{display:block;font-weight:600;font-size:14px;margin-bottom:7px}
    .careers-form .req{color:var(--crimson)}
    .careers-form input,
    .careers-form select,
    .careers-form textarea{width:100%;font-family:inherit;font-size:15px;color:var(--text);background:var(--surface-2);border:1px solid var(--border);border-radius:12px;padding:12px 14px;transition:border-color .15s,box-shadow .15s}
    .careers-form input:focus,
    .careers-form select:focus,
    .careers-form textarea:focus{outline:none;border-color:var(--crimson);box-shadow:0 0 0 3px rgba(173,44,77,.12)}
    .careers-form textarea{resize:vertical;min-height:120px}
    .careers-form button{width:100%;justify-content:center;margin-top:4px}
    @media(max-width:560px){.careers-form .frow{grid-template-columns:1fr}.form-card{padding:24px}}
  </style>
</Layout>
