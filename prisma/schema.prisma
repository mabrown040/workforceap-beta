enum JobLocationType {
  remote
  hybrid
  onsite

  @@map("job_location_type")
}

enum JobTypeEnum {
  fulltime
  parttime
  contract

  @@map("job_type_enum")
}

enum JobStatusEnum {
  draft
  pending
  approved
  live
  filled
  closed

  @@map("job_status_enum")
}

model Job {
  id                         String          @id @default(uuid())
  organizationId             String          @map("organization_id")
  employerId                 String          @map("employer_id")
  title                      String
  location                   String?
  locationType               JobLocationType @default(onsite) @map("location_type")
  jobType                    JobTypeEnum     @default(fulltime) @map("job_type")
  salaryMin                  Int?            @map("salary_min")
  salaryMax                  Int?            @map("salary_max")
  description                String          @db.Text
  sourceUrl                  String?         @map("source_url")
  importProvider             String?         @map("import_provider")
  importMethod               String?         @map("import_method")
  requirements               String[]        @default([])
  preferredCertifications    String[]        @default([]) @map("preferred_certifications")
  suggestedPrograms          String[]        @default([]) @map("suggested_programs")
  minimumAge                 Int?            @map("minimum_age")
  youthAppropriate           Boolean         @default(false) @map("youth_appropriate")
  requiresWorkPermit         Boolean         @default(false) @map("requires_work_permit")
  status                     JobStatusEnum   @default(draft)
  applicationsCount          Int             @default(0) @map("applications_count")
  createdAt                  DateTime        @default(now()) @map("created_at")
  updatedAt                  DateTime        @updatedAt @map("updated_at")
  approvedAt                 DateTime?       @map("approved_at")
  approvedById               String?         @map("approved_by")
  aiMatchesComputedAt        DateTime?       @map("ai_matches_computed_at")
  matchSuggestionsLastSentAt DateTime?       @map("match_suggestions_last_sent_at")
  matchSuggestionsLastStatus String?         @map("match_suggestions_last_status")
  matchSuggestionsLastError  String?         @map("match_suggestions_last_error") @db.Text

  employer          Employer                @relation(fields: [employerId], references: [id], onDelete: Cascade)
  organization      Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  approvedBy        User?                   @relation("JobApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  applications      JobPostingApplication[]
  aiMatches         AIJobMatch[]
  memberTrackerRows JobApplication[]

  @@index([employerId])
  @@index([organizationId])
  @@index([status])
  @@map("jobs")
}

// Admin-managed program catalog (org-scoped); syncs with static slugs in lib/content/programs for enroll path.
model OrganizationProgramCatalog {
