---
import Layout from '../layouts/Layout.astro';
---
<Layout title="WorkforceAP — Empowering People. Advancing Futures.">
<div class="mix3">

  <!-- ============================================================
       HERO — DEPTH STAGE (lead): deep radial crimson→plum stage,
       gold/crimson/white glow auras, luminosity-masked photo,
       stacked rotated glass cards (credentials → pathway → $0).
       ============================================================ -->
  <section class="stage">
    <div class="aura aura--1"></div>
    <div class="aura aura--2"></div>
    <div class="aura aura--3"></div>
    <div class="grain"></div>

    <div class="wrap stage-grid">
      <div class="lede">
        <span class="pill"><span class="pill__star">★</span>501(c)(3) nonprofit · Employer-recognized certificates</span>
        <h1>Empowering People.<br><span class="shimmer">Advancing Futures.</span></h1>
        <p class="sub">Employer-aligned training, professional certificates, and real career support — at no cost to members who qualify through scholarship/grant funded membership.</p>
        <div class="acts">
          <a class="dbtn dbtn--solid" href="/apply">Start your application <span>→</span></a>
          <a class="dbtn dbtn--glass" href="/find-your-path">Find your path</a>
        </div>
        <div class="proof">
          <div class="proof-i"><b>25+</b><span>years in workforce development</span></div>
          <div class="proof-i"><b>$0</b><span>for members who qualify through scholarship/grant funded membership</span></div>
          <div class="proof-i"><b>1–2 days</b><span>real-team review</span></div>
        </div>
      </div>

      <!-- stacked translucent glass deck -->
      <div class="deck">
        <div class="card card--back">
          <div class="card-tag">Recognized credentials</div>
          <div class="logos">
            <span>IBM</span><span>Google</span><span>Microsoft</span><span>AWS</span><span>CompTIA</span>
          </div>
        </div>

        <div class="card card--mid">
          <div class="mid-row">
            <small>Your pathway</small>
            <span class="dot-live">Live</span>
          </div>
          <div class="mid-big">From apply to hired</div>
          <div class="track">
            <i class="t-done"></i><i class="t-done"></i><i class="t-now"></i><i></i>
          </div>
          <div class="track-labels"><span>Apply</span><span>Match</span><span>Certify</span><span>Launch</span></div>
        </div>

        <div class="card card--front">
          <div class="front-head">
            <div class="ic">✓</div>
            <div>
              <b>Application reviewed</b>
              <span>A real team follows up in 1–2 business days.</span>
            </div>
          </div>
          <div class="meter">
            <span>Cost to members who qualify through scholarship/grant funded membership</span>
            <strong>$0</strong>
          </div>
          <div class="chips">
            <span>~5 min to apply</span>
            <span>No cost to qualifying members</span>
            <span>Real career support</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== MISSION STATEMENT (verbatim, per founder) — directly below hero ===== -->
  <section class="mission">
    <div class="wrap">
      <div class="mission-card">
        <span class="mission-eyebrow">Our mission</span>
        <p class="mission-lead">Workforce Advancement Project (WorkforceAP) is a 501(c)(3) nonprofit that equips individuals, nonprofits, counselors, and community advisors with workforce readiness tools, occupational training and professional certificates, and AI-powered resume, interview, and job placement assistance to help secure meaningful employment, build lasting careers, and a better life no cost to the member who qualify through scholarship/grant funded membership.</p>
        <p class="mission-action">Start with <a href="/find-your-path">Find Your Path</a>, see programs that fit, and get advisor guidance, resume help, and job-search support.</p>
        <div class="mission-cta">
          <a class="btn btn--primary" href="/find-your-path">Find Your Path →</a>
          <a class="btn btn--ghost" href="/programs">See programs</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== CERT PARTNERS BAND ===== -->
  <section class="creds-band">
    <div class="wrap">
      <p class="creds-lab">Employer-recognized credentials you can earn</p>
      <div class="creds-row">
        <span class="logo">IBM</span><span class="logo">Google</span><span class="logo">Microsoft</span><span class="logo">AWS</span><span class="logo">CompTIA</span>
        <span class="creds-extra">+ CPT &amp; CLT</span>
      </div>
    </div>
  </section>

  <!-- ============================================================
       HOW IT WORKS — IMMERSIVE full-bleed photo section.
       100vw cinematic photo, crimson veil, headline over it.
       The 4-step journey sits on the photo backdrop.
       ============================================================ -->
  <section class="imm-band">
    <div class="imm-band__media" aria-hidden="true"></div>
    <div class="imm-band__veil" aria-hidden="true"></div>
    <div class="imm-band__inner wrap">
      <div class="imm-head">
        <span class="imm-eyebrow">The journey</span>
        <h2>From apply to <span class="imm-grad">hired</span>, with a team behind you</h2>
        <p>Four steps from application to a recognized credential and real career support — fully supported the whole way.</p>
      </div>
      <div class="imm-journey">
        <div class="imm-jcard">
          <div class="imm-jnum">01</div>
          <h3>Apply</h3>
          <p>Takes about 5 minutes. No cost for members who qualify through scholarship/grant funded membership — a real team reviews it.</p>
          <span class="imm-tag">~5 min</span>
        </div>
        <div class="imm-jcard">
          <div class="imm-jnum">02</div>
          <h3>Get matched</h3>
          <p>We match you to the program track that fits your goals and background.</p>
        </div>
        <div class="imm-jcard">
          <div class="imm-jnum">03</div>
          <h3>Train &amp; certify</h3>
          <p>Build job-ready skills and earn an employer-recognized professional certificate.</p>
        </div>
        <div class="imm-jcard">
          <div class="imm-jnum">04</div>
          <h3>Launch</h3>
          <p>Move into the workforce with resume, interview, and mentor support behind you.</p>
        </div>
      </div>
      <p class="imm-note">A real team reviews your application and follows up in 1 to 2 business days.</p>
    </div>
  </section>

  <!-- ============================================================
       WHO WE SERVE — BOLD tri-cards (high-contrast, top-accent).
       ============================================================ -->
  <section class="blk blk--cream">
    <div class="wrap">
      <div class="head">
        <span class="kick kick--crimson">A connected network</span>
        <h2>Built for members,<br>employers &amp; partners.</h2>
      </div>
      <div class="tri">
        <div class="tcard">
          <span class="tcard__tag tcard__tag--c">Members</span>
          <p>Employer-aligned training, professional certificates, and a team that supports you to job-ready — at no cost to members who qualify through scholarship/grant funded membership.</p>
          <a class="tlink" href="/apply">Start your application →</a>
        </div>
        <div class="tcard">
          <span class="tcard__tag tcard__tag--b">Employers</span>
          <p>Build a pipeline of training-aligned candidates for in-demand roles — no per-placement fees.</p>
          <a class="tlink" href="/employers">Talk with us about hiring →</a>
        </div>
        <div class="tcard">
          <span class="tcard__tag tcard__tag--g">Partners</span>
          <p>Extend workforce impact in your community through referral and program partnerships.</p>
          <a class="tlink" href="/partners">Explore partnership →</a>
        </div>
      </div>
      <p class="truth">We're a nonprofit — so we don't inflate outcomes. We publish verified placement data as cohorts complete, with the methodology shown. <a href="/outcomes">See our outcomes →</a></p>
    </div>
  </section>

  <!-- ============================================================
       TRUST FACTS — BOLD crimson block, big gold numbers.
       ============================================================ -->
  <section class="blk blk--crimson">
    <div class="wrap facts">
      <div class="fact"><div class="fk">25+</div><p>years in workforce development</p></div>
      <div class="fact"><div class="fk">501(c)(3)</div><p>nonprofit organization</p></div>
      <div class="fact"><div class="fk">$0</div><p>for members who qualify through scholarship/grant funded membership</p></div>
      <div class="fact"><div class="fk">5</div><p>employer-recognized cert tracks</p></div>
    </div>
  </section>

  <!-- ============================================================
       CLOSING CTA — BOLD full-bleed crimson, photo luminosity.
       ============================================================ -->
  <section class="close">
    <div class="close__media" aria-hidden="true"></div>
    <div class="close__veil" aria-hidden="true"></div>
    <div class="close__inner wrap">
      <span class="pill pill--solid"><span class="pill__star">★</span>Reviewed by a real team in 1–2 business days</span>
      <h2>Your next step starts with<br><span class="gold">one application.</span></h2>
      <p>Apply in about 5 minutes — no cost for members who qualify through scholarship/grant funded membership. A real team reviews it and follows up in 1 to 2 business days.</p>
      <div class="acts acts--center">
        <a class="bbtn bbtn--gold" href="/apply">Start your application</a>
        <a class="bbtn bbtn--outline" href="/find-your-path">Find your path</a>
        <a class="bbtn bbtn--outline" href="/employers">For employers</a>
      </div>
    </div>
  </section>

</div>

<style>
  /* ===================================================================
     MIX3 — DEPTH-LED fusion.
     depth stage hero → immersive full-bleed photo how-it-works →
     bold tri-cards + bold facts → bold full-bleed closing CTA.
     =================================================================== */
  .mix3{--glass:rgba(255,255,255,.10);--glass-line:rgba(255,255,255,.18)}

  /* ---------------- DEPTH HERO STAGE ---------------- */
  .stage{
    position:relative;overflow:hidden;isolation:isolate;
    background:radial-gradient(140% 120% at 80% -10%, #b8334f 0%, var(--accent-dark) 42%, var(--plum) 74%, #4a0e26 100%);
    color:#fff;padding:96px 0 120px;
  }
  .stage-grid{display:grid;grid-template-columns:1.02fr .98fr;gap:60px;align-items:center;position:relative;z-index:2}

  /* glow auras — gold + crimson + white */
  .aura{position:absolute;border-radius:50%;filter:blur(70px);z-index:0;pointer-events:none}
  .aura--1{width:520px;height:520px;top:-160px;right:-120px;background:radial-gradient(circle,rgba(196,154,72,.55),transparent 68%)}
  .aura--2{width:460px;height:460px;bottom:-200px;left:-140px;background:radial-gradient(circle,rgba(173,44,77,.6),transparent 70%)}
  .aura--3{width:380px;height:380px;top:30%;left:42%;background:radial-gradient(circle,rgba(255,255,255,.16),transparent 70%)}

  /* luminosity-masked real photo bleeding in from the right */
  .grain{position:absolute;inset:0;z-index:1;mix-blend-mode:overlay;pointer-events:none;
    background-image:url('/images/hero-people.webp');background-size:cover;background-position:center;
    -webkit-mask-image:linear-gradient(90deg,transparent 0%,transparent 38%,#000 100%);
    mask-image:linear-gradient(90deg,transparent 0%,transparent 38%,#000 100%);opacity:.18}

  /* gold PILL — fully visible, never clipped */
  .pill{display:inline-flex;align-items:center;gap:7px;max-width:100%;white-space:nowrap;
    background:linear-gradient(135deg,#e3bd6a,#a47f38);color:#3a2c10;font-weight:800;font-size:12.5px;
    letter-spacing:.02em;line-height:1.1;padding:9px 17px;border-radius:999px;
    box-shadow:0 10px 28px -8px rgba(164,127,56,.6),0 1px 0 rgba(255,255,255,.4) inset}
  .pill__star{font-size:11px;opacity:.95}
  @media(max-width:430px){.pill{white-space:normal;text-align:left}}

  .lede h1{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:clamp(42px,6vw,74px);
    line-height:1.02;letter-spacing:-.03em;margin:22px 0 0}
  .shimmer{background:linear-gradient(100deg,#fff 10%,#f3d28f 50%,#fff 90%);
    -webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
  .lede .sub{font-size:20px;line-height:1.55;color:rgba(255,255,255,.82);max-width:30em;margin:22px 0 30px}

  .acts{display:flex;gap:14px;flex-wrap:wrap}
  .acts--center{justify-content:center}

  /* mission statement — an elevated card that "pops" off a cream band,
     then the page continues past it */
  .mission{background:var(--bg);border-bottom:1px solid var(--border);padding:clamp(48px,6vw,76px) 0}
  .mission .wrap{max-width:760px}
  .mission-card{position:relative;text-align:center;background:var(--surface);
    border:1px solid var(--border);border-radius:26px;padding:clamp(30px,4.5vw,52px);
    box-shadow:0 30px 80px -30px rgba(109,20,55,.32),0 2px 4px rgba(28,20,20,.05);overflow:hidden}
  .mission-card::before{content:"";position:absolute;left:0;right:0;top:0;height:4px;background:var(--grad-text)}
  .mission-eyebrow{display:inline-block;font-size:13px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--crimson);background:rgba(173,44,77,.08);border:1px solid rgba(173,44,77,.18);padding:6px 14px;border-radius:999px;margin-bottom:18px}
  .mission-lead{font-family:'Plus Jakarta Sans',sans-serif;font-weight:600;font-size:clamp(18px,2.05vw,23px);line-height:1.5;color:var(--text);letter-spacing:-.01em}
  .mission-action{margin-top:18px;font-size:16px;line-height:1.6;color:var(--muted)}
  .mission-action a{color:var(--crimson);font-weight:700}
  .mission-cta{margin-top:24px;display:flex;gap:14px;justify-content:center;flex-wrap:wrap}
  /* pop-in: scale up + lift as it enters (overrides the default reveal slide) */
  html.js-reveal .mission-card[data-reveal]{opacity:0;transform:translateY(30px) scale(.95)}
  html.js-reveal .mission-card[data-reveal].is-in{opacity:1;transform:none}

  .proof{display:flex;gap:30px;flex-wrap:wrap;margin-top:38px}
  .proof-i{display:flex;flex-direction:column;gap:2px}
  .proof-i b{font-family:'Plus Jakarta Sans';font-weight:800;font-size:26px;letter-spacing:-.02em}
  .proof-i span{font-size:13px;color:rgba(255,255,255,.7);max-width:13em}

  /* ---------------- STACKED GLASS DECK ---------------- */
  .deck{position:relative;min-height:430px}
  /* Cards sit on a deep-plum frosted base (not a faint white tint) so white
     text actually pops — readability over the crimson hero. */
  .card{position:absolute;left:0;right:0;border-radius:22px;padding:24px;
    background:linear-gradient(160deg,rgba(74,16,38,.62),rgba(45,8,22,.72));
    border:1px solid rgba(255,255,255,.26);backdrop-filter:blur(20px) saturate(1.1);
    box-shadow:0 30px 80px -28px rgba(0,0,0,.78),0 1px 0 rgba(255,255,255,.3) inset;color:#fff}

  .card--back{top:0;transform:rotate(-3deg) translateX(28px);z-index:1}
  .card-tag{font-size:11px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:rgba(255,255,255,.9);margin-bottom:14px}
  .logos{display:flex;flex-wrap:wrap;gap:14px}
  .logos span{font-family:'Plus Jakarta Sans';font-weight:800;font-size:16px;color:#fff;
    background:rgba(255,255,255,.16);border:1px solid rgba(255,255,255,.3);padding:6px 12px;border-radius:10px}

  .card--mid{top:96px;transform:rotate(1.5deg);z-index:2}
  .mid-row{display:flex;align-items:center;justify-content:space-between}
  .mid-row small{font-size:12px;text-transform:uppercase;letter-spacing:.08em;color:rgba(255,255,255,.9);font-weight:700}
  .dot-live{display:inline-flex;align-items:center;gap:6px;font-size:12px;font-weight:700;color:#fff;
    background:rgba(74,155,79,.42);border:1px solid rgba(120,220,130,.5);padding:4px 10px;border-radius:999px}
  .dot-live::before{content:"";width:7px;height:7px;border-radius:50%;background:#7fe389;box-shadow:0 0 8px #7fe389}
  .mid-big{font-family:'Plus Jakarta Sans';font-weight:800;font-size:24px;margin:8px 0 18px;color:#fff}
  .track{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}
  .track i{height:8px;border-radius:5px;background:rgba(255,255,255,.34)}
  .track i.t-done{background:linear-gradient(90deg,#e3bd6a,#fff)}
  .track i.t-now{background:#fff;box-shadow:0 0 12px rgba(255,255,255,.9)}
  .track-labels{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:9px}
  .track-labels span{font-size:11px;font-weight:600;color:rgba(255,255,255,.94);text-align:center}

  .card--front{top:262px;transform:rotate(-1deg);z-index:3}
  .front-head{display:flex;align-items:flex-start;gap:13px;margin-bottom:18px}
  .front-head .ic{flex-shrink:0;width:38px;height:38px;border-radius:11px;display:grid;place-items:center;
    background:rgba(74,155,79,.45);border:1px solid rgba(120,220,130,.55);color:#dfffe2;font-weight:800;font-size:17px}
  .front-head b{display:block;font-weight:700;font-size:15px;color:#fff}
  .front-head span{font-size:13px;color:rgba(255,255,255,.9)}
  .meter{display:flex;align-items:baseline;justify-content:space-between;gap:12px;padding:14px 16px;border-radius:13px;
    background:rgba(0,0,0,.34);border:1px solid rgba(255,255,255,.18);margin-bottom:14px}
  .meter span{font-size:13px;color:rgba(255,255,255,.94)}
  .meter strong{font-family:'Plus Jakarta Sans';font-weight:800;font-size:26px;color:#f7d590}
  .chips{display:flex;flex-wrap:wrap;gap:8px}
  .chips span{font-size:12px;font-weight:700;color:#fff;padding:6px 12px;border-radius:999px;
    background:rgba(255,255,255,.2);border:1px solid rgba(255,255,255,.32)}

  @media (prefers-reduced-motion: no-preference){
    .deck{animation:mix3-float 8s ease-in-out infinite}
    @keyframes mix3-float{0%,100%{transform:translateY(0)}50%{transform:translateY(-10px)}}
  }

  /* MOBILE: the absolute/rotated overlap clips on narrow screens, so un-stack
     into a clean vertical flow — every card fully visible, nothing cut off.
     The layered rotated deck stays on desktop where there's room. */
  @media(max-width:880px){
    .deck{position:static;min-height:0;display:flex;flex-direction:column;gap:16px;animation:none;margin-top:4px}
    .card{position:static;left:auto;right:auto}
    .card--back,.card--mid,.card--front{top:auto;transform:none}
  }

  /* ---------------- CREDS BAND ---------------- */
  .creds-band{background:var(--surface);border-top:3px solid var(--gold);border-bottom:1px solid var(--border);padding:34px 0}
  .creds-lab{text-align:center;color:var(--muted);font-size:12px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;margin-bottom:16px}
  .creds-row{display:flex;align-items:center;justify-content:center;gap:clamp(24px,5vw,52px);flex-wrap:wrap}
  .creds-row .logo{font-family:'Plus Jakarta Sans';font-weight:800;font-size:clamp(20px,3vw,26px);color:#4a4440;opacity:.8}
  .creds-extra{color:var(--gold-dark);font-weight:800;font-size:15px}

  /* ---------------- IMMERSIVE FULL-BLEED PHOTO HOW-IT-WORKS ---------------- */
  .imm-band{
    position:relative;overflow:hidden;
    width:100vw;left:50%;right:50%;margin-left:-50vw;margin-right:-50vw;
    padding:0;
  }
  .imm-band__media{
    position:absolute;inset:0;
    background:url('/images/hero-people.webp') center 35%/cover no-repeat;
    transform:scale(1.04);
  }
  .imm-band__veil{
    position:absolute;inset:0;
    background:
      linear-gradient(180deg,rgba(45,8,22,.78) 0%,rgba(109,20,55,.62) 40%,rgba(140,15,55,.7) 100%),
      linear-gradient(115deg,rgba(173,44,77,.7) 0%,rgba(109,20,55,.5) 100%);
  }
  .imm-band__inner{position:relative;z-index:2;color:#fff;padding:var(--sec-pad) 24px;max-width:var(--max)}
  .imm-head{text-align:center;max-width:720px;margin:0 auto 52px}
  .imm-eyebrow{display:inline-block;font-size:13px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;
    color:#f3d28f;background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.22);padding:7px 15px;border-radius:999px;margin-bottom:18px}
  .imm-head h2{font-family:'Plus Jakarta Sans';font-weight:800;font-size:clamp(32px,4.6vw,54px);line-height:1.05;letter-spacing:-.02em;margin-bottom:14px;
    text-shadow:0 2px 40px rgba(45,8,22,.5)}
  .imm-grad{background:linear-gradient(100deg,#ffd98a,#ffb4c4);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
  .imm-head p{color:rgba(255,255,255,.9);font-size:19px;line-height:1.55;text-shadow:0 1px 20px rgba(45,8,22,.4)}

  .imm-journey{display:grid;grid-template-columns:repeat(4,1fr);gap:20px}
  .imm-jcard{position:relative;background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.2);border-radius:22px;padding:30px 26px;
    backdrop-filter:blur(16px);box-shadow:0 30px 70px -34px rgba(0,0,0,.7),0 1px 0 rgba(255,255,255,.18) inset;
    transition:transform .22s,box-shadow .26s,border-color .2s;color:#fff}
  .imm-jcard:hover{transform:translateY(-6px);border-color:rgba(255,255,255,.36);box-shadow:0 40px 84px -34px rgba(0,0,0,.8)}
  .imm-jnum{font-family:'Plus Jakarta Sans';font-weight:800;font-size:42px;line-height:1;
    background:linear-gradient(100deg,#ffd98a,#ffb4c4);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;margin-bottom:16px}
  .imm-jcard h3{font-family:'Plus Jakarta Sans';font-size:20px;font-weight:800;margin-bottom:8px}
  .imm-jcard p{color:rgba(255,255,255,.82);font-size:15px}
  .imm-tag{display:inline-flex;margin-top:14px;font-size:12px;font-weight:700;padding:5px 11px;border-radius:999px;
    background:rgba(243,210,143,.2);color:#f3d28f;border:1px solid rgba(243,210,143,.3)}
  .imm-note{text-align:center;color:rgba(255,255,255,.78);font-size:14px;margin-top:34px}
  @media(max-width:900px){.imm-journey{grid-template-columns:1fr 1fr}}
  @media(max-width:520px){.imm-journey{grid-template-columns:1fr}}

  /* ---------------- BOLD ALTERNATING BLOCKS ---------------- */
  .blk{width:100%;padding:var(--sec-pad) 0}
  .blk--crimson{background:var(--grad);color:#fff}
  .blk--cream{background:var(--bg);color:var(--text)}
  .gold{color:#e9c879}

  .head{margin-bottom:56px}
  .head h2{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:clamp(38px,6vw,72px);line-height:.96;letter-spacing:-.03em}
  .kick{display:inline-block;font-size:13px;font-weight:800;letter-spacing:.16em;text-transform:uppercase;margin-bottom:18px}
  .kick--crimson{color:var(--crimson)}

  /* BOLD tri-cards */
  .tri{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
  .tcard{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:34px 30px;box-shadow:var(--shadow);
    border-top:6px solid var(--crimson);transition:transform .2s,box-shadow .25s}
  .tcard:hover{transform:translateY(-5px);box-shadow:var(--shadow-lg)}
  .tcard__tag{display:inline-flex;font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:22px;margin-bottom:14px}
  .tcard__tag--c{color:var(--crimson)}
  .tcard__tag--b{color:var(--blue)}
  .tcard__tag--g{color:var(--gold-dark)}
  .tcard:nth-child(2){border-top-color:var(--blue)}
  .tcard:nth-child(3){border-top-color:var(--gold)}
  .tcard p{color:var(--muted);font-size:16px;line-height:1.55;margin-bottom:20px}
  .tlink{font-weight:800;color:var(--crimson);font-size:15px}
  .tcard:nth-child(2) .tlink{color:var(--blue)}
  .tcard:nth-child(3) .tlink{color:var(--gold-dark)}
  .truth{max-width:720px;margin:36px auto 0;text-align:center;color:var(--muted);font-size:14px;
    background:var(--surface-2);border:1px dashed var(--border);border-radius:14px;padding:18px 22px}
  .truth a{color:var(--crimson);font-weight:800}

  /* BOLD facts */
  .facts{display:grid;grid-template-columns:repeat(4,1fr);gap:32px;text-align:center}
  .fact .fk{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:clamp(40px,6vw,72px);color:#e9c879;line-height:1}
  .fact p{color:rgba(255,255,255,.9);font-size:15px;margin-top:10px}

  /* ---------------- BOLD FULL-BLEED CLOSING CTA ---------------- */
  .close{
    position:relative;overflow:hidden;
    width:100vw;left:50%;right:50%;margin-left:-50vw;margin-right:-50vw;
  }
  .close__media{position:absolute;inset:0;background:url('/images/hero-people.webp') center 40%/cover no-repeat}
  .close__veil{position:absolute;inset:0;
    background:linear-gradient(120deg,rgba(173,44,77,.92) 0%,rgba(140,15,55,.9) 50%,rgba(109,20,55,.92) 100%)}
  .close__inner{position:relative;z-index:2;color:#fff;text-align:center;padding:92px 24px 100px;max-width:var(--max)}
  .pill--solid{margin-bottom:24px}
  .close__inner h2{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:clamp(34px,5.5vw,66px);line-height:.98;letter-spacing:-.03em;margin-bottom:18px}
  .close__inner p{font-size:clamp(17px,2.2vw,21px);color:rgba(255,255,255,.92);max-width:38em;margin:0 auto 30px;line-height:1.5}

  /* ---------------- RESPONSIVE ---------------- */
  @media(max-width:880px){
    .stage{padding:72px 0 90px}
    .stage-grid{grid-template-columns:1fr;gap:80px}
    .deck{min-height:420px;margin-top:8px}
    .grain{-webkit-mask-image:none;mask-image:none;opacity:.12}
    .tri{grid-template-columns:1fr}
    .facts{grid-template-columns:1fr 1fr;gap:36px}
  }
  @media(max-width:560px){
    .blk{padding:var(--sec-pad) 0}
    .card--back{transform:rotate(-2deg)}
    .card--mid{transform:rotate(1deg)}
    .card--front{transform:rotate(0)}
    .acts .bbtn{width:100%;justify-content:center}
  }
</style>
</Layout>
