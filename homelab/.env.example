# WorkforceAP homelab — copy to homelab/.env and fill in values.
# Never commit homelab/.env.

# --- Postgres (local Docker) ---
POSTGRES_USER=wap
POSTGRES_PASSWORD=change-me-use-openssl-rand-hex-16
POSTGRES_DB=workforceap

# Host port for the Next.js container (Caddy reverse-proxies to this)
WEB_PORT=3000

# Public URL (used in emails, redirects)
NEXT_PUBLIC_SITE_URL=https://workforceap.mikeslabs.com

# Database URLs are set automatically by docker-compose from POSTGRES_* above.
# Uncomment only if you use an external Postgres instead of the bundled db service:
# DATABASE_URL=postgresql://wap:password@db:5432/workforceap

# --- Supabase (required for portal/auth) ---
# Homelab typically uses the demo project; production keys if this is your only deploy.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Security (generate with: openssl rand -hex 32) ---
CRON_SECRET=
AUTH_TRUST_COOKIE_SECRET=
PLACEMENT_SURVEY_TOKEN_SECRET=
STAFF_MFA_ENFORCEMENT=0

# --- Optional integrations ---
RESEND_API_KEY=
EMAIL_FROM=noreply@workforceap.org
ONET_API_KEY=

# --- Deploy script ---
HOMELAB_GIT_BRANCH=master
