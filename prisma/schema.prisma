// One row per member enrollment per program. A user can have multiple
// CourseEnrollment rows (e.g., IT Support + Cybersecurity); exactly one is
// flagged `isPrimary = true` and is what /dashboard/training defaults to.
// `User.enrolledProgram` is a redundant pointer kept temporarily so xAPI
// crediting and a few admin views keep working — slated to deprecate once
// every consumer reads from CourseEnrollment + isPrimary directly.
model Course {
  id               String   @id @default(uuid())
