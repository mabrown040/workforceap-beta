---
import Layout from '../layouts/Layout.astro';
---
<Layout
  title="What We Do — Workforce Development Training & Industry Certificates"
  description="WorkforceAP is built on 25+ years of workforce development leadership. Employer-aligned training, career support, and funded pathways for qualifying members."
>
<!-- HERO -->
<section class="hero"><div class="wrap">
  <span class="eyebrow"><span class="dot"></span>Built on Decades of Workforce Experience</span>
  <h1>Creating <span class="grad-text">Opportunity</span></h1>
  <p class="sub">Employer-aligned training. No cost for qualifying members. Career support throughout the journey. A model that works — and scales.</p>
  <div class="cta">
    <a class="btn btn--primary" href="/programs">Explore Our Impact →</a>
    <a class="btn btn--ghost" href="/contact?topic=partnership">Partner With Us</a>
  </div>
  <div class="trustline">
    <span><b>25+ years</b> in workforce development</span><span class="sep"></span>
    <span><b>$0</b> for qualifying members</span><span class="sep"></span>
    <span><b>501(c)(3)</b> nonprofit, nationwide</span>
  </div>
</div></section>

<!-- FIND YOUR PATH -->
<div class="creds"><div class="wrap findpath">
  <p>Not sure where to start?</p>
  <div class="acts">
    <a class="btn btn--primary" href="/find-your-path">Find Your Path Quiz</a>
    <a class="btn btn--ghost" href="/apply">Check WIOA Options</a>
  </div>
</div></div>

<!-- LEGACY -->
<section class="band band--surface"><div class="wrap">
  <div class="legacy">
    <div class="legacy__media">
      <div class="legacy__img"></div>
      <div class="legacy__badge">
        <div class="k">25+</div>
        <div class="s">Years Experience</div>
      </div>
    </div>
    <div class="legacy__text">
      <h2>Investing in the Future <span class="grad-text">Workforce</span></h2>
      <blockquote>Built on 25+ years of workforce development leadership across Goodwill, Austin Area Urban League, and state and local initiatives. We know what works. Employers help shape talent pipelines. Grants and partnerships fund access. We don't charge members.</blockquote>
      <p>Some programs may align with <strong>WIOA (Workforce Innovation and Opportunity Act)</strong> eligibility guidelines criteria, including low-income individuals, dislocated workers, adult learners, and veterans seeking career advancement.</p>
      <div class="legacy__chip">
        <div class="k">Nonprofit &amp; 501(c)(3)</div>
        <div class="s">WorkforceAP is a national nonprofit and 501(c)(3) organization serving communities nationwide.</div>
      </div>
    </div>
  </div>
</div></section>

<!-- MAKING AN IMPACT — BENTO -->
<section class="band"><div class="wrap">
  <div class="sec-head">
    <span class="eyebrow">Our Values</span>
    <h2>Making an <span class="grad-text">impact</span></h2>
  </div>
  <div class="bento">
    <div class="tool big">
      <div class="ic ic--c">🎓</div>
      <h3>Employer-Influenced Curricula</h3>
      <p>Training programs shaped with employer input — Google, IBM, AWS, Microsoft, CompTIA — so credentials map to real hiring needs.</p>
      <div class="demo">
        <div class="line"><span class="chk">✓</span> Curriculum reviewed with employer partners</div>
        <div class="line"><span class="chk">✓</span> Credentials map to in-demand roles</div>
        <div class="line">IBM · Google · Microsoft · AWS · CompTIA</div>
      </div>
    </div>
    <div class="tool"><div class="ic ic--gr">🔓</div><h3>Zero-Barrier Access</h3><p>No cost for qualifying members. No prerequisites. Funding comes from WIOA, grants, employer partners, and community partnerships that can cover access for eligible participants.</p></div>
    <div class="tool"><div class="ic ic--b">📊</div><h3>Validated Outcomes</h3><p>Industry-recognized certificates. Skills assessments. Job placement support. We track member progress and career outcomes over time.</p></div>
    <div class="tool"><div class="ic ic--g">🗺️</div><h3>Regional Scalability</h3><p>A repeatable model built to serve communities nationwide — not just one local market.</p></div>
  </div>
</div></section>

<!-- VALUES -->
<section class="band band--surface"><div class="wrap">
  <div class="sec-head">
    <span class="eyebrow">Our Values</span>
    <h2>What guides <span class="grad-text">everything we do</span></h2>
  </div>
  <div class="steps" style="grid-template-columns:repeat(3,1fr)">
    <div class="stepcard"><div class="num">01</div><h3>Access as Foundation</h3><p>Fair access to opportunity. We work with community organizations, public partners, and employers so more people can reach training and careers.</p></div>
    <div class="stepcard"><div class="num">02</div><h3>Outcome Focus</h3><p>Every program, partnership, and investment is designed to expand opportunities, strengthen skills, and deliver meaningful life and career outcomes.</p></div>
    <div class="stepcard"><div class="num">03</div><h3>Key Partnerships</h3><p>Government, Employers, Non-profit &amp; Community Organizations, and Churches — we bring the right people together so members don't have to figure it out alone.</p></div>
  </div>
</div></section>

<!-- MISSION -->
<section class="band"><div class="wrap">
  <div class="sec-head">
    <span class="eyebrow">Our Mission</span>
    <h2>Built for scale. <span class="grad-text">Focused on people.</span></h2>
  </div>
  <div class="mission">
    <p>WorkforceAP is a 501(c)(3) nonprofit that equips individuals, nonprofits, counselors, and community advisors with workforce readiness tools, occupational training and professional certificates, and AI-powered resume, interview, and job placement assistance.</p>
    <p>We build lasting careers and better lives no cost for qualifying members — funded by WIOA, grants, employer partners, and community partnerships.</p>
  </div>
</div></section>

<!-- CTA -->
<section class="band"><div class="wrap"><div class="cta">
  <h2>Ready to build your future?</h2>
  <p>Join hundreds of members who've taken the first step toward a meaningful career. Our programs are offered no cost for qualifying members.</p>
  <div class="acts">
    <a class="btn btn--light" href="/apply">Apply Now →</a>
    <a class="btn btn--translucent" href="/programs">Browse Programs</a>
  </div>
</div></div></section>

<style>
  .hero{padding:72px 0 40px;text-align:center}
  .hero h1{margin:18px auto;max-width:14em}
  .hero .sub{margin:0 auto;max-width:34em}
  .hero .cta{justify-content:center}
  .hero .trustline{justify-content:center}

  .findpath{display:flex;align-items:center;justify-content:center;gap:24px;flex-wrap:wrap;padding:26px 24px}
  .findpath p{font-weight:700;font-size:18px;font-family:'Plus Jakarta Sans',sans-serif}
  .findpath .acts{display:flex;gap:14px;flex-wrap:wrap}

  .legacy{display:grid;grid-template-columns:.95fr 1.05fr;gap:48px;align-items:center}
  .legacy__media{position:relative}
  .legacy__img{aspect-ratio:4/3;border-radius:var(--radius);background:var(--grad);box-shadow:var(--shadow-lg);position:relative;overflow:hidden}
  .legacy__img::after{content:"";position:absolute;inset:0;background:url('https://www.workforceap.org/images/hero-people.webp') center/cover;opacity:.5;mix-blend-mode:luminosity}
  .legacy__badge{position:absolute;bottom:-18px;right:-12px;background:linear-gradient(135deg,var(--gold),var(--gold-dark));color:#fff;padding:16px 22px;border-radius:18px;box-shadow:0 16px 40px -10px rgba(164,127,56,.5);text-align:center}
  .legacy__badge .k{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:32px;line-height:1}
  .legacy__badge .s{font-size:12px;font-weight:600;opacity:.9;margin-top:2px}
  .legacy__text h2{font-size:clamp(28px,3.6vw,40px);font-weight:800;margin-bottom:18px}
  .legacy__text blockquote{font-size:18px;color:var(--text);border-left:3px solid var(--crimson);padding-left:18px;margin:0 0 18px;font-style:italic}
  .legacy__text p{color:var(--muted);font-size:15px;margin-bottom:18px}
  .legacy__chip{background:var(--surface-2);border:1px solid var(--border);border-radius:16px;padding:18px 20px}
  .legacy__chip .k{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:17px;color:var(--crimson)}
  .legacy__chip .s{color:var(--muted);font-size:14px;margin-top:4px}
  @media(max-width:880px){.legacy{grid-template-columns:1fr;gap:40px}.legacy__badge{right:12px}}

  .mission{max-width:760px;margin:0 auto;display:flex;flex-direction:column;gap:18px;text-align:center}
  .mission p{font-size:19px;color:var(--muted)}
  .mission p:first-child{color:var(--text)}

  @media(max-width:880px){.steps[style]{grid-template-columns:1fr !important}}
</style>
</Layout>
