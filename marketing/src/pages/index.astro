---
import Layout from '../layouts/Layout.astro';
import { PROGRAMS } from '../data/programs';
import { heroPhotoSequenceForKey } from '../../../lib/marketing/heroPhotos';
const [heroPhoto, , closingPhoto] = heroPhotoSequenceForKey('/', 3);
const featuredSlugs = [
  'it-support-professional-certificate-ibm',
  'project-management-professional-certificate-microsoft',
  'health-information-technology-mchit',
  'ai-practitioner-professional-certificate-aws',
];
const featured = featuredSlugs.map(slug => PROGRAMS.find(program => program.slug === slug)!).filter(Boolean);
---
<Layout title="WorkforceAP — Career training. A plan to move forward." description="Explore nonprofit career training, compare real program requirements, and build a practical career action plan. No cost to members who qualify through scholarship/grant funded membership.">
  <Fragment slot="head"><link rel="preload" as="image" href={heroPhoto} fetchpriority="high" /></Fragment>
  <div class="career-home">
    <section class="launch-hero" aria-labelledby="launch-title">
      <img class="launch-photo" src={heroPhoto} alt="" width="1600" height="1067" fetchpriority="high" />
      <div class="launch-veil" aria-hidden="true"></div>
      <div class="wrap launch-composition">
        <p class="launch-brand">Empowering People. Advancing Futures.</p>
        <h1 id="launch-title">Your next chapter.<br /><span>A stronger career.</span></h1>
        <p class="launch-copy">Build skills, earn a professional certificate, and take your next step with career support behind you.</p>
        <div class="launch-actions">
          <a class="btn btn--light" href="/find-your-path">Find your career path <span aria-hidden="true">→</span></a>
          <a class="launch-secondary" href="/apply">Ready to apply? Start here <span aria-hidden="true">↗</span></a>
        </div>
        <p class="launch-funding">No cost to members who qualify through scholarship/grant funded membership.</p>
        <p class="launch-signature">Workforce Advancement Project <span>501(c)(3) nonprofit</span></p>
      </div>
    </section>

    <nav class="start-strip" aria-label="Choose your next step">
      <div class="wrap start-options">
        <a href="/find-your-path"><span>I'm exploring</span><strong>Build my career plan <span aria-hidden="true">↗</span></strong></a>
        <a href="/programs"><span>I know my direction</span><strong>Explore {PROGRAMS.length} programs <span aria-hidden="true">↗</span></strong></a>
        <a href="/contact"><span>I could use guidance</span><strong>Talk with the team <span aria-hidden="true">↗</span></strong></a>
      </div>
    </nav>

    <section class="home-section" aria-labelledby="pathways-title">
      <div class="wrap">
        <div class="section-heading">
          <div><p class="section-kicker">Start with a skill. Build toward a career.</p><h2 id="pathways-title">Find work you<br />want to grow into.</h2></div>
          <p>Look inside the training before you decide. Explore the skills, course hours, and requirements for each path.</p>
        </div>
        <div class="pathways">
          {featured.map((program, index) => (
            <a class="pathway" href={`/programs/${program.slug}`}>
              <span class="pathway-number" aria-hidden="true">0{index + 1}</span>
              <div class="pathway-main"><p class="pathway-category">{program.categoryLabel}</p><h3>{program.title}</h3><p class="pathway-skills">{program.skills.slice(0, 3).join(' · ')}</p></div>
              <span class="pathway-hours">{program.syllabus?.totalHours} curriculum hours</span>
              <span class="pathway-arrow" aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
        <div class="section-bottom"><a class="text-link" href="/programs">Browse all {PROGRAMS.length} programs <span aria-hidden="true">→</span></a><a class="text-link" href="/programs/digital-literacy-empowerment-class">New to computers? Start with digital skills <span aria-hidden="true">→</span></a></div>
      </div>
    </section>

    <section class="plan-section home-section" aria-labelledby="plan-title">
      <div class="wrap plan-layout">
        <div class="plan-intro"><p class="section-kicker">Something useful, right now</p><h2 id="plan-title">Leave with a plan.<br /><span>Start with one step.</span></h2><p>Answer three questions to explore programs, then build a four-week preparation plan around your direction and study time.</p><p>Save your checklist on this device or take a copy with you. No account or email needed.</p><a class="btn btn--primary" href="/find-your-path">Build my career plan <span aria-hidden="true">→</span></a></div>
        <div class="plan-preview" aria-label="What your career preparation plan includes">
          <p class="plan-preview-label">Your next four weeks</p>
          <ol>
            <li><span class="plan-week">01</span><div><h3>Choose a direction</h3><p>Explore a program and the work it can prepare you for.</p></div></li>
            <li><span class="plan-week">02</span><div><h3>Make room to learn</h3><p>Check the study hours and plan time around your life.</p></div></li>
            <li><span class="plan-week">03</span><div><h3>Build your career story</h3><p>Identify skills and experience you can already bring.</p></div></li>
            <li><span class="plan-week">04</span><div><h3>Prepare your next move</h3><p>Bring your questions to the team and decide whether to apply.</p></div></li>
          </ol>
          <p class="plan-preview-note">A preparation plan, not a four-week certification or job guarantee.</p>
        </div>
      </div>
    </section>

    <section class="home-section" aria-labelledby="support-title">
      <div class="wrap support-layout">
        <div><p class="section-kicker">Training is part of the journey</p><h2 id="support-title">Skills. Credentials.<br />A team behind you.</h2><p class="support-copy">Workforce Advancement Project equips people and communities with workforce readiness tools, occupational training, professional certificates, and career support to help build lasting careers and a better life.</p><a class="text-link" href="/what-we-do">Meet WorkforceAP <span aria-hidden="true">→</span></a></div>
        <dl class="support-list">
          <div><dt>Understand your options</dt><dd>Explore program fit and scholarship or grant eligibility before you commit.</dd></div>
          <div><dt>Prepare for the work</dt><dd>Occupational training and professional certificates, with program-specific requirements you can review.</dd></div>
          <div><dt>Tell your story with confidence</dt><dd>Resume, interview, and career guidance as you work toward your next role.</dd></div>
        </dl>
      </div>
    </section>

    <section class="evidence-section home-section" aria-labelledby="evidence-title">
      <div class="wrap evidence-layout">
        <div><p class="section-kicker">Progress deserves proof</p><h2 id="evidence-title">Big purpose.<br />Clear evidence.</h2></div>
        <div><p>You deserve to know what a program offers and what its results actually show. Our public impact page explains what is available and what has not been published yet.</p><div class="evidence-links"><a class="text-link" href="/impact">Explore our impact and evidence <span aria-hidden="true">→</span></a><a class="text-link" href="/salary-guide">Research careers and pay <span aria-hidden="true">→</span></a></div></div>
      </div>
    </section>

    <section class="home-section" aria-labelledby="community-title">
      <div class="wrap"><p class="section-kicker">Make the next chapter possible</p><h2 id="community-title">Opportunity grows<br />when we work together.</h2>
        <div class="community-links">
          <a href="/partners"><h3>Community partners <span aria-hidden="true">↗</span></h3><p>Connect your community to training and career support.</p></a>
          <a href="/employers"><h3>Employers <span aria-hidden="true">↗</span></h3><p>Explore a pipeline of candidates building relevant skills.</p></a>
          <a href="/donate"><h3>Support the mission <span aria-hidden="true">↗</span></h3><p>Help expand access to career opportunities.</p></a>
        </div>
      </div>
    </section>

    <section class="closing-section" aria-labelledby="closing-title">
      <img src={closingPhoto} alt="" width="1600" height="1067" loading="lazy" />
      <div class="closing-veil" aria-hidden="true"></div>
      <div class="wrap closing-copy"><p class="launch-brand">Empowering People. Advancing Futures.</p><h2 id="closing-title">You don't have to figure<br />it all out alone.</h2><p>A real team reviews applications and follows up in 1–2 business days.</p><a class="btn btn--light" href="/apply">Start your application <span aria-hidden="true">→</span></a><a class="closing-contact" href="/contact">Talk with us first</a></div>
    </section>
  </div>
</Layout>

<style>
  .career-home a:focus-visible{outline:3px solid var(--gold);outline-offset:5px}
  .launch-hero{position:relative;isolation:isolate;overflow:hidden;background:var(--plum);color:var(--surface)}
  .launch-photo,.launch-veil{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 38%;z-index:-2}
  .launch-veil{z-index:-1;background:linear-gradient(90deg,color-mix(in srgb,var(--plum) 98%,transparent) 5%,color-mix(in srgb,var(--accent-dark) 92%,transparent) 40%,color-mix(in srgb,var(--plum) 35%,transparent) 100%)}
  .launch-composition{padding-top:64px;padding-bottom:40px}
  .launch-brand{font-size:13px;font-weight:700;letter-spacing:.07em;margin-bottom:22px}
  .launch-hero h1{font-size:clamp(44px,5.7vw,76px);line-height:1.04;letter-spacing:-.045em;max-width:800px}
  .launch-hero h1 span{color:var(--surface)}
  .launch-copy{font-size:20px;line-height:1.55;max-width:32rem;margin:24px 0}
  .launch-actions{display:flex;align-items:center;gap:24px;flex-wrap:wrap}
  .launch-actions .btn{min-height:52px}
  .launch-secondary{font-size:16px;font-weight:700;display:inline-flex;gap:8px;align-items:center;min-height:48px;text-decoration:underline;text-underline-offset:5px}
  .launch-funding{font-size:14px;max-width:31rem;margin-top:20px;line-height:1.5}
  .launch-signature{display:flex;gap:20px;flex-wrap:wrap;font-size:13px;margin-top:38px;font-weight:600}
  .launch-signature span{border-left:1px solid currentColor;padding-left:20px}
  .start-strip{background:var(--surface);border-bottom:1px solid var(--border)}
  .start-options{display:grid;grid-template-columns:repeat(3,1fr)}
  .start-options>a{padding:24px 28px;border-right:1px solid var(--border);display:flex;flex-direction:column;gap:4px;min-width:0}
  .start-options>a:first-child{padding-left:0}.start-options>a:last-child{border:0}
  .start-options a>span{font-size:14px;color:var(--muted)}.start-options strong{font-size:17px;color:var(--crimson)}
  .start-options a:hover strong,.text-link:hover{text-decoration:underline;text-underline-offset:4px}
  .home-section{padding:80px 0}.section-kicker{font-weight:700;font-size:13px;letter-spacing:.06em;text-transform:uppercase;color:var(--crimson);margin-bottom:18px}
  .home-section h2{font-size:clamp(30px,3.7vw,48px);line-height:1.12;letter-spacing:-.035em}
  .section-heading{display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:end;margin-bottom:36px}
  .section-heading>p{font-size:18px;line-height:1.65;color:var(--muted);max-width:31rem}
  .pathway{display:grid;grid-template-columns:40px 1fr 160px 32px;gap:24px;align-items:center;padding:26px 0;border-top:1px solid var(--border)}
  .pathway:last-child{border-bottom:1px solid var(--border)}.pathway:hover h3{color:var(--crimson);text-decoration:underline;text-underline-offset:4px}
  .pathway-number{font-size:14px;font-weight:700;color:var(--muted)}.pathway-category{color:var(--crimson);font-size:13px;font-weight:700;margin-bottom:5px}
  .pathway h3{font-size:22px;line-height:1.25;max-width:38rem}.pathway-skills{font-size:16px;color:var(--muted);margin-top:8px}
  .pathway-hours{font-size:14px;color:var(--muted)}.pathway-arrow{font-size:25px;color:var(--crimson)}
  .section-bottom{display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;margin-top:24px}.text-link{color:var(--crimson);font-size:16px;font-weight:700;display:inline-flex;gap:8px;align-items:center;min-height:44px}
  .plan-section{background:var(--surface)}.plan-layout{display:grid;grid-template-columns:1fr 1fr;gap:72px;align-items:center}.plan-intro h2 span{color:var(--crimson)}
  .plan-intro>p:not(.section-kicker){font-size:18px;color:var(--muted);margin-top:24px;max-width:29rem}.plan-intro>.btn{margin-top:28px}
  .plan-preview{background:var(--bg);border:1px solid var(--border);padding:32px;border-radius:var(--radius)}.plan-preview-label{font-size:13px;text-transform:uppercase;letter-spacing:.08em;color:var(--crimson);font-weight:700}
  .plan-preview ol{list-style:none;margin:16px 0}.plan-preview li{display:flex;align-items:start;gap:18px;padding:20px 0;border-bottom:1px solid var(--border)}.plan-preview li:last-child{border:0}
  .plan-week{font-weight:700;color:var(--crimson);font-size:14px;padding-top:2px}.plan-preview h3{font-size:19px;line-height:1.3;margin-bottom:6px}.plan-preview li p{font-size:16px;color:var(--muted)}.plan-preview-note{font-size:13px;color:var(--muted)}
  .support-layout{display:grid;grid-template-columns:1fr 1fr;gap:72px}.support-copy{margin:24px 0 12px;color:var(--muted);font-size:18px;max-width:31rem}.support-list>div{padding:24px 0;border-top:1px solid var(--border)}.support-list dt{font-family:'Plus Jakarta Sans',sans-serif;font-size:20px;font-weight:700}.support-list dd{font-size:17px;color:var(--muted);margin-top:8px}
  .evidence-section{background:var(--surface);border-block:1px solid var(--border)}.evidence-layout{display:grid;grid-template-columns:1fr 1fr;gap:72px;align-items:center}.evidence-layout>div>p:not(.section-kicker){font-size:19px;color:var(--muted)}.evidence-links{display:flex;flex-direction:column;align-items:start;margin-top:22px;gap:8px}
  .community-links{display:grid;grid-template-columns:repeat(3,1fr);gap:32px;margin-top:36px}.community-links>a{min-height:44px;padding-top:22px;border-top:2px solid var(--crimson)}.community-links h3{font-size:21px;line-height:1.3;display:flex;justify-content:space-between;gap:16px}.community-links p{font-size:16px;color:var(--muted);margin-top:12px}.community-links a:hover h3{color:var(--crimson)}
  .closing-section{position:relative;isolation:isolate;color:var(--surface);background:var(--plum);overflow:hidden}.closing-section>img,.closing-veil{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 40%;z-index:-2}.closing-veil{z-index:-1;background:linear-gradient(90deg,color-mix(in srgb,var(--plum) 97%,transparent),color-mix(in srgb,var(--crimson) 86%,transparent) 55%,color-mix(in srgb,var(--plum) 50%,transparent))}.closing-copy{padding-top:72px;padding-bottom:72px}.closing-copy h2{font-size:clamp(32px,4vw,52px);line-height:1.1}.closing-copy>p:not(.launch-brand){font-size:18px;margin:24px 0;max-width:30rem}.closing-contact{margin-left:24px;text-decoration:underline;text-underline-offset:5px;display:inline-flex;align-items:center;min-height:48px;font-weight:700}
  @media(max-width:880px){.launch-veil{background:linear-gradient(90deg,color-mix(in srgb,var(--plum) 96%,transparent),color-mix(in srgb,var(--accent-dark) 84%,transparent))}.launch-composition{padding-top:44px}.section-heading,.plan-layout,.support-layout,.evidence-layout{gap:32px}.pathway{grid-template-columns:24px 1fr 120px 24px;gap:14px}.start-options>a{padding:20px 16px}.start-options strong{font-size:15px}.community-links{gap:20px}.home-section{padding:60px 0}}
  @media(max-width:600px){.launch-composition{padding-top:32px;padding-bottom:28px}.launch-brand{font-size:12px;letter-spacing:.02em;margin-bottom:18px}.launch-hero h1{font-size:clamp(39px,10.5vw,56px)}.launch-copy{font-size:17px;margin:20px 0}.launch-actions{gap:6px;align-items:stretch;flex-direction:column}.launch-actions .btn{justify-content:center}.launch-secondary{justify-content:center}.launch-funding{font-size:13px;margin-top:12px}.launch-signature{margin-top:22px;gap:4px;flex-direction:column;font-size:12px}.launch-signature span{border:0;padding:0}.start-options{grid-template-columns:1fr}.start-options>a,.start-options>a:first-child{padding:16px 0;border:0;border-bottom:1px solid var(--border);flex-direction:row;justify-content:space-between;align-items:center;gap:20px}.start-options a>span{font-size:13px;max-width:7rem}.start-options strong{font-size:14px;text-align:right}.home-section{padding:48px 0}.section-heading,.plan-layout,.support-layout,.evidence-layout{grid-template-columns:1fr;gap:24px}.section-heading{margin-bottom:26px}.section-heading>p,.plan-intro>p:not(.section-kicker),.support-copy,.evidence-layout>div>p:not(.section-kicker){font-size:17px}.pathway{grid-template-columns:1fr 24px;gap:8px;padding:22px 0}.pathway-number{display:none}.pathway-main{grid-column:1;grid-row:1}.pathway h3{font-size:20px}.pathway-hours{grid-column:1;grid-row:2}.pathway-arrow{grid-column:2;grid-row:1 / 3}.pathway-skills{font-size:15px}.section-bottom{gap:8px}.plan-preview{padding:24px}.community-links{grid-template-columns:1fr;gap:28px}.community-links>a{padding-top:20px}.closing-copy{padding-top:48px;padding-bottom:48px}.closing-contact{margin-left:0;margin-top:8px;display:flex;width:fit-content}.closing-copy>p:not(.launch-brand){font-size:17px}.plan-intro>.btn{width:100%;justify-content:center}}
  @media(prefers-reduced-motion:reduce){.career-home .btn{transition:none}.career-home .btn:hover{transform:none}}
</style>
