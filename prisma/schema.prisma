  @@index([email])
  @@index([token])
  @@index([status])
  @@index([invitedById])
  @@index([expiresAt])
  @@map("invitations")
}

// --- Employer Portal & Job Management ---

model Employer {
  id                    String    @id @default(uuid())
  organizationId        String    @map("organization_id")
  userId                String    @unique @map("user_id")
  tier                  String    @default("basic") @map("tier")
  companyName           String    @map("company_name")
  companyWebsite        String?   @map("company_website")
  companyDescription    String?   @map("company_description")
  companySize           String?   @map("company_size")
  industry              String?   @map("industry")
  logoUrl               String?   @map("logo_url")
  contactName           String    @map("contact_name")
  contactEmail          String    @map("contact_email")
  contactPhone          String?   @map("contact_phone")
  status                String    @default("active") // active, inactive
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  onboardingCompletedAt DateTime? @map("onboarding_completed_at")
  tourCompletedAt       DateTime? @map("tour_completed_at")

