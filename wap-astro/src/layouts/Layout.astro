---
import '../styles/blend.css';
export interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'WorkforceAP — Employer-aligned training & career support',
  description = 'WorkforceAP is a 501(c)(3) nonprofit providing employer-aligned training, professional certificates, and career support at no cost to qualifying members.',
} = Astro.props;

const nav = [
  { href: '/programs', label: 'Programs' },
  { href: '/how-it-works', label: 'How it works' },
  { href: '/employers', label: 'For employers' },
  { href: '/partners', label: 'Partners' },
];
const path = Astro.url.pathname;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet" />
</head>
<body>
  <nav class="top"><div class="wrap row">
    <a class="brand" href="/"><span class="mark">▲</span>Workforce<b>AP</b></a>
    <div class="navlinks">
      {nav.map((n) => <a href={n.href} aria-current={path === n.href ? 'page' : undefined}>{n.label}</a>)}
    </div>
    <div class="navactions">
      <a class="signin" href="/login" style="color:var(--muted);font-weight:600;font-size:15px">Sign in</a>
      <a class="btn btn--primary" style="padding:10px 20px;font-size:15px" href="/apply">Apply now</a>
    </div>
  </div></nav>

  <main>
    <slot />
  </main>

  <footer><div class="wrap">
    <div class="fgrid">
      <div class="fbrand">
        <a class="brand" href="/"><span class="mark">▲</span>Workforce<b>AP</b></a>
        <p>A 501(c)(3) nonprofit providing employer-aligned training, professional certificates, and career support at no cost to qualifying members.</p>
      </div>
      <div><h4>Explore</h4><ul><li><a href="/programs">Programs</a></li><li><a href="/how-it-works">How it works</a></li><li><a href="/find-your-path">Find your path</a></li><li><a href="/outcomes">Outcomes</a></li></ul></div>
      <div><h4>Get involved</h4><ul><li><a href="/apply">Apply</a></li><li><a href="/employers">For employers</a></li><li><a href="/partners">Partners</a></li><li><a href="/donate">Donate</a></li></ul></div>
      <div><h4>Organization</h4><ul><li><a href="/about">About</a></li><li><a href="/leadership">Leadership</a></li><li><a href="/careers">Careers</a></li><li><a href="/contact">Contact</a></li></ul></div>
    </div>
    <div class="fbottom">
      <span>© 2026 WorkforceAP · A national 501(c)(3) nonprofit. Available nationwide.</span>
      <span style="display:flex;gap:18px"><a href="/privacy" style="color:inherit">Privacy</a><a href="/terms" style="color:inherit">Terms</a><a href="/accessibility" style="color:inherit">Accessibility</a></span>
    </div>
  </div></footer>
</body>
</html>
