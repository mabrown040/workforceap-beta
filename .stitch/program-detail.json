  "htmlContent": "<!DOCTYPE html>\n\n<html lang=\"en\"><head>\n<meta charset=\"utf-8\"/>\n<meta content=\"width=device-width, initial-scale=1.0\" name=\"viewport\"/>\n<title>Cybersecurity Professional | WorkforceAP</title>\n<script src=\"https://cdn.tailwindcss.com?plugins=forms,container-queries\"></script>\n<link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@100..900&amp;display=swap\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/>\n<script id=\"tailwind-config\">\n      tailwind.config = {\n        darkMode: \"class\",\n        theme: {\n          extend: {\n            colors: {\n              \"inverse-primary\": \"#ffb2bc\",\n              \"secondary-container\": \"#e5e2e1\",\n              \"on-error-container\": \"#93000a\",\n              \"surface-container-high\": \"#ebe7e7\",\n              \"on-tertiary-fixed-variant\": \"#643f00\",\n              \"on-primary-container\": \"#ffcbd1\",\n              \"on-primary\": \"#ffffff\",\n              \"on-tertiary\": \"#ffffff\",\n              \"surface-variant\": \"#e5e2e1\",\n              \"secondary-fixed-dim\": \"#c8c6c5\",\n              \"on-error\": \"#ffffff\",\n              \"on-surface\": \"#1c1b1b\",\n              \"error\": \"#ba1a1a\",\n              \"inverse-surface\": \"#313030\",\n              \"on-secondary-fixed\": \"#1c1b1b\",\n              \"on-secondary-container\": \"#656464\",\n              \"on-secondary\": \"#ffffff\",\n              \"secondary\": \"#5f5e5e\",\n              \"primary-fixed\": \"#ffd9dd\",\n              \"background\": \"#fcf9f8\",\n              \"primary-container\": \"#ad2c4d\",\n              \"inverse-on-surface\": \"#f3f0ef\",\n              \"tertiary\": \"#643f00\",\n              \"tertiary-container\": \"#82550a\",\n              \"on-secondary-fixed-variant\": \"#474646\",\n              \"error-container\": \"#ffdad6\",\n              \"secondary-fixed\": \"#e5e2e1\",\n              \"on-primary-fixed-variant\": \"#8c0f37\",\n              \"on-tertiary-fixed\": \"#2a1800\",\n              \"surface-bright\": \"#fcf9f8\",\n              \"tertiary-fixed\": \"#ffddb5\",\n              \"on-surface-variant\": \"#584144\",\n              \"outline-variant\": \"#debfc2\",\n              \"primary\": \"#8c0f37\",\n              \"surface-container-lowest\": \"#ffffff\",\n              \"outline\": \"#8b7073\",\n              \"on-primary-fixed\": \"#400013\",\n              \"surface-dim\": \"#dcd9d9\",\n              \"surface-container-low\": \"#f6f3f2\",\n              \"surface-container-highest\": \"#e5e2e1\",\n              \"on-background\": \"#1c1b1b\",\n              \"surface-container\": \"#f0edec\",\n              \"primary-fixed-dim\": \"#ffb2bc\",\n              \"on-tertiary-container\": \"#ffd197\",\n              \"tertiary-fixed-dim\": \"#f8bb6b\",\n              \"surface-tint\": \"#ad2c4d\",\n              \"surface\": \"#fcf9f8\"\n            },\n            fontFamily: {\n              \"headline\": [\"Inter\"],\n              \"body\": [\"Inter\"],\n              \"label\": [\"Inter\"]\n            },\n            borderRadius: {\"DEFAULT\": \"0.25rem\", \"lg\": \"0.5rem\", \"xl\": \"0.75rem\", \"full\": \"9999px\"},\n          },\n        },\n      }\n    </script>\n<style>\n        .material-symbols-outlined {\n            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;\n        }\n        body { font-family: 'Inter', sans-serif; }\n    </style>\n</head>\n<body class=\"bg-background text-on-surface antialiased\">\n<!-- Top Navigation Bar -->\n<nav class=\"fixed top-0 w-full z-50 bg-white/80 dark:bg-zinc-950/80 backdrop-blur-md shadow-[0_20px_40px_rgba(28,27,27,0.06)]\">\n<div class=\"flex justify-between items-center px-8 h-20 max-w-screen-2xl mx-auto w-full\">\n<div class=\"text-2xl font-black tracking-tighter text-[#1c1b1b] dark:text-white\">WorkforceAP</div>\n<div class=\"hidden md:flex items-center space-x-8 font-['Inter'] antialiased text-sm font-medium tracking-tight\">\n<a class=\"text-[#8c0f37] dark:text-[#ad2c4d] font-bold border-b-2 border-[#8c0f37] pb-1\" href=\"#\">Programs</a>\n<a class=\"text-[#1c1b1b] dark:text-zinc-400 hover:text-[#8c0f37] transition-colors\" href=\"#\">Partners</a>\n<a class=\"text-[#1c1b1b] dark:text-zinc-400 hover:text-[#8c0f37] transition-colors\" href=\"#\">Career Hub</a>\n<a class=\"text-[#1c1b1b] dark:text-zinc-400 hover:text-[#8c0f37] transition-colors\" href=\"#\">About</a>\n</div>\n<div class=\"flex items-center space-x-4\">\n<button class=\"px-5 py-2 text-[#1c1b1b] text-sm font-semibold hover:bg-zinc-100 transition-all active:scale-95\">Login</button>\n<button class=\"px-6 py-2.5 bg-gradient-to-br from-[#8c0f37] to-[#ad2c4d] text-white rounded-lg text-sm font-bold shadow-lg hover:opacity-90 transition-all active:scale-95\">Enroll Now</button>\n</div>\n</div>\n</nav>\n<main class=\"pt-20\">\n<!-- Hero Header -->\n<section class=\"relative overflow-hidden py-24 md:py-32 bg-surface\">\n<div class=\"max-w-screen-2xl mx-auto px-8 grid grid-cols-1 lg:grid-cols-12 gap-12 items-center\">\n<div class=\"lg:col-span-7 space-y-8\">\n<div class=\"inline-flex items-center px-3 py-1 bg-tertiary-fixed text-on-tertiary-fixed rounded-full text-xs font-bold tracking-widest uppercase\">\n<span class=\"material-symbols-outlined text-sm mr-1\" style=\"font-variation-settings: 'FILL' 1;\">verified</span>\n                        ELITE PARTNER: IBM\n                    </div>\n<h1 class=\"text-6xl md:text-8xl font-black tracking-tighter text-on-surface leading-[0.9]\">\n                        Cybersecurity <br/> Professional\n                    </h1>\n<p class=\"text-xl text-secondary max-w-2xl leading-relaxed\">\n                        Master the art of digital defense. Transition into a high-stakes, high-reward career with elite training verified by global security leaders.\n                    </p>\n<div class=\"flex flex-wrap gap-6 py-4\">\n<div class=\"flex flex-col\">\n<span class=\"text-xs uppercase tracking-widest text-outline font-bold\">Duration</span>\n<span class=\"text-lg font-bold\">6 Months</span>\n</div>\n<div class=\"w-px h-10 bg-outline-variant/30 hidden md:block\"></div>\n<div class=\"flex flex-col\">\n<span class=\"text-xs uppercase tracking-widest text-outline font-bold\">Cost</span>\n<span class=\"text-lg font-bold text-primary\">$0 Tuition</span>\n</div>\n<div class=\"w-px h-10 bg-outline-variant/30 hidden md:block\"></div>\n<div class=\"flex flex-col\">\n<span class=\"text-xs uppercase tracking-widest text-outline font-bold\">Commitment</span>\n<span class=\"text-lg font-bold\">15-20 Hours/Week</span>\n</div>\n</div>\n<div class=\"flex flex-col sm:flex-row items-center gap-6\">\n<button class=\"w-full sm:w-auto px-10 py-4 bg-gradient-to-br from-[#8c0f37] to-[#ad2c4d] text-white rounded-lg font-bold text-lg shadow-xl hover:shadow-primary/20 transition-all active:scale-95\">\n                            Enroll Now\n                        </button>\n<a class=\"flex items-center text-primary font-bold hover:underline transition-all\" href=\"#\">\n                            Download Syllabus\n                            <span class=\"material-symbols-outlined ml-2\">download</span>\n</a>\n</div>\n</div>\n<div class=\"lg:col-span-5 relative group\">\n<div class=\"absolute inset-0 bg-primary-container/10 blur-3xl rounded-full scale-110 group-hover:scale-125 transition-transform duration-700\"></div>\n<div class=\"relative rounded-[2rem] overflow-hidden shadow-2xl aspect-[4/5] bg-surface-container-high\">\n<img alt=\"Cybersecurity Command Center\" class=\"w-full h-full object-cover\" data-alt=\"abstract dark blue high-tech interface with glowing digital security data and glowing server room reflections in professional style\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuAUBfEt44C48w9hioF_CzkAUYxZodqLwu7Sgb489hk0tA8Ji2zmy24V37EP3xKXpHMuvCUDIfBw-PZwE_kcxYNNOcIwK-A9aC0qAjZe1OBpXB7cb8bmPAP3t35TQpEWKxehA5fh2JMTupBJz2dYKp-4uwxOd4N7x2IACsYpw7ZO5p5vFlpWOEmL0_zOJijoj3WjARmRZBL9kjyF71uw5LdjfMCBLGJIrVAsDBoAHjYcgR-i3NS0pgv4tYmk_MKEi8xUPR1PcaTAHA\"/>\n<div class=\"absolute inset-0 bg-gradient-to-t from-primary/40 to-transparent\"></div>\n</div>\n</div>\n</div>\n</section>\n<!-- Program Overview -->\n<section class=\"py-24 bg-surface-container-low\">\n<div class=\"max-w-screen-xl mx-auto px-8\">\n<div class=\"grid grid-cols-1 md:grid-cols-2 gap-16 items-start\">\n<div class=\"space-y-6\">\n<div class=\"inline-block px-4 py-2 bg-surface-container-highest rounded-lg text-primary font-bold text-sm\">\n                            The Advancement Foundry Seal\n                        </div>\n<h2 class=\"text-4xl font-bold tracking-tight\">The Definitive Path to Digital Sovereignty</h2>\n<p class=\"text-lg leading-relaxed text-secondary\">\n                            In an era of escalating cyber warfare, businesses are desperate for defenders. The WorkforceAP Cybersecurity Professional certification isn't just a course; it's a career transformation engine. Designed alongside industry architects, we bridge the gap between academic theory and the front lines of security operations.\n                        </p>\n</div>\n<div class=\"p-8 bg-surface-container-lowest rounded-[2rem] shadow-sm flex flex-col justify-center border border-outline-variant/10\">\n<div class=\"flex items-center space-x-4 mb-6\">\n<span class=\"material-symbols-outlined text-4xl text-primary\" data-weight=\"fill\">verified_user</span>\n<span class=\"font-black text-xl tracking-tighter uppercase italic\">Institutional Quality</span>\n</div>\n<p class=\"italic text-on-surface-variant leading-relaxed\">\n                            \"WorkforceAP graduates don't just understand security concepts; they possess the muscle memory to react to real-time threats. This program sets the benchmark for enterprise-ready talent.\"\n                        </p>\n<div class=\"mt-6 font-bold text-on-surface\">— Dr. Marcus Vane, Lead Security Architect</div>\n</div>\n</div>\n</div>\n</section>\n<!-- What You'll Learn (Bento Grid) -->\n<section class=\"py-24 bg-surface\">\n<div class=\"max-w-screen-2xl mx-auto px-8\">\n<div class=\"flex flex-col md:flex-row justify-between items-end mb-16 gap-4\">\n<div class=\"max-w-xl\">\n<h2 class=\"text-5xl font-black tracking-tight mb-4\">Core Competencies</h2>\n<p class=\"text-secondary\">Master the six pillars of modern security operations through immersive lab environments.</p>\n</div>\n<div class=\"text-right\">\n<span class=\"text-primary font-bold text-sm tracking-widest uppercase\">Expert Led Curriculum</span>\n</div>\n</div>\n<div class=\"grid grid-cols-1 md:grid-cols-3 gap-6\">\n<!-- Bento Item 1 -->\n<div class=\"md:col-span-2 p-10 bg-surface-container-low rounded-[2rem] hover:bg-surface-container-high transition-colors group\">\n<span class=\"material-symbols-outlined text-primary text-5xl mb-6\">lan</span>\n<h3 class=\"text-3xl font-bold mb-4\">Network Security &amp; Defense</h3>\n<p class=\"text-secondary text-lg\">Architect resilient perimeters using firewalls, IDS/IPS, and zero-trust frameworks to neutralize lateral movement.</p>\n</div>\n<!-- Bento Item 2 -->\n<div class=\"p-10 bg-primary text-on-primary rounded-[2rem] flex flex-col justify-between overflow-hidden relative group\">\n<div class=\"relative z-10\">\n<span class=\"material-symbols-outlined text-on-primary text-5xl mb-6\">security</span>\n<h3 class=\"text-2xl font-bold mb-2\">Ethical Hacking</h3>\n<p class=\"text-on-primary/80\">Think like the adversary to identify and patch vulnerabilities.</p>\n</div>\n<div class=\"absolute -bottom-10 -right-10 opacity-10 group-hover:scale-110 transition-transform duration-500\">\n<span class=\"material-symbols-outlined text-[200px]\" data-weight=\"fill\">lock_open</span>\n</div>\n</div>\n<!-- Bento Item 3 -->\n<div class=\"p-10 bg-surface-container-low rounded-[2rem] hover:bg-surface-container-high transition-colors\">\n<span class=\"material-symbols-outlined text-primary text-5xl mb-6\">cloud_done</span>\n<h3 class=\"text-2xl font-bold mb-2\">Cloud Security</h3>\n<p class=\"text-secondary\">Securing AWS and Azure workloads against misconfigurations.</p>\n</div>\n<!-- Bento Item 4 -->\n<div class=\"p-10 bg-surface-container-low rounded-[2rem] hover:bg-surface-container-high transition-colors\">\n<span class=\"material-symbols-outlined text-primary text-5xl mb-6\">radar</span>\n<h3 class=\"text-2xl font-bold mb-2\">Threat Analysis</h3>\n<p class=\"text-secondary\">Utilizing SIEM/SOAR platforms for rapid incident response.</p>\n</div>\n<!-- Bento Item 5 -->\n<div class=\"p-10 bg-tertiary-fixed text-on-tertiary-fixed rounded-[2rem] flex flex-col justify-center\">\n<h4 class=\"text-4xl font-black mb-2\">80+</h4>\n<p class=\"font-bold\">Live Virtual Labs</p>\n</div>\n</div>\n</div>\n</section>\n<!-- Curriculum Breakdown -->\n<section class=\"py-24 bg-surface-container-low\">\n<div class=\"max-w-screen-lg mx-auto px-8\">\n<h2 class=\"text-4xl font-bold text-center mb-16\">The Journey to Mastery</h2>\n<div class=\"space-y-4\">\n<!-- Module 1 -->\n<div class=\"bg-surface-container-lowest rounded-2xl p-6 shadow-sm border border-outline-variant/10 group cursor-pointer transition-all hover:ring-2 hover:ring-primary/20\">\n<div class=\"flex items-center justify-between\">\n<div class=\"flex items-center space-x-6\">\n<span class=\"text-4xl font-black text-outline-variant/40\">01</span>\n<div>\n<h4 class=\"text-xl font-bold\">Foundations of Cybersecurity</h4>\n<p class=\"text-secondary text-sm\">Governance, Risk, and Compliance frameworks.</p>\n</div>\n</div>\n<span class=\"material-symbols-outlined text-secondary group-hover:text-primary transition-colors\">add_circle</span>\n</div>\n</div>\n<!-- Module 2 -->\n<div class=\"bg-surface-container-lowest rounded-2xl p-6 shadow-sm border border-outline-variant/10 group cursor-pointer transition-all hover:ring-2 hover:ring-primary/20\">\n<div class=\"flex items-center justify-between\">\n<div class=\"flex items-center space-x-6\">\n<span class=\"text-4xl font-black text-outline-variant/40\">02</span>\n<div>\n<h4 class=\"text-xl font-bold\">Network Infrastructure</h4>\n<p class=\"text-secondary text-sm\">Routing, switching, and secure protocol design.</p>\n</div>\n</div>\n<span class=\"material-symbols-outlined text-secondary group-hover:text-primary transition-colors\">add_circle</span>\n</div>\n</div>\n<!-- Module 3 -->\n<div class=\"bg-surface-container-lowest rounded-2xl p-6 shadow-sm border border-outline-variant/10 group cursor-pointer transition-all hover:ring-2 hover:ring-primary/20\">\n<div class=\"flex items-center justify-between\">\n<div class=\"flex items-center space-x-6\">\n<span class=\"text-4xl font-black text-outline-variant/40\">03</span>\n<div>\n<h4 class=\"text-xl font-bold\">Defensive Security Operations</h4>\n<p class=\"text-secondary text-sm\">SOC monitoring and real-time triage.</p>\n</div>\n</div>\n<span class=\"material-symbols-outlined text-secondary group-hover:text-primary transition-colors\">add_circle</span>\n</div>\n</div>\n</div>\n</div>\n</section>\n<!-- Career Outlook & Salary -->\n<section class=\"py-24 bg-surface\">\n<div class=\"max-w-screen-2xl mx-auto px-8 grid grid-cols-1 lg:grid-cols-2 gap-20 items-center\">\n<div class=\"space-y-8\">\n<h2 class=\"text-5xl font-black tracking-tight leading-tight\">Accelerate Your Career</h2>\n<p class=\"text-lg text-secondary leading-relaxed\">\n                        Cybersecurity isn't just a job; it's a high-growth career path. Our graduates enter the workforce with the credentials and the portfolio needed to command elite compensation from day one.\n                    </p>\n<div class=\"grid grid-cols-1 sm:grid-cols-2 gap-8\">\n<div class=\"p-6 bg-tertiary-fixed rounded-2xl border-l-8 border-tertiary\">\n<div class=\"text-sm font-bold text-on-tertiary-fixed-variant tracking-widest uppercase mb-1\">Avg. Entry Salary</div>\n<div class=\"text-4xl font-black text-on-tertiary-fixed\">$95,000+</div>\n</div>\n<div class=\"p-6 bg-surface-container-high rounded-2xl border-l-8 border-primary\">\n<div class=\"text-sm font-bold text-on-surface-variant tracking-widest uppercase mb-1\">Open Roles</div>\n<div class=\"text-4xl font-black text-on-surface\">3.5M+</div>\n</div>\n</div>\n<div class=\"space-y-4\">\n<h4 class=\"font-bold text-lg\">Target Career Roles:</h4>\n<div class=\"flex flex-wrap gap-2\">\n<span class=\"px-4 py-2 bg-secondary-container rounded-full text-sm font-semibold\">Security Analyst</span>\n<span class=\"px-4 py-2 bg-secondary-container rounded-full text-sm font-semibold\">Network Engineer</span>\n<span class=\"px-4 py-2 bg-secondary-container rounded-full text-sm font-semibold\">SOC Analyst</span>\n<span class=\"px-4 py-2 bg-secondary-container rounded-full text-sm font-semibold\">Cloud Security Specialist</span>\n</div>\n</div>\n</div>\n<div class=\"bg-surface-container-low rounded-[3rem] p-12 text-center space-y-12\">\n<h3 class=\"text-xl font-bold text-secondary uppercase tracking-[0.2em]\">Hiring Partners</h3>\n<div class=\"grid grid-cols-2 gap-12 opacity-60\">\n<div class=\"flex items-center justify-center grayscale hover:grayscale-0 transition-all cursor-pointer\">\n<img alt=\"IBM Logo\" class=\"h-10\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuA9OlSLzDBKr0AJBITPE_dpzAlkaxUGhvQ471fzPB8hSDG67xTUff3Ponf-ost0a4nmB3SPqK59V3A4Y-CJf8NxLaKkVBRajA5hXIIteIWbIuos1_0Ydc0ReUgqYp1XztyOQ11RGZZRuvHbVhqYyJF0fXRnWapAoGcKj48IZg45sZEvUDeqeYN-UUBsmDPuNeP2vJUg9bV9fz2k-K8ieMxe94ogYukhU8l7Sghsv6LIPrkdz2RRdQdcmwfqy2j-yErg7YgdsVefAA\"/>\n</div>\n<div class=\"flex items-center justify-center grayscale hover:grayscale-0 transition-all cursor-pointer\">\n<img alt=\"Google Logo\" class=\"h-10\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuANS0CUWJgzPuxeBn1fMKa52bQOaKxitiHdwGgX6Ox4naeDwIJUKC6sI8oR0wu6xnWOVyXFW4T-nJkrOMDHyNLDU5JDCSac37JzYtFHU8wgLBR2J5NHvwfIAFcpPYBQMbXK7f63ZC-qT_FXTnGZUPdShyag-4toEyCUeAha6ifYTI_56xWWySFBA2vfm3JOx3yTf7VujFUSAUGRtUyKHrxlqp7y-GV29Drx25fLEiKoIAtMiT7K9OKD04dzPhPoS-TLop8QLkqRqQ\"/>\n</div>\n<div class=\"flex items-center justify-center grayscale hover:grayscale-0 transition-all cursor-pointer\">\n<img alt=\"Amazon Logo\" class=\"h-8\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuDI9yiZHPfcIigawbokK1U6UrK3lrRSqhvuZVnv99r3Cs3AWQX7K28E9g47OtjHbDzG7J3lBayNdUG18nGQRG0IqZwdJHCHZxuOk7XwE6dK5GZIt9HR6mAmatVzr1GjvgQ453Y2P_xQSgeh6vj_gH5Q61CET6foo22I0qGDoU8Ie_eAE4O5WuWYywnu32TsoRMyuOfMxP0MRbodVtUHVZJOUct9bFmIkufnbEnAFUPSEi3kW_BCeAB5wbl9iZKipnF9gN1NaAzAhg\"/>\n</div>\n<div class=\"flex items-center justify-center grayscale hover:grayscale-0 transition-all cursor-pointer\">\n<img alt=\"Microsoft Logo\" class=\"h-10\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuBwSEX4rGZV7pK0nlfNjtkuvE522dQJD7NSJdfaoAZz4BKXllbyjAFBrRX7xnu1wTMbwZO0NH0enlRNvf_kH7llzVMiETcwqGUNElOkwXT7RsRodCZ9ecGLuPXHZe_lIcQjO6sNXHA9NsFnMoW4RENID2DAN44PEDKSKFQdGkIRe6AUIPI9MLRtkCYG0uzgM3DAeSfdfMBnVkpQGObGYKHVstcPoUPwLpmSisPhV3hoMeBkL6lnHWy2JSFoPBUvqFyGRO8FJ7KxgA\"/>\n</div>\n</div>\n<div class=\"pt-8 border-t border-outline-variant/30\">\n<p class=\"text-sm font-medium text-secondary italic\">Our exclusive placement network connects you directly with technical recruiters from these global leaders.</p>\n</div>\n</div>\n</div>\n</section>\n<!-- Final CTA -->\n<section class=\"py-24 px-8\">\n<div class=\"max-w-screen-xl mx-auto bg-gradient-to-br from-[#8c0f37] to-[#ad2c4d] rounded-[3rem] p-16 text-center text-on-primary relative overflow-hidden shadow-2xl\">\n<div class=\"absolute inset-0 opacity-10 pointer-events-none\">\n<span class=\"material-symbols-outlined text-[30rem] absolute -top-40 -left-40\">shield</span>\n</div>\n<div class=\"relative z-10 space-y-8\">\n<h2 class=\"text-5xl md:text-6xl font-black tracking-tight\">Ready to start your journey?</h2>\n<p class=\"text-xl text-primary-fixed-dim max-w-2xl mx-auto\">Applications are reviewed on a rolling basis. Secure your spot in the next cohort starting next month.</p>\n<div class=\"flex flex-col sm:flex-row justify-center items-center gap-6\">\n<button class=\"px-12 py-5 bg-white text-primary rounded-xl font-black text-xl shadow-xl hover:bg-surface-container-low transition-all active:scale-95\">\n                            Start Application\n                        </button>\n</div>\n</div>\n</div>\n</section>\n</main>\n<!-- Footer -->\n<footer class=\"w-full rounded-t-[2rem] mt-20 bg-[#f6f3f2] dark:bg-zinc-900\">\n<div class=\"grid grid-cols-1 md:grid-cols-2 gap-8 px-12 py-16 max-w-screen-2xl mx-auto font-['Inter'] text-sm leading-relaxed\">\n<div class=\"space-y-6\">\n<div class=\"text-lg font-bold text-[#1c1b1b] dark:text-zinc-100\">WorkforceAP</div>\n<p class=\"text-zinc-500 dark:text-zinc-400 max-w-xs\">\n                    Empowering the next generation of digital professionals through rigorous, industry-backed training.\n                </p>\n<div class=\"text-xs text-zinc-400\">© 2024 WorkforceAP. All Rights Reserved. An Advancement Foundry Institution.</div>\n</div>\n<div class=\"grid grid-cols-2 gap-4\">\n<div class=\"space-y-4\">\n<h5 class=\"font-bold text-[#1c1b1b] dark:text-zinc-100\">Company</h5>\n<ul class=\"space-y-2 text-zinc-500 dark:text-zinc-400\">\n<li><a class=\"hover:text-[#ad2c4d] transition-colors\" href=\"#\">Privacy Policy</a></li>\n<li><a class=\"hover:text-[#ad2c4d] transition-colors\" href=\"#\">Terms of Service</a></li>\n</ul>\n</div>\n<div class=\"space-y-4\">\n<h5 class=\"font-bold text-[#1c1b1b] dark:text-zinc-100\">Support</h5>\n<ul class=\"space-y-2 text-zinc-500 dark:text-zinc-400\">\n<li><a class=\"hover:text-[#ad2c4d] transition-colors\" href=\"#\">Accreditation</a></li>\n<li><a class=\"hover:text-[#ad2c4d] transition-colors\" href=\"#\">Contact Support</a></li>\n</ul>\n</div>\n</div>\n</div>\n</footer>\n</body></html>"
