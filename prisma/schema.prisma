model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?  @map("actor_user_id")
  /// PLAN-2026-Q3 §P4: snapshot of the actor's email at write time. The
  /// `actor` FK uses onDelete: SetNull, so when a user is deleted the
  /// audit row would otherwise lose attribution. These snapshot columns
  /// keep the row self-contained for WIOA / federal-funding audits.
  actorEmailSnapshot String? @map("actor_email_snapshot")
  /// Snapshot of the actor's primary role name at write time (admin,
  /// counselor, partner, etc). NULL if the actor had no role assignment.
  actorRoleSnapshot  String? @map("actor_role_snapshot")
  action      String
  targetType  String   @map("target_type")
  targetId    String?  @map("target_id")
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  actor User? @relation("ActorAuditLogs", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("audit_logs")
}

/// xAPI 1.0.3-shaped admin action audit trail (org-scoped via RLS).
model AuditEvent {
  id            String   @id @default(uuid())
  actorUserId   String   @map("actor_user_id")
  actorRole     String   @map("actor_role")
  verb          String
  objectType    String   @map("object_type")
  objectId      String   @map("object_id")
  orgId         String   @map("org_id")
  statementJson Json     @map("statement_json")
  createdAt     DateTime @default(now()) @map("created_at")
  ip            String?
  ua            String?  @db.Text

  actor        User         @relation("ActorAuditEvents", fields: [actorUserId], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)

  @@index([actorUserId])
  @@index([orgId, createdAt])
  @@index([objectType, objectId])
  @@index([verb])
  @@index([createdAt])
  @@map("audit_events")
}

// --- Admin Invitations ---

enum InvitationRole {
  admin
  partner
  member
  counselor
}

enum InvitationStatus {
  pending
  accepted
  expired
  revoked
}

model Invitation {
  id              String           @id @default(uuid())
  email           String           @db.Text
  role            InvitationRole
  subgroupId      String?          @map("subgroup_id")
  // Partner org for counselor invites; null = WorkforceAP counselor
  partnerId       String?          @map("partner_id")
  programSlug     String?          @map("program_slug")
  invitedById     String           @map("invited_by")
  token           String           @unique
