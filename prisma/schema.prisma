// --- Coursera CSV / xAPI ingestion ---

/// Per-learner-per-course progress imported from the Coursera "Learner activity & progress"
/// CSV report (CourseActivity tab). Used as a backfill + ongoing-redundancy path alongside
/// the realtime xAPI bridge. Idempotent on (externalEmail, courseraCourseId).
model CourseraCourseProgress {
  id                   String    @id @default(uuid())
  userId               String?   @map("user_id")
  externalEmail        String    @map("external_email")
  externalName         String?   @map("external_name")
  courseraCourseId     String    @map("coursera_course_id")
  courseraCourseSlug   String?   @map("coursera_course_slug")
  courseName           String    @map("course_name")
  university           String?   @map("university")
  collectionName       String?   @map("collection_name")
  collectionId         String?   @map("collection_id")
  programSlug          String    @map("program_slug")
  programName          String?   @map("program_name")
  enrollmentTime       DateTime? @map("enrollment_time")
  classStartTime       DateTime? @map("class_start_time")
  classEndTime         DateTime? @map("class_end_time")
  lastActivityTime     DateTime? @map("last_activity_time")
  completionTime       DateTime? @map("completion_time")
  overallProgress      Decimal   @map("overall_progress") @db.Decimal(5, 2)
  learningHours        Decimal   @map("learning_hours") @db.Decimal(8, 2)
  isCompleted          Boolean   @default(false) @map("is_completed")
  isRemovedFromProgram Boolean   @default(false) @map("is_removed_from_program")
  courseGrade          String?   @map("course_grade")
  certificateUrl       String?   @map("certificate_url")
  contractName         String?   @map("contract_name")
  contractActive       Boolean?  @map("contract_active")
  source               String    @default("csv_import") @map("source")
  lastSyncedAt         DateTime  @default(now()) @updatedAt @map("last_synced_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([externalEmail, courseraCourseId])
  @@index([userId])
  @@index([programSlug])
  @@index([courseraCourseId])
  @@map("coursera_course_progress")
}

/// Admin-curated mapping from a real Coursera course (identified by its
/// `coursera_course_id`) to a canonical (programSlug, courseSlug) pair in
/// `lib/content/programs.ts`. Lets non-engineers wire up new courses without
/// a code change — see /admin/training-progress (raw view) for the inline
/// "Map this" action.
///
/// Resolution order at read time is: this table first (most-recently-edited
/// row per courseraCourseId wins), then the static `courseraCourseId` field
/// on the program-def fallback. So an admin can override a static mapping
/// without redeploying.
model CourseraCanonicalCourseMapping {
  id                   String   @id @default(uuid())
  courseraCourseId     String   @unique @map("coursera_course_id")
  courseraCourseSlug   String?  @map("coursera_course_slug")
  canonicalProgramSlug String   @map("canonical_program_slug")
  canonicalCourseSlug  String   @map("canonical_course_slug")
  notes                String?  @map("notes")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")
  createdById          String?  @map("created_by_id")

  createdBy User? @relation("CourseraCanonicalCourseMappingCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([canonicalProgramSlug])
  @@index([canonicalCourseSlug])
  @@index([createdById])
  @@map("coursera_canonical_course_mappings")
}

/// Identity bridge from a Coursera learner (by Coursera email or xAPI actor)
/// to a WorkforceAP user. Originally created on demand by
/// `lib/xapi/mappings.ts` via raw SQL — now modeled in Prisma so reads can use
/// the typed client. The on-demand `CREATE TABLE IF NOT EXISTS` in
/// `lib/xapi/mappings.ts` is preserved for back-compat / fresh DBs that
/// haven't run migrations yet.
///
/// Note: `userId` is `text` (not a relation) because existing prod rows are
/// not guaranteed to be valid UUIDs that round-trip through Prisma's UUID
/// validator. The on-demand SQL also writes it as text. Switching to a
/// relation would require a data migration; see #coursera-canonical-mappings.
model CourseraIdentityMapping {
  id               String    @id @default(uuid())
  userId           String    @map("user_id")
  courseraEmail    String?   @map("coursera_email")
  actorIdentifier  String?   @map("actor_identifier")
  actorHomePage    String?   @map("actor_home_page")
  source           String    @map("source")
  notes            String?   @map("notes")
  createdByUserId  String?   @map("created_by_user_id")
  lastSeenAt       DateTime? @map("last_seen_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@index([actorIdentifier, actorHomePage])
  @@map("coursera_identity_mappings")
}

/// Per-learner-per-badge (specialization) progress imported from the Coursera
/// "Learner activity & progress" CSV report (LearningPathActivity tab). The raw
/// CSV has one row per (learner, course-within-badge); the ingester deduplicates
/// to one row per (learner, badgeSlug). Idempotent on (externalEmail, badgeSlug).
model CourseraBadgeProgress {
  id                  String    @id @default(uuid())
  userId              String?   @map("user_id")
  externalEmail       String    @map("external_email")
  externalName        String?   @map("external_name")
  badgeSlug           String    @map("badge_slug")
  badgeTitle          String    @map("badge_title")
  badgeLink           String?   @map("badge_link")
  numberOfCourses     Int       @map("number_of_courses")
  progressPercent     Decimal   @map("progress_percent") @db.Decimal(5, 2)
  coursesCompleted    Int       @default(0) @map("courses_completed")
  currentCourseName   String?   @map("current_course_name")
  badgeCompleted      Boolean   @default(false) @map("badge_completed")
  badgeCompletionTime DateTime? @map("badge_completion_time")
  lastActivityTime    DateTime? @map("last_activity_time")
  totalLearningHours  Decimal   @map("total_learning_hours") @db.Decimal(8, 2)
  collectionId        String?   @map("collection_id")
  collectionName      String?   @map("collection_name")
  source              String    @default("csv_import") @map("source")
  lastSyncedAt        DateTime  @default(now()) @updatedAt @map("last_synced_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([externalEmail, badgeSlug])
  @@index([userId])
  @@index([badgeSlug])
  @@map("coursera_badge_progress")
}

