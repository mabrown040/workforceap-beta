{
  "name": "workforceap",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/safe-migrate.cjs && node scripts/prisma-env.js prisma generate && next build",
    "postinstall": "node scripts/prisma-env.js prisma generate",
    "start": "next start",
    "db:generate": "node scripts/prisma-env.js prisma generate",
    "db:migrate": "node scripts/prisma-env.js prisma migrate dev",
    "db:migrate:deploy": "node scripts/prisma-env.js prisma migrate deploy",
    "db:cleanup-fixtures": "node scripts/prisma-env.js npx tsx scripts/cleanup-fixtures.ts",
    "db:push": "node scripts/prisma-env.js prisma db push",
    "db:studio": "node scripts/prisma-env.js prisma studio",
    "db:seed": "node scripts/prisma-env.js npx tsx prisma/seed.ts",
    "db:seed:blog": "node scripts/prisma-env.js npx tsx prisma/seed-blog.ts",
    "db:seed:demo": "SEED_DEMO=true node scripts/prisma-env.js npx tsx prisma/seed-demo.ts",
    "db:create-employer-michael-brown": "node scripts/prisma-env.js npx tsx scripts/create-employer-michael-brown.ts",
    "db:sync-test-auth": "node scripts/prisma-env.js npx tsx scripts/sync-portal-test-auth.ts",
    "db:migrate:resolve-failed": "node scripts/resolve-failed-migration.cjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "repo:sync-master": "powershell -ExecutionPolicy Bypass -File scripts/auto-sync-master.ps1",
    "test:unit": "node --import tsx --test lib/**/*.test.ts",
    "elevenlabs:apply-patches": "node scripts/elevenlabs/apply-agent-patches.mjs",
    "email": "email dev -p 3001"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.82.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@elevenlabs/client": "^1.0.0",
    "@hookform/resolvers": "^3.9.1",
    "@marsidev/react-turnstile": "^1.4.2",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "@react-email/components": "^1.0.11",
    "@sentry/nextjs": "^10.47.0",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.105.1",
    "@upstash/ratelimit": "^2.0.4",
    "@upstash/redis": "^1.34.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "groq-sdk": "^1.1.1",
    "i18next": "^26.0.8",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-resources-to-backend": "^1.2.1",
    "lucide-react": "^0.577.0",
    "mammoth": "^1.12.0",
    "next": "^15.5.15",
    "next-i18next": "^16.0.5",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "pg": "^8.21.0",
    "react": "^19",
    "react-dom": "^19",
    "react-hook-form": "^7.54.2",
    "react-i18next": "^17.0.4",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1",
    "resend": "^4.0.1",
    "undici": "^7.24.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@react-email/preview-server": "^5.2.10",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.27",
    "postcss": "^8.5.12",
    "prisma": "7.8.0",
    "react-email": "^5.2.10",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.21.0",
    "typescript": "^5"
  },
  "pnpm": {
    "overrides": {
      "@xmldom/xmldom": "^0.8.13",
      "uuid": "^14.0.0",
      "postcss": "^8.5.10"
    }
  }
}
