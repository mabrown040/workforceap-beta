---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="WorkforceAP — Empowering People. Advancing Futures.">
<!-- ============ IMMERSIVE HERO (full-bleed photo + crimson gradient) ============ -->
<section class="imm-hero">
  <div class="imm-hero__media" aria-hidden="true"></div>
  <div class="imm-hero__veil" aria-hidden="true"></div>
  <div class="imm-hero__inner wrap">
    <span class="imm-pill"><span class="imm-pill__star">★</span>501(c)(3) nonprofit · Employer-recognized certificates</span>
    <h1 class="imm-title">Empowering People.<br><span class="imm-grad">Advancing Futures.</span></h1>
    <p class="imm-sub">Employer-aligned training, professional certificates, and real career support — at no cost to qualifying members.</p>
    <div class="imm-cta">
      <a class="btn btn--light" href="/apply">Start your application →</a>
      <a class="btn btn--translucent" href="/find-your-path">Find your path</a>
    </div>
    <div class="imm-trust">
      <span><b>25+ years</b> in workforce development</span><span class="imm-dot"></span>
      <span><b>$0</b> for qualifying members</span><span class="imm-dot"></span>
      <span>Reviewed by a <b>real team</b></span>
    </div>
  </div>
  <div class="imm-scroll" aria-hidden="true"><span></span></div>
</section>

<!-- Content scrolls UP over the fixed hero on a raised sheet -->
<div class="imm-sheet">

  <!-- CERT PARTNERS -->
  <section class="imm-creds"><div class="wrap">
    <div class="imm-creds__lab">Employer-recognized credentials you can earn</div>
    <div class="imm-creds__row">
      <span class="imm-logo">IBM</span><span class="imm-logo">Google</span><span class="imm-logo">Microsoft</span><span class="imm-logo">AWS</span><span class="imm-logo">CompTIA</span>
      <span class="imm-extra">+ CPT &amp; CLT</span>
    </div>
  </div></section>

  <!-- HOW IT WORKS — the journey, cinematic numbered band -->
  <section class="imm-band"><div class="wrap">
    <div class="imm-sec-head">
      <span class="imm-eyebrow">Your pathway</span>
      <h2>From apply to <span class="grad-text">hired</span>, with a team behind you</h2>
      <p>Four steps from application to a recognized credential and career support.</p>
    </div>
    <div class="imm-journey">
      <div class="imm-jcard"><div class="imm-jnum">01</div><h3>Apply</h3><p>Takes about 5 minutes. No cost for qualifying members — a real team reviews it.</p><span class="imm-tag">~5 min</span></div>
      <div class="imm-jcard"><div class="imm-jnum">02</div><h3>Get matched</h3><p>We match you to the program track that fits your goals and background.</p></div>
      <div class="imm-jcard"><div class="imm-jnum">03</div><h3>Train &amp; certify</h3><p>Build job-ready skills and earn an employer-recognized professional certificate.</p></div>
      <div class="imm-jcard"><div class="imm-jnum">04</div><h3>Launch</h3><p>Move into the workforce with resume, interview, and mentor support behind you.</p></div>
    </div>
    <p class="imm-note">A real team reviews your application and follows up in 1 to 2 business days.</p>
  </div></section>

  <!-- MEMBER TOOLS -->
  <section class="imm-band imm-band--tint"><div class="wrap">
    <div class="imm-sec-head">
      <span class="imm-eyebrow">Member tools</span>
      <h2>Tools that get you <span class="grad-text">job-ready</span></h2>
      <p>Members get a connected toolkit — coaching, practice, and tracking — alongside their program.</p>
    </div>
    <div class="imm-tools">
      <div class="imm-tool"><div class="imm-ic imm-ic--c">📄</div><h3>AI Resume Studio</h3><p>Build and refine your resume with guided, real-time feedback on clarity, formatting, and ATS readability — then export and apply.</p></div>
      <div class="imm-tool"><div class="imm-ic imm-ic--g">🎙️</div><h3>AI Interview &amp; Voice Coach</h3><p>Practice real interview questions out loud and get coaching on your answers.</p></div>
      <div class="imm-tool"><div class="imm-ic imm-ic--b">🧭</div><h3>Skills &amp; Career Mapping</h3><p>See how your experience lines up to in-demand roles and what to learn next.</p></div>
      <div class="imm-tool"><div class="imm-ic imm-ic--gr">🤝</div><h3>Mentor Support</h3><p>Connect with mentors and a career team that follow up — you're never doing it alone.</p></div>
      <div class="imm-tool"><div class="imm-ic imm-ic--b">🔎</div><h3>Program Matching</h3><p>Get matched to the training track that fits your goals from our catalog of programs.</p></div>
      <div class="imm-tool"><div class="imm-ic imm-ic--c">📊</div><h3>Progress Dashboard</h3><p>Track milestones from enrollment through certificate and job search in one place.</p></div>
    </div>
  </div></section>

  <!-- WHO WE SERVE -->
  <section class="imm-band"><div class="wrap">
    <div class="imm-sec-head">
      <span class="imm-eyebrow">A connected network</span>
      <h2>Built for members, employers &amp; partners</h2>
    </div>
    <div class="imm-tri">
      <div class="imm-acard"><div class="imm-ic imm-ic--c">👥</div><h3>Members</h3><p>No-cost, employer-aligned training, professional certificates, and a team that supports you to job-ready.</p><a href="/apply">Start your application →</a></div>
      <div class="imm-acard"><div class="imm-ic imm-ic--b">🏢</div><h3>Employers</h3><p>Build a pipeline of training-aligned candidates for in-demand roles — no per-placement fees.</p><a href="/employers">Talk with us about hiring →</a></div>
      <div class="imm-acard"><div class="imm-ic imm-ic--gr">🏛️</div><h3>Partners</h3><p>Extend workforce impact in your community through referral and program partnerships.</p><a href="/partners">Explore partnership →</a></div>
    </div>
    <p class="imm-truth">We're a nonprofit — so we don't inflate outcomes. We publish verified placement data as cohorts complete, with the methodology shown. <a href="/outcomes">See our outcomes →</a></p>
  </div></section>

  <!-- TRUST FACTS BAND -->
  <section class="imm-band imm-band--tint"><div class="wrap">
    <div class="imm-facts">
      <div class="imm-fact"><div class="imm-k">25+ yrs</div><p>In workforce development</p></div>
      <div class="imm-fact"><div class="imm-k">501(c)(3)</div><p>Nonprofit organization</p></div>
      <div class="imm-fact"><div class="imm-k">$0</div><p>For qualifying members</p></div>
      <div class="imm-fact"><div class="imm-k">5</div><p>Employer-recognized cert tracks</p></div>
    </div>
  </div></section>

  <!-- CLOSING CTA — full-bleed cinematic again -->
  <section class="imm-close">
    <div class="imm-close__media" aria-hidden="true"></div>
    <div class="imm-close__veil" aria-hidden="true"></div>
    <div class="imm-close__inner wrap">
      <span class="imm-pill imm-pill--solid"><span class="imm-pill__star">★</span>Employer-recognized certificates</span>
      <h2>Your next step starts with one application.</h2>
      <p>Apply in about 5 minutes — no cost for qualifying members. A real team reviews it and follows up in 1 to 2 business days.</p>
      <div class="imm-cta">
        <a class="btn btn--light" href="/apply">Start your application</a>
        <a class="btn btn--translucent" href="/find-your-path">Find your path</a>
        <a class="btn btn--translucent" href="/employers">For employers</a>
      </div>
    </div>
  </section>

</div>

<style>
  /* ===================== IMMERSIVE VARIANT ===================== */
  /* Full-bleed cinematic hero. Photo + crimson gradient veil, headline
     over it, then content scrolls up over the pinned hero on a raised sheet. */

  /* break out of <main> width to go truly full-bleed */
  .imm-hero{
    position:sticky;top:0;z-index:0;
    width:100vw;left:50%;right:50%;margin-left:-50vw;margin-right:-50vw;
    min-height:100vh;min-height:100svh;
    display:flex;align-items:center;
    overflow:hidden;
  }
  .imm-hero__media{
    position:absolute;inset:0;
    background:url('https://www.workforceap.org/images/hero-people.webp') center 30%/cover no-repeat;
    transform:scale(1.04);
  }
  /* crimson gradient overlay — dark enough at bottom for white text to scroll over */
  .imm-hero__veil{
    position:absolute;inset:0;
    background:
      linear-gradient(180deg,rgba(140,15,55,.28) 0%,rgba(109,20,55,.10) 32%,rgba(140,15,55,.62) 78%,rgba(45,8,22,.92) 100%),
      linear-gradient(115deg,rgba(173,44,77,.78) 0%,rgba(140,15,55,.42) 46%,rgba(109,20,55,.30) 100%);
  }
  .imm-hero__inner{position:relative;z-index:2;color:#fff;padding-top:96px;padding-bottom:120px;max-width:var(--max);}

  .imm-pill{
    display:inline-flex;align-items:center;gap:8px;white-space:nowrap;
    background:linear-gradient(135deg,#d3aa54,#9a7733);color:#fff;
    font-weight:800;font-size:13px;letter-spacing:.02em;line-height:1;
    padding:9px 18px;border-radius:999px;
    box-shadow:0 10px 28px -10px rgba(164,127,56,.8),0 1px 0 rgba(255,255,255,.3) inset;
    margin-bottom:26px;
  }
  .imm-pill__star{font-size:11px;opacity:.95}
  .imm-pill--solid{margin-bottom:22px}

  .imm-title{
    font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;
    font-size:clamp(44px,8vw,92px);line-height:1.02;letter-spacing:-.03em;
    margin:0 0 22px;max-width:14ch;
    text-shadow:0 2px 40px rgba(45,8,22,.45);
  }
  .imm-grad{
    background:linear-gradient(100deg,#ffd98a,#ffb4c4);
    -webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;
  }
  .imm-sub{
    font-size:clamp(18px,2.2vw,23px);line-height:1.5;
    color:rgba(255,255,255,.94);max-width:34em;margin:0 0 32px;
    text-shadow:0 1px 20px rgba(45,8,22,.4);
  }
  .imm-cta{display:flex;gap:14px;flex-wrap:wrap;margin-bottom:30px}
  .imm-trust{display:flex;align-items:center;gap:16px;flex-wrap:wrap;color:rgba(255,255,255,.86);font-size:14px}
  .imm-trust b{color:#fff}
  .imm-dot{width:4px;height:4px;border-radius:50%;background:rgba(255,255,255,.5)}

  /* scroll cue */
  .imm-scroll{position:absolute;bottom:26px;left:50%;transform:translateX(-50%);z-index:2;
    width:26px;height:42px;border:2px solid rgba(255,255,255,.5);border-radius:14px;display:grid;justify-items:center;padding-top:7px}
  .imm-scroll span{width:4px;height:8px;border-radius:3px;background:#fff;display:block}
  @media (prefers-reduced-motion: no-preference){
    .imm-scroll span{animation:imm-bob 1.6s ease-in-out infinite}
    @keyframes imm-bob{0%,100%{transform:translateY(0);opacity:1}60%{transform:translateY(12px);opacity:.2}}
  }

  /* ===== raised sheet that scrolls up over the pinned hero ===== */
  .imm-sheet{
    position:relative;z-index:1;
    background:var(--bg);
    border-radius:34px 34px 0 0;
    box-shadow:0 -30px 70px -30px rgba(45,8,22,.5);
    margin-top:-44px;
    /* re-establish full width inside <main> */
    width:100vw;left:50%;right:50%;margin-left:-50vw;margin-right:-50vw;
    padding-top:12px;
  }
  /* grabber handle on the sheet edge */
  .imm-sheet::before{
    content:"";position:absolute;top:14px;left:50%;transform:translateX(-50%);
    width:54px;height:5px;border-radius:3px;background:var(--border);
  }

  /* cert partners */
  .imm-creds{padding:54px 0 8px;border-bottom:1px solid var(--border)}
  .imm-creds__lab{text-align:center;color:var(--muted);font-size:12px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;margin-bottom:18px}
  .imm-creds__row{display:flex;align-items:center;justify-content:center;gap:38px;flex-wrap:wrap;padding-bottom:34px}
  .imm-logo{font-family:'Plus Jakarta Sans';font-weight:800;font-size:22px;color:#4a4440;opacity:.78}
  .imm-extra{color:var(--gold-dark);font-weight:700;font-size:15px}

  /* bands */
  .imm-band{padding:74px 0}
  .imm-band--tint{background:var(--surface)}
  .imm-sec-head{text-align:center;max-width:680px;margin:0 auto 48px}
  .imm-eyebrow{display:inline-block;font-size:13px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;color:var(--crimson);background:rgba(173,44,77,.08);border:1px solid rgba(173,44,77,.18);padding:7px 14px;border-radius:999px;margin-bottom:16px}
  .imm-sec-head h2{font-size:clamp(30px,4.4vw,48px);font-weight:800;line-height:1.05;margin-bottom:14px}
  .imm-sec-head p{color:var(--muted);font-size:19px;line-height:1.55}

  /* journey */
  .imm-journey{display:grid;grid-template-columns:repeat(4,1fr);gap:20px}
  .imm-jcard{position:relative;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:30px 26px;box-shadow:var(--shadow);transition:transform .2s,box-shadow .25s}
  .imm-jcard:hover{transform:translateY(-5px);box-shadow:var(--shadow-lg)}
  .imm-jnum{font-family:'Plus Jakarta Sans';font-weight:800;font-size:40px;line-height:1;background:var(--grad-text);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;margin-bottom:16px}
  .imm-jcard h3{font-size:20px;font-weight:700;margin-bottom:8px}
  .imm-jcard p{color:var(--muted);font-size:15px}
  .imm-tag{display:inline-flex;margin-top:14px;font-size:12px;font-weight:700;padding:5px 11px;border-radius:999px;background:rgba(164,127,56,.14);color:var(--gold-dark)}
  .imm-note{text-align:center;color:var(--muted);font-size:14px;margin-top:30px}
  @media(max-width:900px){.imm-journey{grid-template-columns:1fr 1fr}}
  @media(max-width:520px){.imm-journey{grid-template-columns:1fr}}

  /* tools */
  .imm-tools{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
  .imm-tool{position:relative;overflow:hidden;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:28px;box-shadow:var(--shadow);transition:transform .2s,box-shadow .25s}
  .imm-tool::before{content:"";position:absolute;left:0;right:0;top:0;height:3px;background:var(--grad-text);transform:scaleX(0);transform-origin:left;transition:transform .3s ease}
  .imm-tool:hover{transform:translateY(-5px);box-shadow:var(--shadow-lg)}
  .imm-tool:hover::before{transform:scaleX(1)}
  .imm-ic{width:52px;height:52px;border-radius:14px;display:grid;place-items:center;font-size:24px;margin-bottom:16px}
  .imm-ic--c{background:rgba(173,44,77,.12)}
  .imm-ic--g{background:rgba(164,127,56,.14)}
  .imm-ic--b{background:rgba(43,123,185,.12)}
  .imm-ic--gr{background:rgba(74,155,79,.12)}
  .imm-tool h3{font-size:20px;font-weight:700;margin-bottom:8px}
  .imm-tool p{color:var(--muted);font-size:15px}
  @media(max-width:900px){.imm-tools{grid-template-columns:1fr 1fr}}
  @media(max-width:560px){.imm-tools{grid-template-columns:1fr}}

  /* tri-audience */
  .imm-tri{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}
  .imm-acard{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:32px;box-shadow:var(--shadow);transition:transform .2s,box-shadow .25s}
  .imm-acard:hover{transform:translateY(-5px);box-shadow:var(--shadow-lg)}
  .imm-acard h3{font-size:21px;font-weight:700;margin-bottom:8px}
  .imm-acard p{color:var(--muted);font-size:15px;margin-bottom:16px}
  .imm-acard a{font-weight:700;color:var(--crimson)}
  .imm-acard a:hover{text-decoration:underline}
  .imm-truth{max-width:680px;margin:32px auto 0;text-align:center;color:var(--muted);font-size:14px;background:var(--surface-2);border:1px dashed var(--border);border-radius:14px;padding:16px 20px}
  .imm-truth a{color:var(--crimson);font-weight:700}
  @media(max-width:900px){.imm-tri{grid-template-columns:1fr}}

  /* facts */
  .imm-facts{display:grid;grid-template-columns:repeat(4,1fr);gap:24px;text-align:center}
  .imm-k{font-family:'Plus Jakarta Sans';font-weight:800;font-size:clamp(28px,3.4vw,42px);background:var(--grad-text);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
  .imm-fact p{color:var(--muted);font-size:15px;margin-top:4px}
  @media(max-width:760px){.imm-facts{grid-template-columns:1fr 1fr}}

  /* closing cinematic CTA (full-bleed again) */
  .imm-close{
    position:relative;overflow:hidden;
    width:100vw;left:50%;right:50%;margin-left:-50vw;margin-right:-50vw;
    padding:0;
  }
  .imm-close__media{
    position:absolute;inset:0;
    background:url('https://www.workforceap.org/images/hero-people.webp') center 40%/cover no-repeat;
  }
  .imm-close__veil{
    position:absolute;inset:0;
    background:linear-gradient(120deg,rgba(173,44,77,.92) 0%,rgba(140,15,55,.88) 50%,rgba(109,20,55,.9) 100%);
  }
  .imm-close__inner{position:relative;z-index:2;color:#fff;text-align:center;padding:90px 24px 96px;max-width:var(--max)}
  .imm-close__inner h2{font-family:'Plus Jakarta Sans';font-weight:800;font-size:clamp(30px,4.6vw,54px);line-height:1.06;margin-bottom:14px}
  .imm-close__inner p{font-size:19px;color:rgba(255,255,255,.92);max-width:34em;margin:0 auto 28px}
  .imm-close__inner .imm-cta{justify-content:center}

  @media(max-width:880px){
    .imm-hero__inner{padding-top:104px;padding-bottom:100px}
    .imm-sheet{border-radius:26px 26px 0 0}
  }
</style>
</Layout>
