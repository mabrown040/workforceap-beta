---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="WorkforceAP — Empowering People. Advancing Futures.">
<div class="mix1">

  <!-- ============ 1. IMMERSIVE CINEMATIC HERO (full-bleed photo + crimson→near-black veil) ============ -->
  <section class="m1hero">
    <div class="m1hero__media" aria-hidden="true"></div>
    <div class="m1hero__veil" aria-hidden="true"></div>
    <div class="m1hero__glow" aria-hidden="true"></div>
    <div class="m1hero__inner wrap">
      <span class="m1pill"><span class="m1pill__star">★</span>501(c)(3) nonprofit · Employer-recognized certificates</span>
      <h1 class="m1title">Empowering People.<br><span class="m1grad">Advancing Futures.</span></h1>
      <p class="m1sub">Employer-aligned training, professional certificates, and real career support — at no cost to qualifying members.</p>
      <div class="m1cta">
        <a class="btn btn--light" href="/apply">Start your application →</a>
        <a class="btn btn--translucent" href="/find-your-path">Find your path</a>
      </div>
      <div class="m1trust">
        <span><b>25+ years</b> in workforce development</span><span class="m1dot"></span>
        <span><b>$0</b> for qualifying members</span><span class="m1dot"></span>
        <span>Reviewed by a <b>real team</b></span>
      </div>
    </div>
    <div class="m1scroll" aria-hidden="true"><span></span></div>
  </section>

  <!-- ============ 2. DEPTH GLASS DECK — floating translucent cards that OVERLAP the hero's bottom edge ============ -->
  <section class="m1overlap">
    <div class="wrap m1deck">
      <!-- credentials card -->
      <div class="m1card m1card--creds">
        <div class="m1card-tag">Recognized credential</div>
        <div class="m1logos">
          <span>IBM</span><span>Google</span><span>Microsoft</span><span>AWS</span><span>CompTIA</span>
        </div>
        <div class="m1card-foot">Earn an employer-recognized professional certificate.</div>
      </div>

      <!-- live pathway tracker -->
      <div class="m1card m1card--track">
        <div class="m1track-row">
          <small>Your pathway</small>
          <span class="m1live">Live</span>
        </div>
        <div class="m1track-big">From apply to hired</div>
        <div class="m1track"><i class="t-done"></i><i class="t-done"></i><i class="t-now"></i><i></i></div>
        <div class="m1track-labels"><span>Apply</span><span>Match</span><span>Certify</span><span>Launch</span></div>
      </div>

      <!-- $0 / reviewed card -->
      <div class="m1card m1card--cost">
        <div class="m1cost-head">
          <div class="m1ic-check">✓</div>
          <div>
            <b>Application reviewed</b>
            <span>A real team follows up in 1–2 business days.</span>
          </div>
        </div>
        <div class="m1meter">
          <span>Cost to qualifying members</span>
          <strong>$0</strong>
        </div>
        <div class="m1chips">
          <span>~5 min to apply</span>
          <span>No cost</span>
          <span>Real support</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ 3. CERT PARTNERS — clean cream strip ============ -->
  <section class="m1creds">
    <div class="wrap">
      <p class="m1creds-lab">Employer-recognized credentials you can earn</p>
      <div class="m1creds-row">
        <span class="m1logo">IBM</span>
        <span class="m1logo">Google</span>
        <span class="m1logo">Microsoft</span>
        <span class="m1logo">AWS</span>
        <span class="m1logo">CompTIA</span>
        <span class="m1creds-extra">+ CPT &amp; CLT</span>
      </div>
    </div>
  </section>

  <!-- ============ 4. BOLD CRIMSON BLOCK — how it works, 4 huge numbered steps ============ -->
  <section class="m1blk m1blk--crimson">
    <div class="wrap m1blk__in">
      <div class="m1head m1head--light">
        <span class="m1kick">Simple process</span>
        <h2>Four steps.<br><span class="m1gold">One application.</span></h2>
        <p>From application to a recognized credential and career support — with a real team behind you the whole way.</p>
      </div>
      <div class="m1journey">
        <a class="m1step" href="/apply">
          <span class="m1num">01</span>
          <h3>Apply</h3>
          <p>Takes about 5 minutes. No cost for qualifying members — a real team reviews it.</p>
        </a>
        <div class="m1step">
          <span class="m1num">02</span>
          <h3>Get matched</h3>
          <p>We match you to the program track that fits your goals and background.</p>
        </div>
        <div class="m1step">
          <span class="m1num">03</span>
          <h3>Train &amp; certify</h3>
          <p>Build job-ready skills and earn an employer-recognized professional certificate.</p>
        </div>
        <div class="m1step">
          <span class="m1num">04</span>
          <h3>Launch</h3>
          <p>Move into the workforce with resume, interview, and mentor support behind you.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ 5. BOLD CREAM BLOCK — who we serve, tri cards ============ -->
  <section class="m1blk m1blk--cream">
    <div class="wrap m1blk__in">
      <div class="m1head">
        <span class="m1kick m1kick--crimson">A connected network</span>
        <h2>Built for members,<br>employers &amp; partners.</h2>
      </div>
      <div class="m1tri">
        <div class="m1tcard">
          <span class="m1tcard-tag m1tcard-tag--c">Members</span>
          <p>No-cost, employer-aligned training, professional certificates, and a team that supports you to job-ready.</p>
          <a class="m1tlink" href="/apply">Start your application →</a>
        </div>
        <div class="m1tcard">
          <span class="m1tcard-tag m1tcard-tag--b">Employers</span>
          <p>Build a pipeline of training-aligned candidates for in-demand roles — no per-placement fees.</p>
          <a class="m1tlink" href="/employers">Talk with us about hiring →</a>
        </div>
        <div class="m1tcard">
          <span class="m1tcard-tag m1tcard-tag--g">Partners</span>
          <p>Extend workforce impact in your community through referral and program partnerships.</p>
          <a class="m1tlink" href="/partners">Explore partnership →</a>
        </div>
      </div>
      <p class="m1truth">We're a nonprofit — so we don't inflate outcomes. We publish verified placement data as cohorts complete, with the methodology shown. <a href="/outcomes">See our outcomes →</a></p>
    </div>
  </section>

  <!-- ============ 6. BOLD CRIMSON BLOCK — big-number trust facts ============ -->
  <section class="m1blk m1blk--crimson">
    <div class="wrap m1facts">
      <div class="m1fact"><div class="m1fk">25+</div><p>years in workforce development</p></div>
      <div class="m1fact"><div class="m1fk">501(c)(3)</div><p>nonprofit organization</p></div>
      <div class="m1fact"><div class="m1fk">$0</div><p>for qualifying members</p></div>
      <div class="m1fact"><div class="m1fk">5</div><p>employer-recognized cert tracks</p></div>
    </div>
  </section>

  <!-- ============ 7. IMMERSIVE CLOSING CTA — full-bleed photo + crimson veil ============ -->
  <section class="m1close">
    <div class="m1close__media" aria-hidden="true"></div>
    <div class="m1close__veil" aria-hidden="true"></div>
    <div class="m1close__inner wrap">
      <span class="m1pill m1pill--solid"><span class="m1pill__star">★</span>Reviewed by a real team in 1–2 business days</span>
      <h2>Your next step starts with one application.</h2>
      <p>Apply in about 5 minutes — no cost for qualifying members. A real team reviews it and follows up in 1 to 2 business days.</p>
      <div class="m1cta m1cta--center">
        <a class="btn btn--light" href="/apply">Start your application</a>
        <a class="btn btn--translucent" href="/find-your-path">Find your path</a>
        <a class="btn btn--translucent" href="/employers">For employers</a>
      </div>
    </div>
  </section>

</div>

<style>
  /* =================================================================
     MIX1 — IMMERSIVE-LED fusion
     immersive cinematic hero → depth glass overlap → bold blocks → immersive close
     ================================================================= */
  .mix1{--glass:rgba(255,255,255,.12);--glass-line:rgba(255,255,255,.2)}

  /* ---------- 1. IMMERSIVE HERO (adapted from immersive.astro) ---------- */
  .m1hero{
    position:relative;isolation:isolate;
    width:100vw;left:50%;right:50%;margin-left:-50vw;margin-right:-50vw;
    min-height:100vh;min-height:100svh;
    display:flex;align-items:center;
    overflow:hidden;
  }
  .m1hero__media{
    position:absolute;inset:0;z-index:0;
    background:url('https://www.workforceap.org/images/hero-people.webp') center 28%/cover no-repeat;
    transform:scale(1.05);
  }
  /* crimson → near-black gradient veil (darker than immersive's so headline + glass pop) */
  .m1hero__veil{
    position:absolute;inset:0;z-index:1;
    background:
      linear-gradient(180deg,rgba(140,15,55,.34) 0%,rgba(109,20,55,.18) 30%,rgba(74,14,38,.72) 74%,rgba(28,6,16,.96) 100%),
      linear-gradient(118deg,rgba(173,44,77,.82) 0%,rgba(140,15,55,.48) 48%,rgba(40,8,22,.4) 100%);
  }
  /* soft gold aura glow borrowed from depth */
  .m1hero__glow{
    position:absolute;z-index:2;top:-160px;right:-120px;width:560px;height:560px;border-radius:50%;
    filter:blur(80px);pointer-events:none;
    background:radial-gradient(circle,rgba(196,154,72,.4),transparent 68%);
  }
  .m1hero__inner{position:relative;z-index:3;color:#fff;padding-top:96px;padding-bottom:200px;max-width:var(--max)}

  /* gold PILL — fully visible, never clipped */
  .m1pill{
    display:inline-flex;align-items:center;gap:8px;white-space:nowrap;max-width:100%;
    background:linear-gradient(135deg,#e3bd6a,#a47f38);color:#3a2a08;
    font-weight:800;font-size:13px;letter-spacing:.02em;line-height:1;
    padding:10px 19px;border-radius:999px;
    box-shadow:0 12px 30px -10px rgba(164,127,56,.7),0 1px 0 rgba(255,255,255,.4) inset;
    margin-bottom:26px;
  }
  .m1pill__star{font-size:11px;opacity:.95}
  .m1pill--solid{margin-bottom:22px}
  @media(max-width:430px){.m1pill{white-space:normal;text-align:left}}

  .m1title{
    font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;
    font-size:clamp(46px,8.4vw,98px);line-height:1.0;letter-spacing:-.035em;
    margin:0 0 22px;max-width:15ch;
    text-shadow:0 2px 44px rgba(28,6,16,.5);
  }
  .m1grad{
    background:linear-gradient(100deg,#ffd98a,#ffb4c4);
    -webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;
  }
  .m1sub{
    font-size:clamp(18px,2.2vw,24px);line-height:1.5;
    color:rgba(255,255,255,.94);max-width:34em;margin:0 0 32px;
    text-shadow:0 1px 22px rgba(28,6,16,.45);
  }
  .m1cta{display:flex;gap:14px;flex-wrap:wrap;margin-bottom:30px}
  .m1cta--center{justify-content:center;margin-bottom:0}
  .m1trust{display:flex;align-items:center;gap:16px;flex-wrap:wrap;color:rgba(255,255,255,.88);font-size:14px}
  .m1trust b{color:#fff}
  .m1dot{width:4px;height:4px;border-radius:50%;background:rgba(255,255,255,.5)}

  /* scroll cue */
  .m1scroll{position:absolute;bottom:200px;left:50%;transform:translateX(-50%);z-index:3;
    width:26px;height:42px;border:2px solid rgba(255,255,255,.5);border-radius:14px;display:grid;justify-items:center;padding-top:7px}
  .m1scroll span{width:4px;height:8px;border-radius:3px;background:#fff;display:block}
  @media (prefers-reduced-motion: no-preference){
    .m1scroll span{animation:m1bob 1.6s ease-in-out infinite}
    @keyframes m1bob{0%,100%{transform:translateY(0);opacity:1}60%{transform:translateY(12px);opacity:.2}}
  }

  /* ---------- 2. DEPTH GLASS DECK overlapping hero bottom (adapted from depth.astro) ---------- */
  /* sits on the dark base of the hero, pulled up to overlap the bottom edge */
  .m1overlap{
    position:relative;z-index:4;
    background:linear-gradient(180deg,#1c0610 0%,#1c0610 46%,var(--bg) 46%,var(--bg) 100%);
    margin-top:-150px;padding-top:0;
  }
  .m1deck{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;align-items:stretch;padding-bottom:8px}
  .m1card{
    position:relative;border-radius:22px;padding:26px;color:#fff;
    background:var(--glass);border:1px solid var(--glass-line);backdrop-filter:blur(18px);
    box-shadow:0 40px 90px -36px rgba(0,0,0,.78),0 1px 0 rgba(255,255,255,.22) inset;
    transition:transform .25s,box-shadow .28s,border-color .2s;
  }
  .m1card:hover{transform:translateY(-7px);border-color:rgba(255,255,255,.34);box-shadow:0 52px 110px -36px rgba(0,0,0,.85)}
  @media (prefers-reduced-motion: no-preference){
    .m1card{animation:m1float 8s ease-in-out infinite}
    .m1card--track{animation-delay:.6s}
    .m1card--cost{animation-delay:1.2s}
    @keyframes m1float{0%,100%{transform:translateY(0)}50%{transform:translateY(-9px)}}
    .m1card:hover{animation-play-state:paused}
  }

  /* credentials card */
  .m1card-tag{font-size:11px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:rgba(255,255,255,.74);margin-bottom:16px}
  .m1logos{display:flex;flex-wrap:wrap;gap:10px}
  .m1logos span{font-family:'Plus Jakarta Sans';font-weight:800;font-size:15px;color:rgba(255,255,255,.94);
    background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.18);padding:6px 12px;border-radius:10px}
  .m1card-foot{margin-top:18px;font-size:13px;color:rgba(255,255,255,.78)}

  /* live pathway tracker */
  .m1track-row{display:flex;align-items:center;justify-content:space-between}
  .m1track-row small{font-size:12px;text-transform:uppercase;letter-spacing:.08em;color:rgba(255,255,255,.74);font-weight:700}
  .m1live{display:inline-flex;align-items:center;gap:6px;font-size:12px;font-weight:700;color:#fff;
    background:rgba(74,155,79,.32);border:1px solid rgba(120,220,130,.42);padding:4px 10px;border-radius:999px}
  .m1live::before{content:"";width:7px;height:7px;border-radius:50%;background:#7fe389;box-shadow:0 0 8px #7fe389}
  .m1track-big{font-family:'Plus Jakarta Sans';font-weight:800;font-size:23px;margin:10px 0 18px}
  .m1track{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}
  .m1track i{height:8px;border-radius:5px;background:rgba(255,255,255,.2)}
  .m1track i.t-done{background:linear-gradient(90deg,#e3bd6a,#fff)}
  .m1track i.t-now{background:#fff;box-shadow:0 0 12px rgba(255,255,255,.8)}
  .m1track-labels{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:9px}
  .m1track-labels span{font-size:11px;color:rgba(255,255,255,.72);text-align:center}

  /* $0 / reviewed card */
  .m1cost-head{display:flex;align-items:flex-start;gap:13px;margin-bottom:18px}
  .m1ic-check{flex-shrink:0;width:38px;height:38px;border-radius:11px;display:grid;place-items:center;
    background:rgba(74,155,79,.32);border:1px solid rgba(120,220,130,.42);color:#caffce;font-weight:800;font-size:17px}
  .m1cost-head b{display:block;font-weight:700;font-size:15px}
  .m1cost-head span{font-size:13px;color:rgba(255,255,255,.78)}
  .m1meter{display:flex;align-items:baseline;justify-content:space-between;padding:14px 16px;border-radius:13px;
    background:rgba(0,0,0,.22);border:1px solid rgba(255,255,255,.12);margin-bottom:14px}
  .m1meter span{font-size:13px;color:rgba(255,255,255,.8)}
  .m1meter strong{font-family:'Plus Jakarta Sans';font-weight:800;font-size:26px;color:#f3d28f}
  .m1chips{display:flex;flex-wrap:wrap;gap:8px}
  .m1chips span{font-size:12px;font-weight:700;padding:6px 12px;border-radius:999px;
    background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.18)}

  @media(max-width:900px){
    .m1deck{grid-template-columns:1fr;gap:18px}
    .m1overlap{background:linear-gradient(180deg,#1c0610 0%,#1c0610 70%,var(--bg) 70%,var(--bg) 100%);margin-top:-120px}
  }

  /* ---------- 3. CERT PARTNERS strip (adapted from bold.astro) ---------- */
  .m1creds{background:var(--surface);border-top:3px solid var(--gold);border-bottom:1px solid var(--border);padding:42px 0}
  .m1creds-lab{text-align:center;color:var(--muted);font-size:12px;font-weight:800;letter-spacing:.16em;text-transform:uppercase;margin-bottom:18px}
  .m1creds-row{display:flex;align-items:center;justify-content:center;gap:clamp(24px,5vw,56px);flex-wrap:wrap}
  .m1logo{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:clamp(22px,3vw,30px);color:#3a3331}
  .m1creds-extra{color:var(--gold-dark);font-weight:800;font-size:16px}

  /* ---------- 4–6. BOLD alternating full-bleed blocks (adapted from bold.astro) ---------- */
  .m1blk{width:100vw;left:50%;right:50%;margin-left:-50vw;margin-right:-50vw;position:relative;padding:96px 0}
  .m1blk__in{max-width:var(--max)}
  .m1blk--crimson{background:var(--grad);color:#fff;overflow:hidden}
  .m1blk--crimson::after{content:"";position:absolute;inset:0;
    background:url('https://www.workforceap.org/images/hero-people.webp') center/cover;opacity:.09;mix-blend-mode:luminosity;pointer-events:none}
  .m1blk--crimson > .wrap{position:relative;z-index:1}
  .m1blk--cream{background:var(--bg);color:var(--text)}

  .m1gold{color:#e9c879}

  /* heads */
  .m1head{margin-bottom:56px;max-width:760px}
  .m1head h2{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:clamp(38px,6vw,76px);line-height:.96;letter-spacing:-.03em}
  .m1head p{margin-top:18px;font-size:19px;line-height:1.55;color:rgba(255,255,255,.85);max-width:44em}
  .m1head--light p{color:rgba(255,255,255,.85)}
  .m1kick{display:inline-block;font-size:13px;font-weight:800;letter-spacing:.16em;text-transform:uppercase;margin-bottom:18px}
  .m1head--light .m1kick{color:#e9c879}
  .m1kick--crimson{color:var(--crimson)}

  /* journey — huge numbered steps */
  .m1journey{display:grid;grid-template-columns:repeat(4,1fr);gap:0;border-top:1px solid rgba(255,255,255,.25)}
  .m1step{padding:36px 28px 36px 28px;border-left:1px solid rgba(255,255,255,.25);color:#fff;display:block;transition:background .2s}
  .m1step:first-child{border-left:0;padding-left:0}
  a.m1step:hover{background:rgba(255,255,255,.07)}
  .m1num{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:64px;line-height:1;color:#e9c879;display:block;margin-bottom:18px}
  .m1step h3{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:24px;margin-bottom:10px}
  .m1step p{color:rgba(255,255,255,.88);font-size:15px;line-height:1.5}

  /* tri cards */
  .m1tri{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
  .m1tcard{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:34px 30px;box-shadow:var(--shadow);border-top:6px solid var(--crimson);transition:transform .2s,box-shadow .25s}
  .m1tcard:hover{transform:translateY(-5px);box-shadow:var(--shadow-lg)}
  .m1tcard:nth-child(2){border-top-color:var(--blue)}
  .m1tcard:nth-child(3){border-top-color:var(--gold)}
  .m1tcard-tag{display:inline-flex;font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:22px;margin-bottom:14px}
  .m1tcard-tag--c{color:var(--crimson)}
  .m1tcard-tag--b{color:var(--blue)}
  .m1tcard-tag--g{color:var(--gold-dark)}
  .m1tcard p{color:var(--muted);font-size:16px;line-height:1.55;margin-bottom:20px}
  .m1tlink{font-weight:800;color:var(--crimson);font-size:15px}
  .m1tcard:nth-child(2) .m1tlink{color:var(--blue)}
  .m1tcard:nth-child(3) .m1tlink{color:var(--gold-dark)}
  .m1truth{max-width:720px;margin:36px auto 0;text-align:center;color:var(--muted);font-size:14px;background:var(--surface-2);border:1px dashed var(--border);border-radius:14px;padding:18px 22px}
  .m1truth a{color:var(--crimson);font-weight:800}

  /* big-number facts */
  .m1facts{display:grid;grid-template-columns:repeat(4,1fr);gap:32px;text-align:center}
  .m1fact .m1fk{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:clamp(40px,6vw,72px);color:#e9c879;line-height:1}
  .m1fact p{color:rgba(255,255,255,.9);font-size:15px;margin-top:10px}

  /* ---------- 7. IMMERSIVE CLOSING CTA (adapted from immersive.astro) ---------- */
  .m1close{position:relative;overflow:hidden;width:100vw;left:50%;right:50%;margin-left:-50vw;margin-right:-50vw;padding:0}
  .m1close__media{position:absolute;inset:0;background:url('https://www.workforceap.org/images/hero-people.webp') center 40%/cover no-repeat}
  .m1close__veil{position:absolute;inset:0;
    background:linear-gradient(120deg,rgba(173,44,77,.93) 0%,rgba(140,15,55,.9) 50%,rgba(74,14,38,.94) 100%)}
  .m1close__inner{position:relative;z-index:2;color:#fff;text-align:center;padding:96px 24px 104px;max-width:var(--max)}
  .m1close__inner .m1pill{margin-left:auto;margin-right:auto}
  .m1close__inner h2{font-family:'Plus Jakarta Sans';font-weight:800;font-size:clamp(32px,4.8vw,58px);line-height:1.04;letter-spacing:-.02em;margin-bottom:14px}
  .m1close__inner p{font-size:19px;color:rgba(255,255,255,.92);max-width:36em;margin:0 auto 28px}

  /* ---------- responsive ---------- */
  @media(max-width:980px){
    .m1journey{grid-template-columns:1fr 1fr;border-top:0}
