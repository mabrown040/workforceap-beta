        "using": null,
        "check": "((reviewer_id = NULLIF(current_setting('app.current_user_id'::text, true), ''::text)) AND (EXISTS ( SELECT 1\n   FROM member_lab_submissions s\n  WHERE ((s.id = member_lab_reviews.submission_id) AND lab_actor_can_review(s.user_id, s.organization_id)))))"
      }
