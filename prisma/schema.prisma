// --- Partner Portal ---

model Partner {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  slug           String   @unique // e.g. "workforce-solutions-austin"
  referralCode   String   @unique @map("referral_code")
  logoUrl        String?  @map("logo_url")
  brandColor     String?  @map("brand_color") // hex string (e.g. #1E3A8A); partner-scoped accent in portal header
  contactName    String?  @map("contact_name")
  contactEmail   String?  @map("contact_email")
  contactPhone   String?  @map("contact_phone")
  active         Boolean  @default(true)
  notes          String?  @db.Text // internal admin notes
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  status                String    @default("pending_approval") @map("status") // pending_approval, active, rejected, inactive
  approvalNotes         String?   @map("approval_notes") @db.Text
  approvedAt            DateTime? @map("approved_at")
  approvedById          String?   @map("approved_by_id")
  rejectedAt            DateTime? @map("rejected_at")
  rejectedById          String?   @map("rejected_by_id")
  rejectionNotes        String?   @map("rejection_notes") @db.Text
  notifyOnEnrollment    Boolean   @default(true) @map("notify_on_enrollment")
  notifyOnCourse        Boolean   @default(false) @map("notify_on_course")
  notifyOnCertified     Boolean   @default(true) @map("notify_on_certified")
  notifyOnPlaced        Boolean   @default(true) @map("notify_on_placed")
  onboardingCompletedAt DateTime? @map("onboarding_completed_at")
  tourCompletedAt       DateTime? @map("tour_completed_at")
  organizationType      String?   @map("organization_type")
  // Two-tier taxonomy distinguishing partners who receive payouts (`referral`) from
  // those who don't (`community`). Defaults to `community` so newly created or
  // imported partners can never trigger payouts until an admin explicitly upgrades
  // them. Additional values (e.g. training_center, public_agency, funder) can be
  // added later — keep the existing two as a stable gating boundary. Stored as a
  // free-form text column (no Postgres enum) to match the `status` column convention.
  partnerType           String    @default("community") @map("partner_type")
  stripeConnectId       String?   @map("stripe_connect_id")
  stripeConnectStatus   String?   @map("stripe_connect_status")

  counselors           Counselor[]
  referrals            PartnerReferral[]
  partnerUsers         PartnerUser[]
  subgroups            Subgroup[]
  outreachLogs         PartnerOutreachLog[]
  workflowEvents       PortalWorkflowEvent[]
  referredApplications Application[]
  messageThread        MessageThread?
  invitations          Invitation[]

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([partnerType])
  @@map("partners")
}

model PartnerUser {
  id        String   @id @default(uuid())
  partnerId String   @map("partner_id")
  userId    String   @unique @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([partnerId])
  @@map("partner_users")
}

model Counselor {
  id        String   @id @default(uuid())
  // Affiliation distinguishes WorkforceAP staff counselors, partner-org
  // counselors, and independent advisors who work on their own.
  affiliation CounselorAffiliation @default(wap_staff) @map("affiliation")
  // Null partnerId = not affiliated with a partner org (wap_staff or independent)
  partnerId String?  @map("partner_id")
  userId    String   @unique @map("user_id") // links to User (must have role = counselor)
  title     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  partner     Partner?              @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments CounselorAssignment[]

  @@index([partnerId])
  @@index([affiliation])
  @@map("counselors")
}

enum CounselorAffiliation {
  wap_staff
  partner
  independent

  @@map("counselor_affiliations")
}

model CounselorAssignment {
  id          String   @id @default(uuid())
  counselorId String   @map("counselor_id")
  memberId    String   @map("member_id") // User.id of the student
  assignedAt  DateTime @default(now()) @map("assigned_at")
  active      Boolean  @default(true)
  notes       String?  @db.Text

  counselor Counselor @relation(fields: [counselorId], references: [id], onDelete: Cascade)
  member    User      @relation("MemberAssignments", fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([counselorId, memberId])
  @@index([counselorId])
  @@index([memberId])
  @@index([memberId, active])
  @@index([counselorId, active])
  @@index([memberId, active, assignedAt(sort: Desc)])
  @@map("counselor_assignments")
}

enum MessageThreadKind {
  member
  employer
  partner

  @@map("message_thread_kind")
}

// Portal ↔ team chat: member–counselor, employer–admin, partner–admin (Realtime on messages + message_threads)
model MessageThread {
  id                   String            @id @default(uuid())
  kind                 MessageThreadKind @default(member) @map("kind")
  memberId             String?           @unique @map("member_id")
  employerId           String?           @unique @map("employer_id")
  partnerId            String?           @unique @map("partner_id")
  counselorUserId      String?           @map("counselor_user_id")
  memberLastReadAt     DateTime?         @map("member_last_read_at")
  counselorLastReadAt  DateTime?         @map("counselor_last_read_at")
  portalUserLastReadAt DateTime?         @map("portal_user_last_read_at")
  staffLastReadAt      DateTime?         @map("staff_last_read_at")
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")

  member      User?     @relation("MemberMessageThreads", fields: [memberId], references: [id], onDelete: Cascade)
  employer    Employer? @relation(fields: [employerId], references: [id], onDelete: Cascade)
  partner     Partner?  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  counselor   User?     @relation("CounselorMessageThreads", fields: [counselorUserId], references: [id], onDelete: SetNull)
  staffUserId String?   @map("staff_user_id")
  staffUser   User?     @relation("StaffPortalMessageThreads", fields: [staffUserId], references: [id], onDelete: SetNull)
  messages    Message[]

  @@index([counselorUserId])
  @@index([kind])
  @@index([staffUserId])
  @@index([kind, createdAt])
  @@map("message_threads")
}

model Message {
  id        String   @id @default(uuid())
  threadId  String   @map("thread_id")
  authorId  String?  @map("author_id")
  body      String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  thread MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author User?          @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([threadId, createdAt])
  @@index([authorId, createdAt(sort: Desc)])
  @@map("messages")
}

model PartnerReferral {
