---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="WorkforceAP — Empowering People. Advancing Futures.">
<div class="sw">

  <!-- HERO -->
  <section class="sw-hero">
    <div class="wrap">
      <div class="sw-hero-grid">
        <div class="sw-hero-l">
          <span class="sw-idx">01 / Mission</span>
          <h1 class="sw-h1">Empowering People.<br><span class="sw-accent">Advancing Futures.</span></h1>
          <p class="sw-lede">Employer-aligned training, professional certificates, and real career support — at no cost to qualifying members.</p>
          <div class="sw-cta">
            <a class="sw-btn sw-btn--solid" href="/apply">Start your application</a>
            <a class="sw-btn sw-btn--line" href="/find-your-path">Find your path</a>
          </div>
          <span class="sw-pill">501(c)(3) nonprofit</span>
        </div>
        <div class="sw-hero-r">
          <dl class="sw-keys">
            <div class="sw-key">
              <dt>Established</dt>
              <dd>25+ <span>years in workforce development</span></dd>
            </div>
            <div class="sw-key">
              <dt>Member cost</dt>
              <dd>$0 <span>for qualifying members</span></dd>
            </div>
            <div class="sw-key">
              <dt>Review</dt>
              <dd>1–2 <span>business days, by a real team</span></dd>
            </div>
            <div class="sw-key">
              <dt>Application</dt>
              <dd>~5 <span>minutes to apply</span></dd>
            </div>
          </dl>
        </div>
      </div>
    </div>
  </section>

  <!-- HERO IMAGE STRIP -->
  <section class="sw-strip">
    <div class="wrap">
      <figure class="sw-figure">
        <img src="https://www.workforceap.org/images/hero-people.webp" alt="People advancing their careers through WorkforceAP" loading="lazy" />
        <figcaption><span class="sw-tick"></span>Real members. Real career support.</figcaption>
      </figure>
    </div>
  </section>

  <!-- CERT PARTNERS -->
  <section class="sw-row">
    <div class="wrap">
      <div class="sw-row-grid">
        <span class="sw-idx">02 / Credentials</span>
        <div class="sw-logos">
          <span class="sw-label">Employer-recognized certificates you can earn</span>
          <ul>
            <li>IBM</li><li>Google</li><li>Microsoft</li><li>AWS</li><li>CompTIA</li>
          </ul>
          <span class="sw-meta">+ CPT &amp; CLT</span>
        </div>
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="sw-how">
    <div class="wrap">
      <div class="sw-sec-head">
        <span class="sw-idx">03 / Process</span>
        <h2 class="sw-h2">From application to launch in four steps.</h2>
      </div>
      <ol class="sw-steps">
        <li>
          <span class="sw-num">01</span>
          <h3>Apply</h3>
          <p>About five minutes. No cost for qualifying members — a real team reviews it.</p>
        </li>
        <li>
          <span class="sw-num">02</span>
          <h3>Get matched</h3>
          <p>We match you to the program track that fits your goals and background.</p>
        </li>
        <li>
          <span class="sw-num">03</span>
          <h3>Train &amp; certify</h3>
          <p>Build job-ready skills and earn an employer-recognized professional certificate.</p>
        </li>
        <li>
          <span class="sw-num">04</span>
          <h3>Launch</h3>
          <p>Move into the workforce with resume, interview, and mentor support behind you.</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- WHO WE SERVE -->
  <section class="sw-serve">
    <div class="wrap">
      <div class="sw-sec-head">
        <span class="sw-idx">04 / Network</span>
        <h2 class="sw-h2">Built for members, employers &amp; partners.</h2>
      </div>
      <div class="sw-serve-grid">
        <article>
          <span class="sw-tag">Members</span>
          <p>No-cost, employer-aligned training, professional certificates, and a team that supports you to job-ready.</p>
          <a href="/apply">Start your application</a>
        </article>
        <article>
          <span class="sw-tag">Employers</span>
          <p>Build a pipeline of training-aligned candidates for in-demand roles — no per-placement fees.</p>
          <a href="/employers">Talk with us about hiring</a>
        </article>
        <article>
          <span class="sw-tag">Partners</span>
          <p>Extend workforce impact in your community through referral and program partnerships.</p>
          <a href="/partners">Explore partnership</a>
        </article>
      </div>
      <p class="sw-truth">We're a nonprofit, so we don't inflate outcomes. We publish verified placement data as cohorts complete, with the methodology shown.</p>
    </div>
  </section>

  <!-- CLOSING CTA -->
  <section class="sw-end">
    <div class="wrap">
      <div class="sw-end-grid">
        <div>
          <span class="sw-idx">05 / Next step</span>
          <h2 class="sw-h2">Your next step starts with one application.</h2>
          <p class="sw-lede">Apply in about five minutes — no cost for qualifying members. A real team reviews it and follows up in one to two business days.</p>
        </div>
        <div class="sw-end-acts">
          <a class="sw-btn sw-btn--solid" href="/apply">Start your application</a>
          <a class="sw-btn sw-btn--line" href="/find-your-path">Find your path</a>
          <a class="sw-btn sw-btn--line" href="/employers">For employers</a>
        </div>
      </div>
    </div>
  </section>

</div>
</Layout>

<style>
  /* ============================================================
     MINIMAL — Swiss. Hairlines, whitespace, one crimson accent.
     Scoped to .sw so it never touches the shared chrome.
     ============================================================ */
  .sw{background:var(--bg);color:var(--text)}
  .sw .wrap{max-width:1120px;margin:0 auto;padding:0 32px}

  /* small precise index labels (the Swiss tell) */
  .sw-idx{
    display:inline-block;font-size:11px;font-weight:600;letter-spacing:.22em;
    text-transform:uppercase;color:var(--muted);
  }
  .sw-label{
    font-size:11px;font-weight:600;letter-spacing:.18em;text-transform:uppercase;color:var(--muted);
  }

  /* type */
  .sw-h1{
    font-family:'Plus Jakarta Sans',sans-serif;font-weight:700;
    font-size:clamp(40px,6.4vw,76px);line-height:1.02;letter-spacing:-.03em;
    margin:22px 0 0;
  }
  .sw-accent{color:var(--crimson)}
  .sw-h2{
    font-family:'Plus Jakarta Sans',sans-serif;font-weight:700;
    font-size:clamp(26px,3.6vw,42px);line-height:1.06;letter-spacing:-.02em;
    margin:16px 0 0;max-width:16em;
  }
  .sw-lede{
    font-size:19px;line-height:1.55;color:var(--text);max-width:30em;margin:24px 0 0;
  }

  /* gold pill — clearly gold, fully visible */
  .sw-pill{
    display:inline-flex;align-items:center;gap:7px;margin-top:34px;
    font-size:12px;font-weight:700;letter-spacing:.04em;line-height:1;
    color:#fff;padding:9px 16px;border-radius:999px;
    background:linear-gradient(135deg,#cda44e,#9a7733);
    box-shadow:0 8px 22px -10px rgba(164,127,56,.65);
  }
  .sw-pill::before{content:"★";font-size:11px;opacity:.95}

  /* buttons — square-ish, hairline, minimal */
  .sw-cta{display:flex;gap:14px;flex-wrap:wrap;margin-top:36px}
  .sw-btn{
    display:inline-flex;align-items:center;font-size:15px;font-weight:600;
    padding:14px 26px;border-radius:4px;border:1px solid var(--text);
    transition:background .18s,color .18s,border-color .18s;
  }
  .sw-btn--solid{background:var(--crimson);border-color:var(--crimson);color:#fff}
  .sw-btn--solid:hover{background:var(--accent-dark);border-color:var(--accent-dark)}
  .sw-btn--line{background:transparent;color:var(--text)}
  .sw-btn--line:hover{background:var(--text);color:var(--bg)}

  /* HERO */
  .sw-hero{padding:80px 0 64px;border-bottom:1px solid var(--border)}
  .sw-hero-grid{
    display:grid;grid-template-columns:1.4fr .9fr;gap:64px;align-items:end;
  }
  .sw-hero-r{padding-bottom:6px}

  /* key facts as a definition list, hairline-divided */
  .sw-keys{display:grid;gap:0;border-top:1px solid var(--text)}
  .sw-key{
    display:flex;align-items:baseline;justify-content:space-between;gap:18px;
    padding:18px 0;border-bottom:1px solid var(--border);
  }
  .sw-key dt{
    font-size:11px;font-weight:600;letter-spacing:.16em;text-transform:uppercase;
    color:var(--muted);flex-shrink:0;
  }
  .sw-key dd{
    text-align:right;font-family:'Plus Jakarta Sans',sans-serif;font-weight:700;
    font-size:30px;line-height:1;color:var(--text);
  }
  .sw-key dd span{
    display:block;font-family:'Inter',sans-serif;font-weight:400;font-size:12px;
    color:var(--muted);letter-spacing:0;margin-top:6px;line-height:1.3;
  }

  /* IMAGE STRIP */
  .sw-strip{padding:64px 0;border-bottom:1px solid var(--border)}
  .sw-figure{margin:0}
  .sw-figure img{
    display:block;width:100%;height:clamp(260px,40vw,440px);object-fit:cover;
    filter:grayscale(.18);border:1px solid var(--border);
  }
  .sw-figure figcaption{
    display:flex;align-items:center;gap:10px;margin-top:14px;
    font-size:12px;letter-spacing:.06em;text-transform:uppercase;
    font-weight:600;color:var(--muted);
  }
  .sw-tick{width:8px;height:8px;background:var(--crimson);display:inline-block;flex-shrink:0}

  /* CERT ROW */
  .sw-row{padding:56px 0;border-bottom:1px solid var(--border)}
  .sw-row-grid{display:grid;grid-template-columns:160px 1fr;gap:48px;align-items:start}
  .sw-logos{display:flex;flex-direction:column;gap:18px}
  .sw-logos ul{
    list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;
    gap:0;border-top:1px solid var(--border);
  }
  .sw-logos li{
    font-family:'Plus Jakarta Sans',sans-serif;font-weight:700;font-size:24px;
    color:var(--text);letter-spacing:-.01em;
    padding:20px 36px 20px 0;border-bottom:1px solid var(--border);
    flex:1 1 auto;min-width:120px;
  }
  .sw-meta{font-size:13px;font-weight:600;color:var(--gold-dark);letter-spacing:.04em}

  /* HOW IT WORKS */
  .sw-how{padding:80px 0;border-bottom:1px solid var(--border)}
  .sw-sec-head{margin-bottom:48px}
  .sw-steps{
    list-style:none;margin:0;padding:0;
    display:grid;grid-template-columns:repeat(4,1fr);
    border-top:1px solid var(--text);
  }
  .sw-steps li{
    padding:32px 28px 36px 0;border-bottom:1px solid var(--border);
    border-right:1px solid var(--border);
  }
  .sw-steps li:last-child{border-right:0}
  .sw-num{
    font-family:'Plus Jakarta Sans',sans-serif;font-weight:700;font-size:14px;
    color:var(--crimson);letter-spacing:.04em;
  }
  .sw-steps h3{
    font-family:'Plus Jakarta Sans',sans-serif;font-weight:700;font-size:21px;
    margin:22px 0 10px;letter-spacing:-.01em;
  }
  .sw-steps p{font-size:14px;line-height:1.55;color:var(--muted)}

  /* WHO WE SERVE */
  .sw-serve{padding:80px 0;border-bottom:1px solid var(--border)}
  .sw-serve-grid{
    display:grid;grid-template-columns:repeat(3,1fr);gap:0;
    border-top:1px solid var(--text);
  }
  .sw-serve-grid article{
    padding:36px 32px 36px 0;border-bottom:1px solid var(--border);
    border-right:1px solid var(--border);
    display:flex;flex-direction:column;align-items:flex-start;
  }
  .sw-serve-grid article:last-child{border-right:0}
  .sw-tag{
    font-size:11px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;
    color:var(--crimson);
  }
  .sw-serve-grid p{font-size:15px;line-height:1.55;color:var(--text);margin:18px 0 24px}
  .sw-serve-grid a{
    font-size:14px;font-weight:600;color:var(--text);
    border-bottom:1px solid var(--crimson);padding-bottom:2px;
    transition:color .15s;margin-top:auto;
  }
  .sw-serve-grid a:hover{color:var(--crimson)}
  .sw-truth{
    margin-top:40px;max-width:46em;font-size:13px;line-height:1.6;
    color:var(--muted);border-left:2px solid var(--gold);padding-left:18px;
  }

  /* CLOSING */
  .sw-end{padding:88px 0}
  .sw-end-grid{
    display:grid;grid-template-columns:1.3fr .7fr;gap:56px;align-items:end;
  }
  .sw-end-acts{display:flex;flex-direction:column;gap:12px;align-items:stretch}
  .sw-end-acts .sw-btn{justify-content:center}

  /* RESPONSIVE */
  @media(max-width:880px){
    .sw .wrap{padding:0 22px}
    .sw-hero{padding:56px 0 48px}
    .sw-hero-grid{grid-template-columns:1fr;gap:48px;align-items:start}
    .sw-row-grid{grid-template-columns:1fr;gap:24px}
    .sw-steps{grid-template-columns:1fr 1fr}
    .sw-steps li{border-right:0;padding-right:24px}
    .sw-steps li:nth-child(odd){border-right:1px solid var(--border)}
    .sw-serve-grid{grid-template-columns:1fr}
    .sw-serve-grid article{border-right:0;padding-right:0}
    .sw-end-grid{grid-template-columns:1fr;gap:36px;align-items:start}
  }
  @media(max-width:560px){
    .sw-steps{grid-template-columns:1fr}
    .sw-steps li:nth-child(odd){border-right:0}
    .sw-key dd{font-size:26px}
    .sw-logos li{padding-right:0;min-width:0;flex-basis:50%}
  }
</style>
