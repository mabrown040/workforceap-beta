// --- Pipeline & Placement Tracking ---

/// Canonical placement record — single source of truth for operational
/// tracking AND WIOA/grant reporting. All placement surfaces (partner
/// pipeline, admin placements, weekly digest, outcome reporting) read
/// from this model.
///
/// INVARIANT: There is exactly one PlacementRecord per member (unique on
/// userId). Edits create a new MemberEvent for audit trail.
model PlacementRecord {
  id            String    @id @default(uuid())
  userId        String    @unique @map("user_id")
  employerName  String    @map("employer_name")
  jobTitle      String    @map("job_title")
  startDate     DateTime? @map("start_date") @db.Date
  salaryOffered Int?      @map("salary_offered") // annual, in whole dollars — wage at placement
  placedAt      DateTime  @default(now()) @map("placed_at")
  placedBy      String?   @map("placed_by") // counselor or admin userId
  notes         String?   @db.Text
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // ── WIOA / grant-reporting fields (all optional until reporting is live) ──
  programSlug         String? @map("program_slug")
  wageAtFollowUp      Int?    @map("wage_at_follow_up") // annual, 90/180-day follow-up
  retentionStatus     String? @map("retention_status") // e.g. "retained_90d", "retained_180d", "separated"
  /// End of employer/program onboarding window (e.g. 6 months from placement).
  onboardingWindowEnd DateTime? @db.Date @map("onboarding_window_end")
  /// Counselor-recorded outcome after window: retained | not_retained | pending
  retentionDecision   String?   @map("retention_decision")
  startDateVerified   Boolean @default(false) @map("start_date_verified")
  fundingSource       String? @map("funding_source") // e.g. "WIOA_Adult", "WIOA_Youth", "TAA"
  grantReportingNotes String? @map("grant_reporting_notes") @db.Text

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  placementSurveys PlacementSurvey[]

  @@index([placedAt])
  @@map("placement_records")
}

/// @deprecated Use PlacementRecord with WIOA/grant fields instead.
/// Kept for backward compatibility during migration. New code should
/// write to PlacementRecord and read grant fields from there.
model PlacedOutcome {
  id             String   @id @default(uuid())
  userId         String   @unique @map("user_id")
  employerName   String   @map("employer_name")
  jobTitle       String   @map("job_title")
  startingSalary Int?     @map("starting_salary")
  placedAt       DateTime @default(now()) @map("placed_at")
  programSlug    String?  @map("program_slug")
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([placedAt])
  @@map("placed_outcomes")
}

model PartnerSignupRequest {
