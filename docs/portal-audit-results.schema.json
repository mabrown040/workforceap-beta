{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workforceap.org/schemas/portal-audit-results.schema.json",
  "title": "WorkforceAP five-role portal audit result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "status",
    "baseURL",
    "generatedAt",
    "completedAt",
    "requestedSections",
    "viewports",
    "targetValidation",
    "inventory",
    "credentialValidation",
    "executionPolicy",
    "accessMatrix",
    "roles",
    "summary",
    "fatalError"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "2.0.0" },
    "status": { "enum": ["passed", "partial", "failed", "blocked"] },
    "baseURL": { "type": ["string", "null"] },
    "generatedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": ["string", "null"], "format": "date-time" },
    "requestedSections": {
      "type": "array",
      "items": { "$ref": "#/$defs/roleName" },
      "uniqueItems": true
    },
    "viewports": {
      "type": "array",
      "items": { "$ref": "#/$defs/viewport" },
      "maxItems": 2
    },
    "targetValidation": {
      "type": "object",
      "required": ["ok", "mode", "targetClass", "errors"],
      "properties": {
        "ok": { "type": "boolean" },
        "mode": { "enum": ["local", "isolated_preview", "production_canary", null] },
        "targetClass": { "enum": ["local_loopback", "isolated_preview", "production", null] },
        "errors": { "type": "array", "items": { "type": "string" } }
      }
    },
    "inventory": { "$ref": "#/$defs/inventory" },
    "credentialValidation": {
      "type": "object",
      "required": ["ok", "errors", "sources", "authenticatedIdentitiesDistinct"],
      "properties": {
        "ok": { "type": "boolean" },
        "errors": { "type": "array", "items": { "$ref": "#/$defs/credentialError" } },
        "sources": {
          "type": "object",
          "additionalProperties": { "enum": ["canonical", "legacy", "missing"] }
        },
        "authenticatedIdentitiesDistinct": { "type": ["boolean", "null"] }
      }
    },
    "executionPolicy": {
      "type": "object",
      "required": ["mode", "mutations", "authState", "dynamicRoutes", "routeConcurrency", "deadlineMs"],
      "properties": {
        "mode": { "enum": ["local", "isolated_preview", "production_canary", null] },
        "mutations": { "const": "none" },
        "authState": { "const": "in_memory_per_role" },
        "dynamicRoutes": { "const": "pending_without_safe_discoverable_fixture" },
        "routeConcurrency": { "type": "integer", "minimum": 1, "maximum": 12 },
        "deadlineMs": { "type": ["integer", "null"], "minimum": 1 }
      }
    },
    "accessMatrix": { "$ref": "#/$defs/accessMatrix" },
    "roles": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/roleName" },
      "additionalProperties": { "$ref": "#/$defs/roleResult" }
    },
    "summary": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["totalStaticChecks", "passedStaticChecks", "failedStaticChecks", "failedRoles", "totalAccessProbes", "failedAccessProbes", "pendingDynamicRoutes"],
          "properties": {
            "totalStaticChecks": { "type": "integer", "minimum": 0 },
            "passedStaticChecks": { "type": "integer", "minimum": 0 },
            "failedStaticChecks": { "type": "integer", "minimum": 0 },
            "failedRoles": { "type": "integer", "minimum": 0 },
            "totalAccessProbes": { "type": "integer", "minimum": 0 },
            "failedAccessProbes": { "type": "integer", "minimum": 0 },
            "pendingDynamicRoutes": { "type": "integer", "minimum": 0 }
          }
        }
      ]
    },
    "fatalError": { "type": ["string", "null"] }
  },
  "$defs": {
    "roleName": { "enum": ["member", "admin", "employer", "partner", "counselor"] },
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "width", "height"],
      "properties": {
        "name": { "enum": ["desktop", "mobile"] },
        "width": { "type": "integer" },
        "height": { "type": "integer" }
      }
    },
    "desktopViewport": {
      "allOf": [
        { "$ref": "#/$defs/viewport" },
        { "properties": { "name": { "const": "desktop" }, "width": { "const": 1440 }, "height": { "const": 900 } } }
      ]
    },
    "mobileViewport": {
      "allOf": [
        { "$ref": "#/$defs/viewport" },
        { "properties": { "name": { "const": "mobile" }, "width": { "const": 390 }, "height": { "const": 844 } } }
      ]
    },
    "credentialError": {
      "type": "object",
      "required": ["role", "code", "required"],
      "properties": {
        "role": { "$ref": "#/$defs/roleName" },
        "code": { "enum": ["missing_credentials", "partial_credentials", "reused_identity", "authenticated_identity_reused"] },
        "conflictsWith": { "$ref": "#/$defs/roleName" },
        "required": { "type": "array", "items": { "type": "string" } }
      }
    },
    "inventory": {
      "type": "object",
      "required": ["ok", "generatedAt", "sections", "unexpectedManifestSections"],
      "properties": {
        "ok": { "type": "boolean" },
        "generatedAt": { "type": "string", "format": "date-time" },
        "sections": { "type": "object" },
        "unexpectedManifestSections": { "type": "array", "items": { "type": "string" } }
      }
    },
    "dynamicRoute": {
      "type": "object",
      "required": ["pattern", "status", "reason"],
      "properties": {
        "pattern": { "type": "string" },
        "status": { "const": "pending" },
        "reason": { "const": "requires_discoverable_safe_fixture" }
      }
    },
    "accessProbe": {
      "type": "object",
      "required": ["sourceRole", "targetRole", "expectation", "requestedPath", "finalPathname", "ok"],
      "properties": {
        "sourceRole": { "$ref": "#/$defs/roleName" },
        "targetRole": { "$ref": "#/$defs/roleName" },
        "expectation": { "enum": ["allowed", "denied"] },
        "requestedPath": { "type": "string" },
        "finalPathname": { "type": ["string", "null"] },
        "ok": { "type": "boolean" },
        "error": { "type": "string" }
      }
    },
    "accessMatrix": {
      "type": "object",
      "required": ["policy", "probes", "summary"],
      "properties": {
        "policy": { "type": "object" },
        "probes": { "type": "array", "items": { "$ref": "#/$defs/accessProbe" } },
        "summary": {
          "type": "object",
          "required": ["total", "passed", "failed"],
          "properties": {
            "total": { "type": "integer", "minimum": 0 },
            "passed": { "type": "integer", "minimum": 0 },
            "failed": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "routeRow": {
      "type": "object",
      "required": [
        "role",
        "viewport",
        "path",
        "finalUrl",
        "queryVariantMatched",
        "documentStatus",
        "failureReasons",
        "ok",
        "h1Count",
        "horizontalOverflowPx",
        "unnamedInteractiveControls"
      ],
      "properties": {
        "role": { "$ref": "#/$defs/roleName" },
        "viewport": { "enum": ["desktop", "mobile"] },
        "path": { "type": "string" },
        "finalUrl": { "type": "string" },
        "queryVariantMatched": { "type": "boolean" },
        "documentStatus": { "type": ["integer", "null"] },
        "failureReasons": { "type": "array", "items": { "type": "string" } },
        "ok": { "type": "boolean" },
        "h1Count": { "type": "integer", "minimum": 0 },
        "horizontalOverflowPx": { "type": "number", "minimum": 0 },
        "unnamedInteractiveControls": { "type": "array", "items": { "type": "object" } }
      }
    },
    "viewportResult": {
      "type": "object",
      "required": ["viewport", "summary", "rows"],
      "properties": {
        "viewport": { "$ref": "#/$defs/viewport" },
        "summary": {
          "type": "object",
          "required": ["total", "passed", "failed"],
          "properties": {
            "total": { "type": "integer" },
            "passed": { "type": "integer" },
            "failed": { "type": "integer" }
          }
        },
        "rows": { "type": "array", "items": { "$ref": "#/$defs/routeRow" } }
      }
    },
    "roleResult": {
      "type": "object",
      "required": ["status", "loginRedirect", "auth", "dynamicRoutes", "accessProbeFailures", "viewports", "error"],
      "properties": {
        "status": { "enum": ["running", "passed", "failed"] },
        "loginRedirect": { "type": "string" },
        "auth": { "type": "object" },
        "dynamicRoutes": { "type": "array", "items": { "$ref": "#/$defs/dynamicRoute" } },
        "accessProbeFailures": { "type": "integer", "minimum": 0 },
        "viewports": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/viewportResult" }
        },
        "error": { "type": ["string", "null"] }
      }
    }
  }
}
