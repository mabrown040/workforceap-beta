---
import Layout from '../layouts/Layout.astro';

// Truth-locked empty state: no articles published yet (mirrors the Next /blog page).
const quickCards = [
  {
    href: '/programs',
    icon: '🎓',
    title: 'Start with Programs',
    sub: '20 career training options',
    cls: 'ic--c',
  },
  {
    href: '/faq',
    icon: '❓',
    title: 'Get Answers Fast',
    sub: 'Common questions answered',
    cls: 'ic--g',
  },
];
---
<Layout
  title="Workforce Development Blog | Career Tips & Training News"
  description="Career tips, program spotlights, success stories, and workforce insights from Workforce Advancement Project. Career training advice, job-readiness guidance, and workforce insights for individuals nationwide."
>
  <!-- Page hero (mirrors PageHero, no-posts branch) -->
  <section class="band band--surface bloghero">
    <div class="wrap" style="text-align:center;max-width:720px">
      <h1>Career <span class="grad-text">Resources</span></h1>
      <p class="bloghero-sub">Use programs, FAQ, and application help while new articles are being published.</p>
    </div>
  </section>

  <section class="band">
    <div class="wrap" style="max-width:980px">
      <!-- Quick resource nav cards -->
      <div class="blog-quick">
        {quickCards.map((c) => (
          <a class="qcard" href={c.href}>
            <span class={`ic ${c.cls}`} aria-hidden="true">{c.icon}</span>
            <span class="qtext">
              <span class="qt">{c.title}</span>
              <span class="qs">{c.sub}</span>
            </span>
            <span class="qarr" aria-hidden="true">→</span>
          </a>
        ))}
      </div>

      <!-- Truthful empty state -->
      <div class="empty-state">
        <span class="empty-ic" aria-hidden="true">📰</span>
        <p>
          No articles are published yet. For now, use the FAQ, browse programs, or
          start your application without waiting on the blog.
        </p>
        <div class="empty-acts">
          <a class="btn btn--primary" href="/programs">Browse programs</a>
          <a class="btn btn--ghost" href="/apply">Apply</a>
          <a class="btn btn--ghost" href="/faq">Read FAQ</a>
        </div>
      </div>

      <!-- Updates via contact -->
      <div class="updates-card">
        <span class="updates-ic" aria-hidden="true">✉️</span>
        <h2>Want updates?</h2>
        <p>
          Ask to be notified about new articles and program news — our team responds
          within a few business days.
        </p>
        <a class="btn btn--primary" href="/contact">Contact us for updates</a>
      </div>
    </div>
  </section>

  <!-- Bottom CTA -->
  <section class="band band--surface">
    <div class="wrap">
      <div class="cta">
        <h2>Ready to take the next step?</h2>
        <p>
          WorkforceAP offers no-cost career training paths for <a href="/apply" style="color:inherit;text-decoration:underline;text-decoration-style:dotted;text-underline-offset:3px">qualifying members</a> — with guided tools, advisor support, and employer-aligned credentials.
        </p>
        <div class="acts">
          <a class="btn btn--light" href="/find-your-path">Find Your Path</a>
          <a class="btn btn--translucent" href="/programs">Explore Programs</a>
          <a class="btn btn--translucent" href="/apply">Apply Now</a>
        </div>
      </div>
    </div>
  </section>

  <style>
    .bloghero { padding-top: 56px; padding-bottom: 40px; }
    .bloghero h1 { font-size: clamp(38px, 5.5vw, 60px); font-weight: 800; margin: 18px 0 14px; }
    .bloghero-sub { color: var(--muted); font-size: 19px; max-width: 34em; margin: 0 auto; }

    /* quick nav cards */
    .blog-quick { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 30px; }
    .qcard {
      display: flex; align-items: center; gap: 16px;
      background: var(--surface); border: 1px solid var(--border);
      border-radius: var(--radius); padding: 22px 24px; box-shadow: var(--shadow);
      transition: transform .18s, box-shadow .2s, border-color .2s;
    }
    .qcard:hover { transform: translateY(-4px); box-shadow: var(--shadow-lg); border-color: rgba(173,44,77,.3); }
    .qcard .ic {
      width: 50px; height: 50px; border-radius: 13px;
      display: grid; place-items: center; font-size: 24px; flex-shrink: 0;
    }
    .qtext { flex: 1; display: flex; flex-direction: column; gap: 3px; }
    .qt { font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 700; font-size: 18px; }
    .qs { color: var(--muted); font-size: 14px; }
    .qarr { color: var(--crimson); font-size: 22px; font-weight: 700; flex-shrink: 0; }

    /* empty state */
    .empty-state {
      text-align: center; background: var(--surface-2);
      border: 1px dashed var(--border); border-radius: var(--radius);
      padding: 44px 28px; margin-bottom: 24px;
    }
    .empty-ic { font-size: 40px; display: block; margin-bottom: 14px; }
    .empty-state p { color: var(--muted); font-size: 17px; max-width: 40em; margin: 0 auto 22px; }
    .empty-acts { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; }

    /* updates card */
    .updates-card {
      text-align: center; background: var(--surface);
      border: 1px solid var(--border); border-radius: var(--radius);
      padding: 40px 28px; box-shadow: var(--shadow);
    }
    .updates-ic {
      width: 60px; height: 60px; border-radius: 16px; margin: 0 auto 16px;
      background: rgba(164,127,56,.14); color: var(--gold-dark);
      display: grid; place-items: center; font-size: 28px;
    }
    .updates-card h2 { font-size: 26px; font-weight: 800; margin-bottom: 10px; }
    .updates-card p { color: var(--muted); font-size: 16px; max-width: 36em; margin: 0 auto 22px; }

    @media (max-width: 760px) {
      .blog-quick { grid-template-columns: 1fr; }
    }
  </style>
</Layout>
