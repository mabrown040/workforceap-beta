---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="WorkforceAP — Empowering People. Advancing Futures.">
<div class="warm">

  <!-- HERO: big warm photo, cream surface, rounded -->
  <section class="wm-hero">
    <div class="wrap wm-hero-grid">
      <div class="wm-hero-copy">
        <span class="wm-pill"><span class="wm-pill-star">★</span> 501(c)(3) nonprofit · Employer-recognized certificates</span>
        <h1>Empowering People.<br><span class="wm-grad">Advancing Futures.</span></h1>
        <p class="wm-sub">Employer-aligned training, professional certificates, and real career support — at no cost to qualifying members.</p>
        <div class="wm-cta">
          <a class="wm-btn wm-btn--primary" href="/apply">Start your application →</a>
          <a class="wm-btn wm-btn--soft" href="/find-your-path">Find your path</a>
        </div>
        <ul class="wm-trust">
          <li><b>25+ years</b> in workforce development</li>
          <li><b>$0</b> for qualifying members</li>
          <li>Reviewed by a <b>real team</b> in 1–2 business days</li>
        </ul>
      </div>

      <div class="wm-hero-media">
        <div class="wm-photo">
          <img src="https://www.workforceap.org/images/hero-people.webp" alt="People supported by WorkforceAP" loading="eager" />
          <div class="wm-photo-card">
            <div class="wm-photo-ring">✓</div>
            <div>
              <strong>Apply in about 5 minutes</strong>
              <span>A real team follows up in 1–2 business days.</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CERT PARTNERS -->
  <section class="wm-creds">
    <div class="wrap">
      <p class="wm-creds-lab">Employer-recognized credentials you can earn</p>
      <div class="wm-creds-row">
        <span>IBM</span><span>Google</span><span>Microsoft</span><span>AWS</span><span>CompTIA</span>
        <em>+ CPT &amp; CLT</em>
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS: 4-step warm journey -->
  <section class="wm-band">
    <div class="wrap">
      <div class="wm-head">
        <span class="wm-eyebrow">Your journey</span>
        <h2>Four warm steps from <span class="wm-grad">apply to launch</span></h2>
        <p>No cost for qualifying members. Real people walking with you the whole way.</p>
      </div>
      <div class="wm-steps">
        <article class="wm-step">
          <div class="wm-step-n">01</div>
          <h3>Apply</h3>
          <p>Takes about 5 minutes. No cost for qualifying members — a real team reviews it.</p>
        </article>
        <article class="wm-step">
          <div class="wm-step-n">02</div>
          <h3>Get matched</h3>
          <p>We match you to the program track that fits your goals and background.</p>
        </article>
        <article class="wm-step">
          <div class="wm-step-n">03</div>
          <h3>Train &amp; certify</h3>
          <p>Build job-ready skills and earn an employer-recognized professional certificate.</p>
        </article>
        <article class="wm-step">
          <div class="wm-step-n">04</div>
          <h3>Launch</h3>
          <p>Move into the workforce with resume, interview, and mentor support behind you.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- WHO WE SERVE: warm rounded cards -->
  <section class="wm-band wm-band--cream">
    <div class="wrap">
      <div class="wm-head">
        <span class="wm-eyebrow">A connected community</span>
        <h2>Built for members, employers &amp; partners</h2>
        <p>One nonprofit network where people, hiring teams, and community partners meet.</p>
      </div>
      <div class="wm-serve">
        <article class="wm-serve-card">
          <div class="wm-serve-ic wm-ic--crimson">👥</div>
          <h3>Members</h3>
          <p>No-cost, employer-aligned training, professional certificates, and a team that supports you to job-ready.</p>
          <a href="/apply">Start your application →</a>
        </article>
        <article class="wm-serve-card">
          <div class="wm-serve-ic wm-ic--blue">🏢</div>
          <h3>Employers</h3>
          <p>Build a pipeline of training-aligned candidates for in-demand roles — no per-placement fees.</p>
          <a href="/employers">Talk with us about hiring →</a>
        </article>
        <article class="wm-serve-card">
          <div class="wm-serve-ic wm-ic--gold">🏛️</div>
          <h3>Partners</h3>
          <p>Extend workforce impact in your community through referral and program partnerships.</p>
          <a href="/partners">Explore partnership →</a>
        </article>
      </div>
      <p class="wm-truth">We're a nonprofit — so we don't inflate outcomes. We publish verified placement data as cohorts complete, with the methodology shown. <a href="/outcomes">See our outcomes →</a></p>
    </div>
  </section>

  <!-- TRUST FACTS -->
  <section class="wm-band">
    <div class="wrap wm-facts">
      <div class="wm-fact"><div class="wm-fact-k">25+ yrs</div><p>In workforce development</p></div>
      <div class="wm-fact"><div class="wm-fact-k">501(c)(3)</div><p>Nonprofit organization</p></div>
      <div class="wm-fact"><div class="wm-fact-k">$0</div><p>For qualifying members</p></div>
      <div class="wm-fact"><div class="wm-fact-k">5</div><p>Employer-recognized cert tracks</p></div>
    </div>
  </section>

  <!-- CLOSING CTA: warm photo wash -->
  <section class="wm-band">
    <div class="wrap">
      <div class="wm-closing">
        <div class="wm-closing-inner">
          <h2>Your next step starts with one application.</h2>
          <p>Apply in about 5 minutes — no cost for qualifying members. A real team reviews it and follows up in 1 to 2 business days.</p>
          <div class="wm-closing-acts">
            <a class="wm-btn wm-btn--light" href="/apply">Start your application</a>
            <a class="wm-btn wm-btn--translucent" href="/find-your-path">Find your path</a>
            <a class="wm-btn wm-btn--translucent" href="/employers">For employers</a>
          </div>
        </div>
      </div>
    </div>
  </section>

</div>

<style>
  /* ===== WARM variant — human, photo-forward, soft cream, rounded ===== */
  .warm{ --warm-cream:#fbf3ec; --warm-tan:#f3e6da; --warm-radius:28px; }

  .warm .wrap{max-width:var(--max);margin:0 auto;padding:0 24px}
  .warm h1,.warm h2,.warm h3{font-family:'Plus Jakarta Sans',sans-serif;letter-spacing:-.02em;line-height:1.08}
  .wm-grad{background:var(--grad-text);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}

  /* gold pill — generous padding, never clipped (no overflow container) */
  .wm-pill{
    display:inline-flex;align-items:center;gap:8px;
    background:linear-gradient(135deg,#cda44e,#9a7733);color:#fff;
    font-weight:800;font-size:13px;letter-spacing:.01em;line-height:1;
    padding:10px 18px;border-radius:999px;
    box-shadow:0 10px 26px -10px rgba(164,127,56,.7);
    max-width:100%;
  }
  .wm-pill-star{font-size:12px;opacity:.95}

  /* buttons */
  .wm-btn{display:inline-flex;align-items:center;gap:8px;font-weight:700;font-size:16px;
    padding:15px 28px;border-radius:16px;border:1px solid transparent;cursor:pointer;
    transition:transform .15s,box-shadow .2s,background .2s}
  .wm-btn:hover{transform:translateY(-2px)}
  .wm-btn--primary{background:var(--grad);color:#fff;box-shadow:0 14px 34px -10px rgba(173,44,77,.5)}
  .wm-btn--soft{background:#fff;border-color:var(--warm-tan);color:var(--accent-dark)}
  .wm-btn--soft:hover{border-color:var(--crimson)}
  .wm-btn--light{background:#fff;color:var(--accent-dark)}
  .wm-btn--translucent{background:rgba(255,255,255,.16);color:#fff;border-color:rgba(255,255,255,.32)}

  /* HERO */
  .wm-hero{
    background:
      radial-gradient(80% 120% at 100% 0%,var(--warm-tan) 0%,transparent 60%),
      linear-gradient(180deg,var(--warm-cream),var(--bg));
    padding:64px 0 72px;
  }
  .wm-hero-grid{display:grid;grid-template-columns:1.02fr 1fr;gap:56px;align-items:center}
  .wm-hero-copy h1{font-size:clamp(40px,6.2vw,70px);font-weight:800;margin:22px 0 18px}
  .wm-sub{font-size:20px;color:var(--muted);max-width:30em;line-height:1.55}
  .wm-cta{display:flex;gap:14px;flex-wrap:wrap;margin:28px 0 24px}
  .wm-trust{list-style:none;display:flex;flex-direction:column;gap:9px;margin:0;padding:0;color:var(--muted);font-size:15px}
  .wm-trust li{display:flex;align-items:center;gap:10px}
  .wm-trust li::before{content:"●";color:var(--gold);font-size:9px}
  .wm-trust b{color:var(--text)}

  /* big warm photo, soft rounded, gentle frame */
  .wm-hero-media{position:relative}
  .wm-photo{position:relative;border-radius:var(--warm-radius);overflow:hidden;
    box-shadow:0 30px 80px -28px rgba(109,20,55,.4);border:6px solid #fff}
  .wm-photo img{display:block;width:100%;height:100%;min-height:440px;object-fit:cover}
  .wm-photo-card{position:absolute;left:18px;right:18px;bottom:18px;
    display:flex;align-items:center;gap:14px;
    background:rgba(255,255,255,.94);backdrop-filter:blur(8px);
    border-radius:18px;padding:16px 18px;box-shadow:0 16px 40px -16px rgba(28,20,20,.35)}
  .wm-photo-ring{flex-shrink:0;width:42px;height:42px;border-radius:50%;
    background:rgba(74,155,79,.16);color:var(--green);display:grid;place-items:center;font-weight:800;font-size:18px}
  .wm-photo-card strong{display:block;font-family:'Plus Jakarta Sans';font-weight:800;font-size:15px;color:var(--text)}
  .wm-photo-card span{display:block;font-size:13px;color:var(--muted);line-height:1.4}
  @media(max-width:880px){
    .wm-hero-grid{grid-template-columns:1fr;gap:36px}
    .wm-photo img{min-height:340px}
  }

  /* CERT PARTNERS */
  .wm-creds{background:#fff;border-top:1px solid var(--border);border-bottom:1px solid var(--border);padding:28px 0}
  .wm-creds-lab{text-align:center;color:var(--muted);font-size:12px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;margin-bottom:14px}
  .wm-creds-row{display:flex;align-items:center;justify-content:center;gap:38px;flex-wrap:wrap}
  .wm-creds-row span{font-family:'Plus Jakarta Sans';font-weight:800;font-size:21px;color:#4a4440;opacity:.78}
  .wm-creds-row em{color:var(--gold-dark);font-weight:700;font-size:15px;font-style:normal}

  /* SECTIONS */
  .wm-band{padding:74px 0}
  .wm-band--cream{background:var(--warm-cream)}
  .wm-head{text-align:center;max-width:660px;margin:0 auto 46px}
  .wm-eyebrow{display:inline-block;font-size:13px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;color:var(--crimson);background:rgba(173,44,77,.08);border:1px solid rgba(173,44,77,.18);padding:7px 14px;border-radius:999px;margin-bottom:14px}
  .wm-head h2{font-size:clamp(30px,4.2vw,48px);font-weight:800;margin-bottom:14px}
  .wm-head p{color:var(--muted);font-size:19px;line-height:1.55}

  /* STEPS — rounded friendly cards */
  .wm-steps{display:grid;grid-template-columns:repeat(4,1fr);gap:22px}
  .wm-step{background:#fff;border:1px solid var(--warm-tan);border-radius:var(--warm-radius);padding:30px 26px;
    box-shadow:0 14px 40px -22px rgba(109,20,55,.22);transition:transform .2s,box-shadow .25s}
  .wm-step:hover{transform:translateY(-5px);box-shadow:0 26px 60px -24px rgba(109,20,55,.32)}
  .wm-step-n{width:56px;height:56px;border-radius:18px;background:rgba(173,44,77,.1);color:var(--crimson);
    display:grid;place-items:center;font-family:'Plus Jakarta Sans';font-weight:800;font-size:20px;margin-bottom:18px}
  .wm-step:nth-child(even) .wm-step-n{background:rgba(164,127,56,.16);color:var(--gold-dark)}
  .wm-step h3{font-size:19px;font-weight:700;margin-bottom:8px}
  .wm-step p{color:var(--muted);font-size:15px;line-height:1.55}
  @media(max-width:880px){.wm-steps{grid-template-columns:1fr 1fr}}
  @media(max-width:560px){.wm-steps{grid-template-columns:1fr}}

  /* WHO WE SERVE */
  .wm-serve{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
  .wm-serve-card{background:#fff;border:1px solid var(--warm-tan);border-radius:var(--warm-radius);padding:34px 30px;
    box-shadow:0 14px 40px -22px rgba(109,20,55,.22);transition:transform .2s,box-shadow .25s}
  .wm-serve-card:hover{transform:translateY(-5px);box-shadow:0 26px 60px -24px rgba(109,20,55,.32)}
  .wm-serve-ic{width:60px;height:60px;border-radius:20px;display:grid;place-items:center;font-size:26px;margin-bottom:18px}
  .wm-ic--crimson{background:rgba(173,44,77,.12)}
  .wm-ic--blue{background:rgba(43,123,185,.12)}
  .wm-ic--gold{background:rgba(164,127,56,.16)}
  .wm-serve-card h3{font-size:22px;font-weight:700;margin-bottom:10px}
  .wm-serve-card p{color:var(--muted);font-size:15px;line-height:1.6;margin-bottom:16px}
  .wm-serve-card a{font-weight:700;color:var(--crimson)}
  .wm-serve-card a:hover{color:var(--accent-dark)}
  @media(max-width:880px){.wm-serve{grid-template-columns:1fr}}
  .wm-truth{max-width:700px;margin:34px auto 0;text-align:center;color:var(--muted);font-size:14px;
    background:rgba(255,255,255,.7);border:1px dashed var(--warm-tan);border-radius:16px;padding:18px 22px}
  .wm-truth a{color:var(--crimson);font-weight:700}

  /* FACTS */
  .wm-facts{display:grid;grid-template-columns:repeat(4,1fr);gap:24px;text-align:center}
  .wm-fact-k{font-family:'Plus Jakarta Sans';font-weight:800;font-size:clamp(28px,3.4vw,42px);
    background:var(--grad-text);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
  .wm-fact p{color:var(--muted);font-size:15px;margin-top:4px}
  @media(max-width:760px){.wm-facts{grid-template-columns:1fr 1fr}}

  /* CLOSING CTA */
  .wm-closing{border-radius:34px;overflow:hidden;position:relative;
    background:var(--grad);box-shadow:0 30px 80px -30px rgba(109,20,55,.5)}
  .wm-closing::after{content:"";position:absolute;inset:0;
    background:url('https://www.workforceap.org/images/hero-people.webp') center/cover;
    opacity:.16;mix-blend-mode:luminosity}
  .wm-closing-inner{position:relative;text-align:center;color:#fff;padding:66px 32px}
  .wm-closing-inner h2{font-size:clamp(30px,4.5vw,52px);font-weight:800;margin-bottom:14px}
  .wm-closing-inner p{font-size:19px;color:rgba(255,255,255,.92);max-width:34em;margin:0 auto 28px;line-height:1.55}
  .wm-closing-acts{display:flex;gap:14px;justify-content:center;flex-wrap:wrap}
</style>
</Layout>
