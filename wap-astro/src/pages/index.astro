---
import Layout from '../layouts/Layout.astro';
---
<Layout>
<!-- HERO -->
<section class="hero"><div class="wrap grid">
  <div>
    <span class="eyebrow"><span class="dot"></span>Workforce training · 501(c)(3) nonprofit</span>
    <h1>Empowering People.<br><span class="grad-text">Advancing Futures.</span></h1>
    <p class="sub">Employer-aligned training, professional certificates, and real career support — at no cost to qualifying members.</p>
    <div class="cta">
      <a class="btn btn--primary" href="/apply">Start your application →</a>
      <a class="btn btn--ghost" href="/how-it-works">See how it works</a>
    </div>
    <div class="trustline">
      <span><b>25+ years</b> in workforce development</span><span class="sep"></span>
      <span><b>$0</b> for qualifying members</span><span class="sep"></span>
      <span>Reviewed by a <b>real team</b></span>
    </div>
  </div>
  <div style="position:relative">
    <div class="panel">
      <div class="floatbadge">Employer-recognized certificates</div>
      <div class="phead">
        <div><small>Your pathway</small><div class="big">From apply to hired</div></div>
        <div class="ring">
          <svg viewBox="0 0 100 100" style="transform:rotate(-90deg)"><circle cx="50" cy="50" r="42" fill="none" stroke="rgba(255,255,255,.22)" stroke-width="9"/><circle cx="50" cy="50" r="42" fill="none" stroke="#fff" stroke-width="9" stroke-dasharray="264" stroke-dashoffset="88" stroke-linecap="round"/></svg>
        </div>
      </div>
      <div class="step"><div class="n">1</div><div class="t"><b>Apply in about 5 minutes</b><span>No cost for qualifying members</span></div><span class="pill">~5 min</span></div>
      <div class="step"><div class="n">2</div><div class="t"><b>Build job-ready skills</b><span>Employer-aligned program tracks</span></div></div>
      <div class="step active"><div class="n">3</div><div class="t"><b>Earn a recognized certificate</b><span>IBM · Google · Microsoft · AWS · CompTIA</span></div><span class="pill">Goal</span></div>
      <p class="note">A real team reviews your application and follows up in 1 to 2 business days.</p>
    </div>
  </div>
</div></section>

<!-- CERT PARTNERS -->
<div class="creds"><div class="wrap" style="display:block">
  <div class="row" style="display:flex"><div class="lab">Employer-recognized credentials you can earn</div>
    <span class="logo">IBM</span><span class="logo">Google</span><span class="logo">Microsoft</span><span class="logo">AWS</span><span class="logo">CompTIA</span><span class="extra">+ CPT &amp; CLT</span>
  </div>
</div></div>

<!-- TOOLS BENTO -->
<section class="band band--surface" id="tools"><div class="wrap">
  <div class="sec-head">
    <span class="eyebrow">Member tools</span>
    <h2>Tools that get you <span class="grad-text">job-ready</span></h2>
    <p>Members get a connected toolkit — coaching, practice, and tracking — alongside their program.</p>
  </div>
  <div class="bento">
    <div class="tool big">
      <div class="ic ic--c">📄</div>
      <h3>AI Resume Studio</h3>
      <p>Build and refine your resume with guided, real-time feedback on clarity, formatting, and ATS readability — then export and apply.</p>
      <div class="demo">
        <div class="line"><span class="chk">✓</span> Contact &amp; summary complete</div>
        <div class="line"><span class="chk">✓</span> Skills mapped to your target role</div>
        <div class="line">ATS readability<div class="bar" style="flex:1"><i style="width:82%"></i></div></div>
      </div>
    </div>
    <div class="tool"><div class="ic ic--g">🎙️</div><h3>AI Interview &amp; Voice Coach</h3><p>Practice real interview questions out loud and get coaching on your answers.</p><div class="demo"><span class="tag">Live voice session</span></div></div>
    <div class="tool"><div class="ic ic--b">🧭</div><h3>Skills &amp; Career Mapping</h3><p>See how your experience lines up to in-demand roles and what to learn next.</p></div>
    <div class="tool"><div class="ic ic--gr">🤝</div><h3>Mentor Support</h3><p>Connect with mentors and a career team that follow up — you're never doing it alone.</p></div>
    <div class="tool"><div class="ic ic--b">🔎</div><h3>Program Matching</h3><p>Get matched to the training track that fits your goals from our catalog of programs.</p></div>
    <div class="tool"><div class="ic ic--c">📊</div><h3>Progress Dashboard</h3><p>Track milestones from enrollment through certificate and job search in one place.</p></div>
  </div>
</div></section>

<!-- HOW IT WORKS -->
<section class="band" id="how"><div class="wrap">
  <div class="sec-head">
    <span class="eyebrow">Simple process</span>
    <h2>How <span class="grad-text">WorkforceAP</span> works</h2>
    <p>Four steps from application to a recognized credential and career support.</p>
  </div>
  <div class="steps">
    <div class="stepcard"><div class="num">01</div><h3>Apply</h3><p>Takes about 5 minutes. No cost for qualifying members — a real team reviews it.</p></div>
    <div class="stepcard"><div class="num">02</div><h3>Get matched</h3><p>We match you to the program track that fits your goals and background.</p></div>
    <div class="stepcard"><div class="num">03</div><h3>Train &amp; certify</h3><p>Build job-ready skills and earn an employer-recognized professional certificate.</p></div>
    <div class="stepcard"><div class="num">04</div><h3>Launch</h3><p>Move into the workforce with resume, interview, and mentor support behind you.</p></div>
  </div>
</div></section>

<!-- WHO WE SERVE -->
<section class="band band--surface" id="network"><div class="wrap">
  <div class="sec-head">
    <span class="eyebrow">A connected network</span>
    <h2>Built for members, employers &amp; partners</h2>
  </div>
  <div class="tri">
    <div class="acard"><div class="ic ic--c">👥</div><h3>Members</h3><p>No-cost, employer-aligned training, professional certificates, and a team that supports you to job-ready.</p><a href="/apply">Start your application →</a></div>
    <div class="acard"><div class="ic ic--b">🏢</div><h3>Employers</h3><p>Build a pipeline of training-aligned candidates for in-demand roles — no per-placement fees.</p><a href="/employers">Talk with us about hiring →</a></div>
    <div class="acard"><div class="ic ic--gr">🏛️</div><h3>Partners</h3><p>Extend workforce impact in your community through referral and program partnerships.</p><a href="/partners">Explore partnership →</a></div>
  </div>
  <p class="truth">We're a nonprofit — so we don't inflate outcomes. We publish verified placement data as cohorts complete, with the methodology shown. <a href="/outcomes">See our outcomes →</a></p>
</div></section>

<!-- TRUST FACTS -->
<section class="band"><div class="wrap facts">
  <div class="fact"><div class="k">25+ yrs</div><p>In workforce development</p></div>
  <div class="fact"><div class="k">501(c)(3)</div><p>Nonprofit organization</p></div>
  <div class="fact"><div class="k">$0</div><p>For qualifying members</p></div>
  <div class="fact"><div class="k">5</div><p>Employer-recognized cert tracks</p></div>
</div></section>

<!-- CTA -->
<section class="band"><div class="wrap"><div class="cta">
  <h2>Your next step starts with one application.</h2>
  <p>Apply in about 5 minutes — no cost for qualifying members. A real team reviews it and follows up in 1 to 2 business days.</p>
  <div class="acts">
    <a class="btn btn--light" href="/apply">Start your application</a>
    <a class="btn btn--translucent" href="/find-your-path">Find your path</a>
    <a class="btn btn--translucent" href="/employers">For employers</a>
  </div>
</div></div></section>
</Layout>
