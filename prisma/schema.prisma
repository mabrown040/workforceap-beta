model CourseEnrollment {
  id                String   @id @default(uuid())
  organizationId    String   @map("organization_id")
  userId            String   @map("user_id")
  programSlug       String   @map("program_slug")
  /// At most one row per user has `isPrimary = true` (enforced by partial
  /// unique index `course_enrollments_user_primary_uidx`). Mirrors what
  /// /dashboard/training defaults to. xAPI ingest resolves program slug from
  /// the user's most recent `CourseEnrollment` by `enrolledAt`, then falls
  /// back to legacy `User.enrolledProgram` (see lib/xapi/inboundStatementPipeline.ts).
  isPrimary         Boolean  @default(false) @map("is_primary")
  enrolledAt        DateTime @default(now()) @map("enrolled_at")
  enrolledByAdminId String?  @map("enrolled_by_admin_id")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  organization              Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user                      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrolledByAdmin           User?          @relation("AdminCourseEnrollments", fields: [enrolledByAdminId], references: [id], onDelete: SetNull)
  fundingSource             FundingSource? @map("funding_source")
  fundingNotes              String?        @map("funding_notes") @db.Text
  workspaceEmailProvisioned Boolean        @default(false) @map("workspace_email_provisioned")
  workspaceEmail            String?        @map("workspace_email")

  @@unique([userId, programSlug])
  @@index([organizationId])
  @@index([programSlug])
  @@index([userId, isPrimary])
  @@index([enrolledByAdminId])
  @@map("course_enrollments")
}

/// xAPI statements ingested from Coursera (LRS webhook). `statementId` is the external UUID when present.
model XapiStatement {
  id                 String    @id @default(uuid())
  statementId        String?   @unique @map("statement_id")
  actorEmail         String?   @map("actor_email")
  /// From actor.account.name — Coursera's external user identifier.
  /// Required for events that arrive without actor.mbox (some xAPI endpoints
  /// privacy-strip the email and only emit account.name).
  actorAccountName   String?   @map("actor_account_name")
  /// From actor.account.homePage — pairs with actorAccountName to scope it.
  actorHomePage      String?   @map("actor_home_page")
  verb               String
  courseId           String?   @map("course_id")
  courseName         String?   @map("course_name")
  resultScoreScaled  Float?    @map("result_score_scaled")
  resultScoreRaw     Float?    @map("result_score_raw")
  resultCompletion   Boolean?  @map("result_completion")
  resultSuccess      Boolean?  @map("result_success")
  /// Full original xAPI payload as JSONB. Lets replay reconstruct the exact
  /// statement (object.definition.type, context.extensions.courseId,
  /// result.progress, etc.) instead of guessing from flat columns.
  payload            Json?
  /// Coursera's per-item identifier extracted from `payload.object.id` when
  /// the URL contains `/item/<id>` (e.g. `rX6bE`). NULL for course-level
  /// statements. Lets the admin drill-down query per-item rollups in SQL
  /// without re-parsing the JSONB payload on every read.
  courseItemId       String?   @map("course_item_id")
  /// From `context.extensions["http://coursera.org/xapi/extensions/itemType"]`
  /// (e.g. `ITEM_TYPE_LECTURE`, `ITEM_TYPE_QUIZ`,
  /// `ITEM_TYPE_PROGRAMMING_ASSIGNMENT`). NULL for course-level statements.
  itemType           String?   @map("item_type")
  processed          Boolean   @default(false)
  processedAt        DateTime? @map("processed_at")
  createdAt          DateTime  @default(now()) @map("created_at")

  @@index([actorEmail])
  @@index([actorAccountName, actorHomePage])
  @@index([createdAt])
  @@index([courseId, courseItemId])
  @@index([actorEmail, courseId])
  @@index([processed, createdAt])
  @@map("xapi_statements")
}

