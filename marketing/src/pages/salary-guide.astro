---
import Layout from '../layouts/Layout.astro';
import { PROGRAMS } from '../data/programs';
const programs = PROGRAMS.map(program => ({
  ...program,
  researchTerms: program.extra?.jobOutcomes?.slice(0, 2) ?? [program.categoryLabel],
}));
---
<Layout title="Career & Salary Research Guide — WorkforceAP" description="Research career duties, education requirements, and pay with BLS and O*NET sources. Connect your WorkforceAP training interests to an informed career decision.">
  <div class="research-guide">
    <section class="research-hero">
      <div class="wrap"><p class="kicker">Career & salary guide</p><h1>Know the work.<br /><span>Understand the pay.</span></h1><p class="hero-copy">A stronger career decision starts with the actual job: what you do, what employers ask for, and what it pays where you live.</p><a class="btn btn--primary" href="#career-research">Research a career direction <span aria-hidden="true">↓</span></a></div>
    </section>
    <section class="guide-band guide-surface" aria-labelledby="sources-title"><div class="wrap">
      <div class="guide-heading"><p class="kicker">Go to the source</p><h2 id="sources-title">Look beyond a salary headline.</h2><p>Occupational wages describe a labor market. They are not WorkforceAP graduate earnings or a promise of a starting offer.</p></div>
      <div class="source-list">
        <article><p class="source-label">U.S. Bureau of Labor Statistics</p><h3>Pay, outlook, and entry requirements</h3><p>The Occupational Outlook Handbook puts job duties, education, pay, and projected employment in one place. Check the data year and the specific occupation.</p><a class="source-link" href="https://www.bls.gov/ooh/">Explore the Occupational Outlook Handbook <span aria-hidden="true">↗</span></a></article>
        <article><p class="source-label">O*NET OnLine</p><h3>Skills and the day-to-day work</h3><p>Use occupation profiles to investigate tasks, skills, preparation, and wage information. Compare those requirements with your experience and the program curriculum.</p><a class="source-link" href="https://www.onetonline.org/">Explore O*NET occupations <span aria-hidden="true">↗</span></a></article>
      </div>
      <div class="reading-note"><h3>Read the number carefully</h3><p>A median is the middle of a wage distribution, not an entry-level salary. A national figure can differ from pay in your area. Compare the location, year, experience requirements, and hourly or annual basis before using a figure in your plan.</p></div>
    </div></section>
    <section class="guide-band" id="career-research" aria-labelledby="research-title"><div class="wrap">
      <div class="guide-heading"><p class="kicker">Connect training to the work</p><h2 id="research-title">Explore a direction.</h2><p>These search ideas come from the program catalog. They are starting points for research; each role has its own education and experience requirements. Completing a certificate alone does not establish eligibility for a role.</p></div>
      <div class="research-filter"><label for="career-search">Find a program or career</label><input type="search" id="career-search" placeholder="Try IT support, healthcare, or project management" aria-describedby="research-count" /><p id="research-count" role="status" aria-live="polite">{programs.length} programs</p></div>
      <ul class="research-list">
        {programs.map(program => <li data-career-row data-search={`${program.title} ${program.categoryLabel} ${program.researchTerms.join(' ')}`.toLowerCase()}>
          <div><p class="program-category">{program.categoryLabel}</p><h3><a href={`/programs/${program.slug}`}>{program.title}</a></h3><a class="curriculum-link" href={`/programs/${program.slug}`}>Review curriculum and requirements <span aria-hidden="true">→</span></a></div>
          <div class="occupation-links"><p>Research on O*NET</p>{program.researchTerms.map(term => <a href={`https://www.onetonline.org/find/quick?s=${encodeURIComponent(term)}`}>{term} <span aria-hidden="true">↗</span></a>)}</div>
        </li>)}
      </ul>
      <p class="empty-search" id="career-search-empty" hidden>No matching programs. Try a broader term or <a href="/programs">browse the full catalog</a>.</p>
    </div></section>
    <section class="guide-band guide-surface" aria-labelledby="questions-title"><div class="wrap questions-layout">
      <div><p class="kicker">Turn research into a decision</p><h2 id="questions-title">Bring better questions<br />to your next conversation.</h2></div>
      <ol><li>Find three current job postings in your area. Note the pay range, required experience, and work schedule.</li><li>Compare the recurring skills with the curriculum. Mark the skills you already have and those you need to build.</li><li>Ask the team about prerequisites, study time, certification exams, funding eligibility, and available support.</li><li>Decide what evidence you could show an employer: a project, work example, credential, or relevant experience.</li></ol>
    </div></section>
    <section class="guide-band"><div class="wrap guide-close"><h2>Make your next step concrete.</h2><p>Explore training programs, then use your research to discuss the right pathway with the team.</p><div class="guide-actions"><a class="btn btn--primary" href="/find-your-path">Find my training program <span aria-hidden="true">→</span></a><a class="btn btn--ghost" href="/contact">Talk with the team</a></div><p class="impact-note">Already enrolled? <a href="/login?redirectTo=/dashboard/program">Sign in to my training.</a></p><p class="impact-note">Looking for WorkforceAP results? <a href="/impact">See our public impact and evidence page.</a></p></div></section>
  </div>
</Layout>
<script>
  const field = document.querySelector<HTMLInputElement>('#career-search');
  const rows = Array.from(document.querySelectorAll<HTMLElement>('[data-career-row]'));
  const count = document.querySelector('#research-count');
  const empty = document.querySelector<HTMLElement>('#career-search-empty');
  field?.addEventListener('input', () => {
    const words = field.value.toLowerCase().match(/[\p{L}\p{N}]+/gu) ?? [];
    let visible = 0;
    for (const row of rows) {
      const tokens = row.dataset.search?.match(/[\p{L}\p{N}]+/gu) ?? [];
      row.hidden = !words.every(word => tokens.some(token => token.startsWith(word)));
      if (!row.hidden) visible++;
    }
    if (count) count.textContent = `${visible} ${visible === 1 ? 'program' : 'programs'}`;
    if (empty) empty.hidden = visible > 0;
  });
</script>
<style>
  .research-guide a:focus-visible,.research-guide input:focus-visible{outline:3px solid var(--crimson);outline-offset:4px}.research-guide a:hover{text-decoration:underline;text-underline-offset:4px}
  .research-hero{padding:64px 0;background:radial-gradient(ellipse at top right,color-mix(in srgb,var(--gold) 12%,transparent),transparent 65%),var(--bg)}.kicker{font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:var(--crimson);margin-bottom:18px}.research-hero h1{font-size:clamp(40px,5.7vw,68px);line-height:1.05;letter-spacing:-.04em}.research-hero h1 span{color:var(--crimson)}.hero-copy{font-size:20px;color:var(--muted);max-width:38rem;margin:24px 0}.guide-band{padding:64px 0;scroll-margin-top:88px}.guide-surface{background:var(--surface);border-block:1px solid var(--border)}.guide-heading{max-width:48rem;margin-bottom:32px}.guide-heading h2,.questions-layout h2,.guide-close h2{font-size:clamp(28px,3.4vw,42px);line-height:1.15}.guide-heading>p:last-child{font-size:18px;color:var(--muted);margin-top:18px}.source-list{display:grid;grid-template-columns:1fr 1fr;gap:48px}.source-list article{border-top:2px solid var(--crimson);padding-top:24px}.source-label{font-size:14px;font-weight:700;color:var(--crimson)}.source-list h3{font-size:24px;line-height:1.2;margin:12px 0}.source-list article>p:not(.source-label){font-size:17px;color:var(--muted)}.source-link{display:inline-flex;align-items:center;gap:8px;min-height:44px;color:var(--crimson);font-weight:700;margin-top:16px}.reading-note{background:var(--bg);padding:24px;margin-top:36px;border-radius:14px}.reading-note h3{font-size:19px;margin-bottom:10px}.reading-note p{font-size:16px;color:var(--muted);max-width:62rem}.research-filter{max-width:40rem;margin-bottom:24px}.research-filter label{font-size:16px;font-weight:700;display:block;margin-bottom:8px}.research-filter input{width:100%;padding:14px 16px;min-height:48px;background:var(--surface);border:1px solid var(--muted);border-radius:10px;font:inherit;color:var(--text)}.research-filter p{margin-top:10px;color:var(--muted);font-size:14px}.research-list{list-style:none}.research-list li{display:grid;grid-template-columns:1.15fr 1fr;gap:48px;padding:28px 0;border-top:1px solid var(--border)}.research-list li[hidden]{display:none}.program-category{font-size:13px;font-weight:700;color:var(--crimson);margin-bottom:8px}.research-list h3{font-size:22px;line-height:1.3;max-width:36rem}.curriculum-link{display:inline-flex;align-items:center;min-height:44px;color:var(--crimson);font-size:15px;font-weight:600;margin-top:8px}.occupation-links>p{font-size:13px;color:var(--muted);font-weight:700}.occupation-links>a{display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:44px;padding:6px 0;color:var(--crimson);font-weight:600;font-size:16px}.empty-search{padding:24px;background:var(--surface)}.empty-search a{color:var(--crimson);text-decoration:underline}.questions-layout{display:grid;grid-template-columns:1fr 1fr;gap:64px}.questions-layout ol{padding-left:24px}.questions-layout li{padding-left:8px;margin-bottom:20px;font-size:17px}.questions-layout li::marker{color:var(--crimson);font-weight:700}.guide-close{max-width:850px}.guide-close>p{font-size:18px;color:var(--muted);margin:20px 0}.guide-actions{display:flex;flex-wrap:wrap;gap:16px}.guide-close .impact-note{font-size:15px}.impact-note a{color:var(--crimson);text-decoration:underline}
  @media(max-width:640px){.research-hero{padding:40px 0}.guide-band{padding:44px 0}.hero-copy,.guide-heading>p:last-child{font-size:17px}.source-list,.questions-layout{grid-template-columns:1fr;gap:32px}.research-list li{grid-template-columns:1fr;gap:12px}.research-list h3{font-size:20px}.guide-actions{flex-direction:column}.guide-actions .btn{justify-content:center}.reading-note{padding:20px}}
</style>
