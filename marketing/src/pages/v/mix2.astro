---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="WorkforceAP — Empowering People. Advancing Futures.">
<div class="mix2">

  <!-- ===== HERO: BOLD crimson stage + DEPTH glass deck ===== -->
  <section class="m2hero">
    <div class="m2aura m2aura--gold" aria-hidden="true"></div>
    <div class="m2aura m2aura--crimson" aria-hidden="true"></div>
    <div class="m2hero__photo" aria-hidden="true"></div>

    <div class="wrap m2hero__grid">
      <div class="m2hero__lede">
        <span class="m2pill"><span class="m2pill__star">★</span>501(c)(3) nonprofit · Employer-recognized certificates</span>
        <h1 class="m2hero__h">Empowering People.<br><span class="m2gold">Advancing Futures.</span></h1>
        <p class="m2hero__sub">Employer-aligned training, professional certificates, and real career support — at no cost to qualifying members.</p>
        <div class="m2acts">
          <a class="m2btn m2btn--gold" href="/apply">Start your application →</a>
          <a class="m2btn m2btn--outline" href="/find-your-path">Find your path</a>
        </div>
        <div class="m2hero__stats">
          <div class="m2hstat"><b>25+ yrs</b><span>in workforce development</span></div>
          <div class="m2hstat"><b>$0</b><span>for qualifying members</span></div>
          <div class="m2hstat"><b>~5 min</b><span>to apply, real-team review</span></div>
        </div>
      </div>

      <!-- DEPTH: stacked translucent glass cards -->
      <div class="m2deck">
        <div class="m2card m2card--back">
          <div class="m2card-tag">Recognized credential</div>
          <div class="m2logos">
            <span>IBM</span><span>Google</span><span>Microsoft</span><span>AWS</span><span>CompTIA</span>
          </div>
        </div>

        <div class="m2card m2card--mid">
          <div class="m2mid-row">
            <small>Your pathway</small>
            <span class="m2dot-live">Live</span>
          </div>
          <div class="m2mid-big">From apply to hired</div>
          <div class="m2track">
            <i class="t-done"></i><i class="t-done"></i><i class="t-now"></i><i></i>
          </div>
          <div class="m2track-labels"><span>Apply</span><span>Match</span><span>Certify</span><span>Launch</span></div>
        </div>

        <div class="m2card m2card--front">
          <div class="m2front-head">
            <div class="m2ic">✓</div>
            <div>
              <b>Application reviewed</b>
              <span>A real team follows up in 1–2 business days.</span>
            </div>
          </div>
          <div class="m2meter">
            <span>Cost to qualifying members</span>
            <strong>$0</strong>
          </div>
          <div class="m2chips">
            <span>~5 min to apply</span>
            <span>No cost</span>
            <span>Real career support</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== CERT PARTNERS: BOLD cream strip with gold rule ===== -->
  <section class="m2blk m2blk--cream m2creds">
    <div class="wrap">
      <p class="m2creds__lab">Employer-recognized credentials you can earn</p>
      <div class="m2creds__row">
        <span class="m2logo">IBM</span>
        <span class="m2logo">Google</span>
        <span class="m2logo">Microsoft</span>
        <span class="m2logo">AWS</span>
        <span class="m2logo">CompTIA</span>
        <span class="m2creds__extra">+ CPT &amp; CLT</span>
      </div>
    </div>
  </section>

  <!-- ===== HOW IT WORKS: BOLD crimson block, huge numbered steps ===== -->
  <section class="m2blk m2blk--crimson">
    <div class="wrap">
      <div class="m2head m2head--light">
        <span class="m2kick">Simple process</span>
        <h2>Four steps.<br><span class="m2gold">One application.</span></h2>
      </div>
      <div class="m2journey">
        <a class="m2jstep" href="/apply">
          <span class="m2jnum">01</span>
          <h3>Apply</h3>
          <p>Takes about 5 minutes. No cost for qualifying members — a real team reviews it.</p>
        </a>
        <div class="m2jstep">
          <span class="m2jnum">02</span>
          <h3>Get matched</h3>
          <p>We match you to the program track that fits your goals and background.</p>
        </div>
        <div class="m2jstep">
          <span class="m2jnum">03</span>
          <h3>Train &amp; certify</h3>
          <p>Build job-ready skills and earn an employer-recognized professional certificate.</p>
        </div>
        <div class="m2jstep">
          <span class="m2jnum">04</span>
          <h3>Launch</h3>
          <p>Move into the workforce with resume, interview, and mentor support behind you.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== IMMERSIVE: full-bleed photo divider with crimson veil + pull-statement ===== -->
  <section class="m2immerse">
    <div class="m2immerse__media" aria-hidden="true"></div>
    <div class="m2immerse__veil" aria-hidden="true"></div>
    <div class="m2immerse__inner wrap">
      <span class="m2immerse__kick">Why we do this</span>
      <p class="m2immerse__quote">A credential opens the door. A real team makes sure you walk through it — at no cost to qualifying members.</p>
      <p class="m2immerse__by">WorkforceAP · 501(c)(3) · 25+ years in workforce development</p>
    </div>
  </section>

  <!-- ===== WHO WE SERVE: DEPTH glass tri-cards on crimson stage ===== -->
  <section class="m2serve">
    <div class="m2aura m2aura--serve" aria-hidden="true"></div>
    <div class="wrap">
      <div class="m2head m2head--light">
        <span class="m2kick">A connected network</span>
        <h2>Built for members,<br>employers &amp; partners.</h2>
      </div>
      <div class="m2tri">
        <div class="m2gcard">
          <div class="m2gic">👥</div>
          <h3>Members</h3>
          <p>No-cost, employer-aligned training, professional certificates, and a team that supports you to job-ready.</p>
          <a href="/apply">Start your application →</a>
        </div>
        <div class="m2gcard">
          <div class="m2gic">🏢</div>
          <h3>Employers</h3>
          <p>Build a pipeline of training-aligned candidates for in-demand roles — no per-placement fees.</p>
          <a href="/employers">Talk with us about hiring →</a>
        </div>
        <div class="m2gcard">
          <div class="m2gic">🏛️</div>
          <h3>Partners</h3>
          <p>Extend workforce impact in your community through referral and program partnerships.</p>
          <a href="/partners">Explore partnership →</a>
        </div>
      </div>
      <p class="m2truth">We're a nonprofit — so we don't inflate outcomes. We publish verified placement data as cohorts complete, with the methodology shown. <a href="/outcomes">See our outcomes →</a></p>
    </div>
  </section>

  <!-- ===== TRUST FACTS: BOLD cream block, big gradient numbers ===== -->
  <section class="m2blk m2blk--cream">
    <div class="wrap m2facts">
      <div class="m2fact"><div class="m2fk">25+</div><p>years in workforce development</p></div>
      <div class="m2fact"><div class="m2fk">501(c)(3)</div><p>nonprofit organization</p></div>
      <div class="m2fact"><div class="m2fk">$0</div><p>for qualifying members</p></div>
      <div class="m2fact"><div class="m2fk">5</div><p>employer-recognized cert tracks</p></div>
    </div>
  </section>

  <!-- ===== CLOSING CTA: BOLD crimson slab ===== -->
  <section class="m2blk m2blk--cream m2cta-wrap">
    <div class="wrap">
      <div class="m2cta">
        <div class="m2aura m2aura--cta" aria-hidden="true"></div>
        <div class="m2cta__inner">
          <span class="m2pill"><span class="m2pill__star">★</span>Reviewed by a real team in 1–2 business days</span>
          <h2>Your next step starts with<br><span class="m2gold">one application.</span></h2>
          <p>Apply in about 5 minutes — no cost for qualifying members. A real team reviews it and follows up in 1 to 2 business days.</p>
          <div class="m2acts m2acts--center">
            <a class="m2btn m2btn--gold" href="/apply">Start your application</a>
            <a class="m2btn m2btn--ghost" href="/find-your-path">Find your path</a>
            <a class="m2btn m2btn--ghost" href="/employers">For employers</a>
          </div>
        </div>
      </div>
    </div>
  </section>

</div>

<style>
  /* ===== MIX2 — BOLD-LED fusion: bold crimson hero + depth glass deck,
     alternating bold blocks, one immersive photo divider, depth glass tri. ===== */
  .mix2{--glass:rgba(255,255,255,.10);--glass-line:rgba(255,255,255,.18)}
  .m2gold{color:#e9c879}

  /* ---------- GOLD PILL (assertive, never clipped) ---------- */
  .m2pill{
    display:inline-flex;align-items:center;gap:8px;max-width:100%;white-space:nowrap;
    background:linear-gradient(135deg,#e9c879,#a47f38);
    color:#3a2a08;font-weight:800;font-size:13px;letter-spacing:.02em;line-height:1;
    padding:11px 20px;border-radius:999px;
    box-shadow:0 12px 30px -10px rgba(0,0,0,.45),0 1px 0 rgba(255,255,255,.4) inset;
    margin-bottom:26px;
  }
  .m2pill__star{font-size:12px}
  @media(max-width:430px){.m2pill{white-space:normal;text-align:left}}

  /* ---------- BOLD HERO STAGE ---------- */
  .m2hero{
    position:relative;overflow:hidden;isolation:isolate;
    background:linear-gradient(135deg,var(--crimson) 0%,var(--accent-dark) 50%,var(--plum) 100%);
    color:#fff;padding:104px 0 116px;
  }
  .m2hero__photo{
    position:absolute;inset:0;z-index:0;pointer-events:none;
    background:url('https://www.workforceap.org/images/hero-people.webp') center/cover;
    opacity:.12;mix-blend-mode:luminosity;
  }
  .m2aura{position:absolute;border-radius:50%;filter:blur(70px);z-index:0;pointer-events:none}
  .m2aura--gold{width:520px;height:520px;top:-160px;right:-100px;background:radial-gradient(circle,rgba(233,200,121,.5),transparent 68%)}
  .m2aura--crimson{width:460px;height:460px;bottom:-200px;left:-140px;background:radial-gradient(circle,rgba(173,44,77,.6),transparent 70%)}
  .m2hero__grid{position:relative;z-index:2;display:grid;grid-template-columns:1.04fr .96fr;gap:56px;align-items:center}

  .m2hero__h{
    font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;
    font-size:clamp(46px,7.6vw,96px);line-height:.96;letter-spacing:-.035em;margin:0 0 22px;
  }
  .m2hero__sub{font-size:clamp(19px,2.2vw,24px);color:rgba(255,255,255,.92);max-width:32em;line-height:1.45}
  .m2acts{display:flex;gap:16px;flex-wrap:wrap;margin:36px 0 0}
  .m2acts--center{justify-content:center}

  /* big assertive buttons */
  .m2btn{
    display:inline-flex;align-items:center;gap:10px;font-weight:800;font-size:18px;
    padding:18px 34px;border-radius:14px;border:2px solid transparent;
    transition:transform .15s,box-shadow .2s,background .2s,color .2s;
  }
  .m2btn:hover{transform:translateY(-3px)}
  .m2btn--gold{background:linear-gradient(135deg,#e9c879,#a47f38);color:#3a2a08;box-shadow:0 16px 38px -12px rgba(164,127,56,.7)}
  .m2btn--gold:hover{box-shadow:0 22px 50px -12px rgba(164,127,56,.85)}
  .m2btn--outline{background:transparent;color:#fff;border-color:rgba(255,255,255,.55)}
  .m2btn--outline:hover{background:#fff;color:var(--accent-dark);border-color:#fff}
  .m2btn--ghost{background:transparent;color:var(--accent-dark);border-color:var(--accent-dark)}
  .m2btn--ghost:hover{background:var(--accent-dark);color:#fff}

  .m2hero__stats{display:flex;gap:40px;flex-wrap:wrap;margin-top:46px}
  .m2hstat b{display:block;font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:clamp(28px,3.4vw,40px);color:#e9c879;line-height:1}
  .m2hstat span{display:block;font-size:14px;color:rgba(255,255,255,.85);margin-top:6px;max-width:13em}

  /* ---------- DEPTH GLASS DECK ---------- */
  .m2deck{position:relative;min-height:430px}
  .m2card{position:absolute;left:0;right:0;border-radius:22px;padding:24px;
    background:var(--glass);border:1px solid var(--glass-line);backdrop-filter:blur(18px);
    box-shadow:0 30px 80px -30px rgba(0,0,0,.7),0 1px 0 rgba(255,255,255,.22) inset;color:#fff}

  .m2card--back{top:0;transform:rotate(-3deg) translateX(28px);background:rgba(255,255,255,.07);z-index:1}
  .m2card-tag{font-size:11px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:rgba(255,255,255,.72);margin-bottom:14px}
  .m2logos{display:flex;flex-wrap:wrap;gap:14px}
  .m2logos span{font-family:'Plus Jakarta Sans';font-weight:800;font-size:16px;color:rgba(255,255,255,.92);
    background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.16);padding:6px 12px;border-radius:10px}

  .m2card--mid{top:96px;transform:rotate(1.5deg);z-index:2;background:rgba(255,255,255,.13)}
  .m2mid-row{display:flex;align-items:center;justify-content:space-between}
  .m2mid-row small{font-size:12px;text-transform:uppercase;letter-spacing:.08em;color:rgba(255,255,255,.72);font-weight:700}
  .m2dot-live{display:inline-flex;align-items:center;gap:6px;font-size:12px;font-weight:700;color:#fff;
    background:rgba(74,155,79,.32);border:1px solid rgba(120,220,130,.4);padding:4px 10px;border-radius:999px}
  .m2dot-live::before{content:"";width:7px;height:7px;border-radius:50%;background:#7fe389;box-shadow:0 0 8px #7fe389}
  .m2mid-big{font-family:'Plus Jakarta Sans';font-weight:800;font-size:24px;margin:8px 0 18px}
  .m2track{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}
  .m2track i{height:8px;border-radius:5px;background:rgba(255,255,255,.2)}
  .m2track i.t-done{background:linear-gradient(90deg,#e3bd6a,#fff)}
  .m2track i.t-now{background:#fff;box-shadow:0 0 12px rgba(255,255,255,.8)}
  .m2track-labels{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:9px}
  .m2track-labels span{font-size:11px;color:rgba(255,255,255,.7);text-align:center}

  .m2card--front{top:262px;transform:rotate(-1deg);z-index:3;background:rgba(255,255,255,.16)}
  .m2front-head{display:flex;align-items:flex-start;gap:13px;margin-bottom:18px}
  .m2front-head .m2ic{flex-shrink:0;width:38px;height:38px;border-radius:11px;display:grid;place-items:center;
    background:rgba(74,155,79,.32);border:1px solid rgba(120,220,130,.4);color:#caffce;font-weight:800;font-size:17px}
  .m2front-head b{display:block;font-weight:700;font-size:15px}
  .m2front-head span{font-size:13px;color:rgba(255,255,255,.78)}
  .m2meter{display:flex;align-items:baseline;justify-content:space-between;padding:14px 16px;border-radius:13px;
    background:rgba(0,0,0,.18);border:1px solid rgba(255,255,255,.12);margin-bottom:14px}
  .m2meter span{font-size:13px;color:rgba(255,255,255,.8)}
  .m2meter strong{font-family:'Plus Jakarta Sans';font-weight:800;font-size:26px;color:#f3d28f}
  .m2chips{display:flex;flex-wrap:wrap;gap:8px}
  .m2chips span{font-size:12px;font-weight:700;padding:6px 12px;border-radius:999px;
    background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.18)}

  @media (prefers-reduced-motion: no-preference){
    .m2deck{animation:m2-float 8s ease-in-out infinite}
    @keyframes m2-float{0%,100%{transform:translateY(0)}50%{transform:translateY(-10px)}}
  }

  /* ---------- BOLD ALTERNATING BLOCKS ---------- */
  .m2blk{padding:96px 0}
  .m2blk--crimson{background:var(--grad);color:#fff}
  .m2blk--cream{background:var(--bg);color:var(--text)}

  /* cert strip */
  .m2creds{padding:42px 0;border-top:3px solid var(--gold);border-bottom:1px solid var(--border)}
  .m2creds__lab{text-align:center;color:var(--muted);font-size:12px;font-weight:800;letter-spacing:.16em;text-transform:uppercase;margin-bottom:18px}
  .m2creds__row{display:flex;align-items:center;justify-content:center;gap:clamp(24px,5vw,56px);flex-wrap:wrap}
  .m2logo{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:clamp(22px,3vw,30px);color:#3a3331}
  .m2creds__extra{color:var(--gold-dark);font-weight:800;font-size:16px}

  /* bold section heads */
  .m2head{margin-bottom:56px}
  .m2head h2{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:clamp(38px,5.6vw,72px);line-height:.96;letter-spacing:-.03em}
  .m2kick{display:inline-block;font-size:13px;font-weight:800;letter-spacing:.16em;text-transform:uppercase;margin-bottom:18px}
  .m2head--light .m2kick{color:#e9c879}

  /* journey — huge numbered steps */
  .m2journey{display:grid;grid-template-columns:repeat(4,1fr);gap:0;border-top:1px solid rgba(255,255,255,.25)}
  .m2jstep{padding:36px 28px 36px 28px;border-left:1px solid rgba(255,255,255,.25);color:#fff;display:block;transition:background .2s}
  .m2jstep:first-child{border-left:0;padding-left:0}
  a.m2jstep:hover{background:rgba(255,255,255,.07)}
  .m2jnum{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:64px;line-height:1;color:#e9c879;display:block;margin-bottom:18px}
  .m2jstep h3{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:24px;margin-bottom:10px}
  .m2jstep p{color:rgba(255,255,255,.88);font-size:15px;line-height:1.5}

  /* ---------- IMMERSIVE PHOTO DIVIDER ---------- */
  .m2immerse{
    position:relative;overflow:hidden;
    width:100vw;left:50%;right:50%;margin-left:-50vw;margin-right:-50vw;
  }
  .m2immerse__media{
    position:absolute;inset:0;
    background:url('https://www.workforceap.org/images/hero-people.webp') center 35%/cover no-repeat;
    transform:scale(1.04);
  }
  .m2immerse__veil{
    position:absolute;inset:0;
    background:
      linear-gradient(180deg,rgba(45,8,22,.55) 0%,rgba(109,20,55,.30) 45%,rgba(45,8,22,.62) 100%),
      linear-gradient(115deg,rgba(173,44,77,.86) 0%,rgba(140,15,55,.55) 55%,rgba(109,20,55,.5) 100%);
  }
  .m2immerse__inner{position:relative;z-index:2;color:#fff;text-align:center;padding:110px 24px 116px;max-width:var(--max)}
  .m2immerse__kick{display:inline-block;font-size:13px;font-weight:800;letter-spacing:.16em;text-transform:uppercase;color:#e9c879;margin-bottom:22px}
  .m2immerse__quote{
    font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;
    font-size:clamp(28px,4.4vw,52px);line-height:1.1;letter-spacing:-.02em;
    max-width:18ch;margin:0 auto 22px;text-shadow:0 2px 40px rgba(45,8,22,.45);
  }
  .m2immerse__by{font-size:14px;color:rgba(255,255,255,.82);letter-spacing:.02em}

  /* ---------- DEPTH SERVE STAGE (glass tri) ---------- */
  .m2serve{position:relative;overflow:hidden;isolation:isolate;padding:96px 0;
    background:radial-gradient(120% 120% at 20% 0%, var(--plum) 0%, var(--accent-dark) 45%, #3c0a1f 100%);color:#fff}
  .m2aura--serve{width:560px;height:560px;top:-180px;right:-160px;background:radial-gradient(circle,rgba(233,200,121,.4),transparent 70%)}
  .m2serve .wrap{position:relative;z-index:2}
  .m2tri{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}
  .m2gcard{background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.16);border-radius:22px;padding:30px;
    backdrop-filter:blur(14px);box-shadow:0 30px 70px -34px rgba(0,0,0,.7),0 1px 0 rgba(255,255,255,.16) inset;
    transition:transform .22s,box-shadow .26s,border-color .2s}
  .m2gcard:hover{transform:translateY(-6px);border-color:rgba(255,255,255,.34);box-shadow:0 40px 84px -34px rgba(0,0,0,.78)}
  .m2gic{width:52px;height:52px;border-radius:14px;display:grid;place-items:center;font-size:24px;margin-bottom:16px;
    background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.18)}
  .m2gcard h3{font-family:'Plus Jakarta Sans';font-size:21px;font-weight:800;margin-bottom:9px}
  .m2gcard p{color:rgba(255,255,255,.8);font-size:15px;margin-bottom:16px}
  .m2gcard a{font-weight:700;color:#f3d28f}
  .m2gcard a:hover{color:#fff}
  .m2truth{max-width:700px;margin:34px auto 0;text-align:center;color:rgba(255,255,255,.74);font-size:14px;
    background:rgba(255,255,255,.06);border:1px dashed rgba(255,255,255,.22);border-radius:14px;padding:16px 22px}
  .m2truth a{color:#f3d28f;font-weight:700}
  @media(max-width:880px){.m2tri{grid-template-columns:1fr}}

  /* ---------- FACTS ---------- */
  .m2facts{display:grid;grid-template-columns:repeat(4,1fr);gap:32px;text-align:center}
  .m2fk{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:clamp(40px,6vw,72px);line-height:1;
    background:var(--grad-text);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
  .m2fact p{color:var(--muted);font-size:15px;margin-top:10px}
  @media(max-width:760px){.m2facts{grid-template-columns:1fr 1fr;gap:36px}}

  /* ---------- CLOSING CTA (bold slab + depth aura) ---------- */
  .m2cta-wrap{padding:80px 0}
  .m2cta{position:relative;overflow:hidden;isolation:isolate;border-radius:32px;
    background:var(--grad);color:#fff;padding:clamp(48px,7vw,84px) clamp(28px,5vw,64px);text-align:center;
    box-shadow:0 40px 90px -40px rgba(109,20,55,.6)}
  .m2cta::after{content:"";position:absolute;inset:0;z-index:0;
    background:url('https://www.workforceap.org/images/hero-people.webp') center/cover;opacity:.10;mix-blend-mode:luminosity}
