  NOT_STARTED
  IN_PROGRESS
  COMPLETED

  @@map("course_progress_status")
}

/// Per-member, per-program course progress (Coursera xAPI and manual completion).
model CourseProgress {
  id               String               @id @default(uuid())
  userId           String               @map("user_id")
  programSlug      String               @map("program_slug")
  courseId         String?              @map("course_id")
  courseSlug       String               @map("course_slug")
  status           CourseProgressStatus @default(NOT_STARTED)
  percentComplete  Int                  @default(0) @map("percent_complete")
  progressPct      Int                  @default(0) @map("progress_pct")
  scoreScaled      Float?               @map("score_scaled")
  scoreRaw         Float?               @map("score_raw")
  startedAt        DateTime?            @map("started_at")
  completedAt      DateTime?            @map("completed_at")
  lastActivityAt   DateTime?            @map("last_activity_at")
  statementCount   Int                  @default(0) @map("statement_count")
  lastUpdatedAt    DateTime             @updatedAt @map("last_updated_at")
  createdAt        DateTime             @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, programSlug, courseSlug])
  @@index([userId])
  @@index([programSlug])
  // Supports the "what did this learner touch most recently?" query path the
  // dashboard uses (and counselor "stale learner" queries). Composite +
  // descending sort lets Postgres satisfy ORDER BY last_activity_at DESC LIMIT N
  // for a single user without a sort step.
  @@index([userId, lastActivityAt(sort: Desc)])
  @@index([userId, courseId, completedAt])
  @@map("course_progress")
}

