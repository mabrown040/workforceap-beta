    "functions": [
      {
        "name": "lab_actor_is_member",
        "arguments": "p_member_id text, p_organization_id text",
        "result": "boolean",
        "language": "sql",
        "definer": true,
        "volatility": "s",
        "strict": false,
        "leakproof": false,
        "parallel": "u",
        "config": [
          "search_path=pg_catalog, public"
        ],
        "body": "\n  SELECT EXISTS (SELECT 1 FROM public.users u\n    WHERE u.id = p_member_id AND u.id = NULLIF(current_setting('app.current_user_id', true), '')\n      AND u.organization_id = p_organization_id AND u.deleted_at IS NULL);\n"
      },
      {
        "name": "lab_actor_can_review",
        "arguments": "p_member_id text, p_organization_id text",
        "result": "boolean",
        "language": "sql",
        "definer": true,
        "volatility": "s",
        "strict": false,
        "leakproof": false,
        "parallel": "u",
        "config": [
          "search_path=pg_catalog, public"
        ],
        "body": "\n  SELECT EXISTS (SELECT 1 FROM public.users actor JOIN public.users member ON member.id = p_member_id\n    WHERE actor.id = NULLIF(current_setting('app.current_user_id', true), '')\n      AND actor.id <> member.id\n      AND actor.organization_id = p_organization_id AND member.organization_id = p_organization_id\n      AND actor.deleted_at IS NULL AND member.deleted_at IS NULL\n      AND (\n        EXISTS (SELECT 1 FROM public.profiles p WHERE p.user_id = actor.id AND p.role IN ('admin', 'super_admin'))\n        OR EXISTS (SELECT 1 FROM public.user_roles ur JOIN public.roles r ON r.id = ur.role_id WHERE ur.user_id = actor.id AND r.name IN ('admin', 'super_admin'))\n        OR EXISTS (SELECT 1 FROM public.counselor_assignments ca JOIN public.counselors c ON c.id = ca.counselor_id WHERE ca.member_id = member.id AND ca.active AND c.active AND c.user_id = actor.id)\n      ));\n"
      },
      {
        "name": "reject_lab_evidence_update",
        "arguments": "",
        "result": "trigger",
        "language": "plpgsql",
        "definer": false,
        "volatility": "v",
        "strict": false,
        "leakproof": false,
        "parallel": "u",
        "config": [
          "search_path=pg_catalog, public"
        ],
        "body": "\nBEGIN RAISE EXCEPTION 'Lab evidence and reviews are immutable' USING ERRCODE = '23514'; END;\n"
      }
    ],
