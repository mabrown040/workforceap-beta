---
import Layout from '../layouts/Layout.astro';

// Real leadership data mirrored VERBATIM from the Next source (lib/content/leadership.ts).
// Names, roles, bios, and mission-relevance lines are the organization's real published
// content — not fabricated.
const executives = [
  {
    slug: 'michael-brown',
    name: 'Michael A. Brown, PMP, ChE',
    role: 'Executive Director, CEO',
    founder: true,
    initials: 'MB',
    missionRelevance:
      '25+ years delivering workforce training through public, nonprofit, faith, and employer partnerships — and a recurring Vision given to Michael Brown by God for serving His people — the barrier-breaking experience that built WorkforceAP.',
    cardBio:
      'Michael Brown, PMP, ChE (Chemical Engineering, Texas A&M University), is a highly accomplished engineer and business executive with a distinguished career spanning several decades. WorkforceAP is a 501(c)(3) nonprofit built in Austin on 25+ years of workforce development experience and a recurring Vision given to Michael Brown by God for serving His people. He brings deep expertise in workforce development, occupational training and education, business development, project management, and community development, consistently driving organizational excellence across the public and private sectors. As the former owner of Consulting Solutions.Net and a key leader with the Texas Workforce Commission, Workforce Solutions, the City of Austin, ReWork America Alliance, Goodwill Central Texas, the Austin Area Urban League, Apprentice Now, Austin Urban Technology Movement, Universal Tech Movement, and African American Youth Harvest Foundation, Michael has repeatedly demonstrated his ability to grow mission-driven programs through thoughtful strategic planning, operational innovation, and continuous improvement.',
  },
  {
    slug: 'adriane-brown',
    name: 'Adriane Brown',
    role: 'Chief Operating Officer',
    founder: false,
    initials: 'AB',
    missionRelevance:
      'Operations leader who scales workforce programs. Brings systems rigor so every member gets the support they need — from intake through placement.',
    cardBio:
      "Texas A&M grad. IBM, Accenture — built statewide tech systems for Texas. Co-led Brown & Associates to national reach. Microsoft Project Management certificate. Women's Ministry Leader, Celebration Church.",
  },
];

const boardMembers = [
  {
    slug: 'lakecia-gunter',
    name: 'Lakecia Gunter',
    role: 'Board Member',
    initials: 'LG',
    missionRelevance:
      'Employer-side credibility. Our employer partners are the rooms she helps shape — Microsoft, enterprise partners, and the tech pathways our graduates walk into.',
    cardBio:
      'CTO, Global Partner Solutions at Microsoft. 25 years in tech. SUCCESS Magazine Women of Influence 2023. MS Electrical Engineering, Georgia Tech. Board Director, IDEX Corporation.',
  },
  {
    slug: 'brandon-frye',
    name: 'Brandon Frye',
    role: 'Board Member',
    initials: 'BF',
    missionRelevance:
      'Highly respected entrepreneur that influences direction and resources. Built a Fastest Growing Company; board leadership strengthens community pipelines and employer connections.',
    cardBio:
      'Co-founded Interstate Connections — Austin Business Journal "Fastest Growing Private Company." CFO, The Business Bible. Texas Alliance for Life board. Former Chairman, Concordia High School.',
  },
  {
    slug: 'derrick-fishback',
    name: 'Col. Derrick Fishback',
    role: 'Board Member (Ret.)',
    initials: 'DF',
    missionRelevance:
      '30 years Army + Fortune 500 tech. The employer trust that opens doors — AWS, IBM, Dell — plus the discipline that turns training into outcomes.',
    cardBio:
      "Col. U.S. Army (Ret.). Commanded 1,800+ personnel. Led cloud transformation at AWS, IBM, Dell. Two master's degrees; Harvard, Geneva, London, Erasmus. Board President, Jazz Society of Pensacola.",
  },
];

const leadConsultants = [
  {
    slug: 'michael-brown-ii',
    name: 'Michael Brown II',
    role: 'Lead Consultant',
    initials: 'M2',
    missionRelevance:
      'Bridges strategy and delivery — helping WorkforceAP turn training partnerships into measurable placement and retention outcomes.',
    cardBio:
      'Consultant to Workforce Advancement Project on program design, employer alignment, and scaling high-touch career services for underserved communities.',
  },
];
---
<Layout
  title="Board & Leadership — WorkforceAP"
  description="Meet the leadership team behind WorkforceAP — decades of workforce experience, employer-side tech credibility, military discipline, and nationwide community impact."
>
<!-- SPLIT HERO -->
<section class="hero"><div class="wrap">
  <div class="lead-hero-grid">
    <div class="lead-hero-main">
      <span class="eyebrow"><span class="dot"></span>Our Leadership</span>
      <h1>Stewards of the <span class="grad-text">Future Workforce.</span></h1>
      <p class="sub">Our governance team combines decades of workforce development leadership, employer-side tech credibility, military and operations discipline, and deep community roots — connecting workforce training to real outcomes across the nation.</p>
    </div>
    <aside class="quote-card">
      <div class="qhead">
        <span class="qbadge" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12l2 2 4-4"/><circle cx="12" cy="12" r="9"/></svg>
        </span>
        <span class="qlabel">Established 2025</span>
      </div>
      <blockquote>This isn't a generic nonprofit team. These are people who've run programs at scale, led at Goodwill and Urban League, built systems at IBM and Microsoft, commanded in the Army and at AWS — and who show up nationwide.</blockquote>
    </aside>
  </div>
</div></section>

<!-- EXECUTIVE COUNCIL -->
<section class="band"><div class="wrap">
  <div class="sec-head">
    <span class="eyebrow">Executive Council</span>
    <h2>Operational Leadership</h2>
  </div>
  <div class="tri lead-exec">
    {executives.map((leader) => (
      <a class="acard person" href={`/leadership/${leader.slug}`}>
        <div class="portrait" aria-hidden="true">
          <span class="initials">{leader.initials}</span>
          {leader.founder && <span class="founder">Founder</span>}
        </div>
        <span class="role">{leader.role}</span>
        <h3>{leader.name}</h3>
        <p class="mission">{leader.missionRelevance}</p>
        <p>{leader.cardBio}</p>
        <span class="go">View profile →</span>
      </a>
    ))}
  </div>
</div></section>

<!-- BOARD OF TRUSTEES -->
<section class="band band--surface"><div class="wrap">
  <div class="sec-head">
    <span class="eyebrow">Board of Trustees</span>
    <h2>Strategic Governance</h2>
  </div>
  <div class="tri">
    {boardMembers.map((leader) => (
      <a class="acard person" href={`/leadership/${leader.slug}`}>
        <div class="portrait" aria-hidden="true">
          <span class="initials">{leader.initials}</span>
        </div>
        <span class="role">{leader.role}</span>
        <h3>{leader.name}</h3>
        <p class="mission">{leader.missionRelevance}</p>
        <p>{leader.cardBio}</p>
        <span class="go">View profile →</span>
      </a>
    ))}
  </div>
</div></section>

<!-- LEAD CONSULTANT -->
<section class="band"><div class="wrap">
  <div class="sec-head">
    <span class="eyebrow">Advisory</span>
    <h2>Lead Consultant</h2>
  </div>
  <div class="tri">
    {leadConsultants.map((leader) => (
      <a class="acard person" href={`/leadership/${leader.slug}`}>
        <div class="portrait" aria-hidden="true">
          <span class="initials">{leader.initials}</span>
        </div>
        <span class="role">{leader.role}</span>
        <h3>{leader.name}</h3>
        <p class="mission">{leader.missionRelevance}</p>
        <p>{leader.cardBio}</p>
        <span class="go">View profile →</span>
      </a>
    ))}
  </div>
</div></section>

<!-- CTA -->
<section class="band band--surface"><div class="wrap">
  <div class="cta">
    <h2>Join the Mission</h2>
    <p>Whether you want to partner, volunteer, serve on the board, or support workforce development nationwide — we want to hear from you.</p>
    <div class="acts">
      <a class="btn btn--light" href="/contact">Get in Touch</a>
      <a class="btn btn--translucent" href="/programs">View Programs</a>
    </div>
  </div>
</div></section>

<style>
  /* Split hero: main column + quote-card companion */
  .lead-hero-grid{display:grid;grid-template-columns:1.4fr 1fr;gap:48px;align-items:center}
  @media(max-width:960px){.lead-hero-grid{grid-template-columns:1fr;gap:32px}}

  /* Quote card — hero companion (truthful, no fabricated metrics) */
  .quote-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:30px;box-shadow:var(--shadow-lg)}
  .qhead{display:flex;align-items:center;gap:12px;margin-bottom:16px}
  .qbadge{width:40px;height:40px;border-radius:12px;background:rgba(74,155,79,.14);color:var(--green);display:grid;place-items:center;flex-shrink:0}
  .qlabel{font-size:13px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;color:var(--gold-dark)}
  .quote-card blockquote{font-family:'Plus Jakarta Sans',sans-serif;font-weight:600;font-size:21px;line-height:1.4;color:var(--text)}
  .quote-card blockquote::before{content:'\201C';color:var(--crimson)}
  .quote-card blockquote::after{content:'\201D';color:var(--crimson)}

  /* Leader cards reuse .acard; add portrait + role + mission styling */
  .person{display:flex;flex-direction:column}
  .lead-exec{grid-template-columns:repeat(2,1fr)}
  @media(max-width:880px){.lead-exec{grid-template-columns:1fr}}

  .portrait{position:relative;width:88px;height:88px;border-radius:20px;background:var(--grad);display:grid;place-items:center;margin-bottom:18px;box-shadow:0 12px 30px -10px rgba(173,44,77,.5)}
  .portrait .initials{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:30px;color:#fff;letter-spacing:-.02em}
  .portrait .founder{position:absolute;bottom:-9px;left:50%;transform:translateX(-50%);white-space:nowrap;font-size:11px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;color:#fff;background:linear-gradient(135deg,var(--gold),var(--gold-dark));padding:4px 11px;border-radius:999px;box-shadow:0 8px 20px -6px rgba(164,127,56,.6)}

  .person .role{font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--crimson)}
  .person h3{font-size:22px;font-weight:700;margin:6px 0 12px}
  .person .mission{color:var(--text);font-weight:600;font-size:15px;margin-bottom:12px}
  .person p{color:var(--muted);font-size:15px;margin-bottom:16px}
  .person .go{margin-top:auto;font-weight:700;color:var(--crimson);font-size:15px}
  .person:hover .go{color:var(--accent-dark)}
</style>
</Layout>
