---
import Layout from '../layouts/Layout.astro';
---
<Layout
  title="Public impact — WorkforceAP"
  description="WorkforceAP impact reporting—verified metrics publish here as member and employer activity is recorded."
>
<!-- HERO + MEMBERS SERVED METRIC -->
<section class="hero impact-hero"><div class="wrap">
  <span class="eyebrow"><span class="dot"></span>Impact reporting</span>
  <h1>Measured progress,<br><span class="grad-text">published carefully</span></h1>
  <p class="sub">Metrics appear here once there is enough verified data to share publicly — figures stay blank until then.</p>

  <div class="hero-metric">
    <p class="hm-v empty" aria-label="Not published yet">—</p>
    <p class="hm-lbl">Member metrics not published yet</p>
    <p class="hm-desc">Member counts and cohort rates publish here as verified member and employer activity is recorded — not before.</p>
    <a class="section-link" href="/employers">Become a hiring partner <span aria-hidden="true">→</span></a>
  </div>
</div></section>

<!-- COHORT METRICS -->
<section class="band band--surface" aria-label="Cohort metrics we publish when verified"><div class="wrap">
  <div class="preview-panel">
    <p class="preview-heading">Cohort metrics we publish when verified</p>
    <div class="facts stat-grid">
      <div class="stat-card">
        <p class="sv empty" aria-hidden="true">—</p>
        <div class="sl">Completion rate (enrolled cohort)<span class="footnote">Published once enrolled program cohorts have recorded activity.</span></div>
        <span class="pill">Not published yet</span>
      </div>
      <div class="stat-card">
        <p class="sv empty" aria-hidden="true">—</p>
        <div class="sl">Placement rate (enrolled cohort)<span class="footnote">Published once enrolled program cohorts have recorded activity.</span></div>
        <span class="pill">Not published yet</span>
      </div>
      <div class="stat-card">
        <p class="sv empty" aria-hidden="true">—</p>
        <div class="sl">Avg. salary increase<span class="footnote">Reported after placement follow-ups; insufficient paired data to show an average yet.</span></div>
        <span class="pill">Not published yet</span>
      </div>
    </div>
    <p class="methodology">Dash (—) means a metric is not published yet. Rates use enrolled program cohorts; salary averages use paired offer and follow-up wages where both are on file.</p>
  </div>
</div></section>

<!-- PROGRAMS -->
<section class="band" aria-label="Programs"><div class="wrap">
  <div class="sec-head impact-head">
    <h2>Programs</h2>
    <p>Per-program breakdowns publish here once enrolled cohorts have recorded activity.</p>
  </div>
  <div class="ptable-wrap">
    <table class="ptable">
      <thead>
        <tr>
          <th scope="col">Program</th>
          <th scope="col" class="num">Enrolled</th>
          <th scope="col" class="num">Completed</th>
          <th scope="col" class="num hide-sm">Avg. time to complete</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td colspan="4" class="empty-row">
            <strong>Program cohorts not recorded yet</strong>
            <span>No enrolled program cohorts recorded yet.</span>
          </td>
        </tr>
      </tbody>
    </table>
  </div>
</div></section>

<!-- EMPLOYERS -->
<section class="band band--surface" aria-label="Employers"><div class="wrap">
  <div class="sec-head impact-head">
    <h2>Employers</h2>
    <p>Employer counts and pipeline activity publish here once records are on file.</p>
  </div>
  <div class="info-card">
    <h3>Employer metrics not published yet</h3>
    <p>Partnership counts, job posts, and placement records appear here once active employer activity is on file.</p>
  </div>
  <p class="methodology">Counts reflect registered employer accounts on file — not verified hiring outcomes unless noted.</p>
  <a class="section-link" href="/employers">Become a hiring partner <span aria-hidden="true">→</span></a>
</div></section>

<!-- MEMBER STORIES -->
<section class="band" aria-label="Member stories"><div class="wrap">
  <div class="sec-head impact-head">
    <h2>Member stories</h2>
    <p>Consented member stories appear only after staff review.</p>
  </div>
  <div class="info-card">
    <h3>No member stories published yet</h3>
    <p>WorkforceAP shows member stories only after consent and staff review.</p>
  </div>
</div></section>

<!-- FUNDERS -->
<section class="band band--surface" aria-label="Funders"><div class="wrap narrow">
  <div class="sec-head impact-head">
    <h2>Funders</h2>
  </div>
  <div class="funder-card">
    <span class="eyebrow">Nonprofit model</span>
    <h3>Grant-funded access</h3>
    <p>WorkforceAP is a 501(c)(3) nonprofit. Funded by grants and partners, no-cost for qualifying members.</p>
    <div class="funder-actions">
      <a class="btn btn--ghost" href="/outcomes">Placement outcomes detail</a>
      <a class="btn btn--primary" href="/apply">Apply</a>
    </div>
  </div>
</div></section>

<style>
  .impact-hero{padding:72px 0 40px;text-align:center}
  .impact-hero .eyebrow{margin-bottom:20px}
  .impact-hero h1{font-size:clamp(36px,5.5vw,60px);font-weight:800;margin:0 0 20px}
  .impact-hero .sub{font-size:20px;color:var(--muted);max-width:34em;margin:0 auto}

  .hero-metric{margin:44px auto 0;max-width:520px;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:36px 32px;box-shadow:var(--shadow);text-align:center}
  .hm-v{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:clamp(48px,8vw,72px);line-height:1;background:var(--grad-text);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
  .hm-v.empty{color:var(--border);-webkit-text-fill-color:var(--border);background:none}
  .hm-lbl{font-weight:700;font-size:17px;margin-top:14px}
  .hm-desc{color:var(--muted);font-size:15px;margin-top:8px;max-width:30em;margin-left:auto;margin-right:auto}
  .section-link{display:inline-flex;align-items:center;gap:7px;margin-top:18px;font-weight:700;color:var(--crimson)}
  .section-link:hover{color:var(--accent-dark)}

  .preview-panel{max-width:960px;margin:0 auto}
  .preview-heading{text-align:center;font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:clamp(22px,3vw,30px);margin-bottom:32px}
  .stat-grid{align-items:stretch}
  .stat-card{position:relative;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:30px 24px;box-shadow:var(--shadow);text-align:center;display:flex;flex-direction:column;align-items:center}
  .stat-card .sv{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:clamp(34px,4.5vw,48px);line-height:1;background:var(--grad-text);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
  .stat-card .sv.empty{color:var(--border);-webkit-text-fill-color:var(--border);background:none}
  .stat-card .sl{font-weight:700;font-size:15px;margin-top:14px}
  .stat-card .footnote{display:block;font-weight:400;font-size:13px;color:var(--muted);margin-top:8px;line-height:1.5}
  .pill{margin-top:16px;font-size:12px;font-weight:700;letter-spacing:.02em;padding:6px 13px;border-radius:999px;background:rgba(164,127,56,.14);color:var(--gold-dark)}
  .methodology{max-width:760px;margin:28px auto 0;text-align:center;color:var(--muted);font-size:14px;line-height:1.6}

  .impact-head{text-align:left;margin:0 0 30px;max-width:none}
  .impact-head h2{margin:0 0 10px}
  .impact-head p{font-size:18px}

  .ptable-wrap{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);box-shadow:var(--shadow);overflow:hidden}
  .ptable{width:100%;border-collapse:collapse;font-size:15px}
  .ptable thead th{text-align:left;padding:16px 22px;font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);background:var(--surface-2);border-bottom:1px solid var(--border)}
  .ptable th.num{text-align:right}
  .ptable .empty-row{padding:40px 22px;text-align:center;color:var(--muted)}
  .ptable .empty-row strong{display:block;color:var(--text);font-size:16px;margin-bottom:6px}
  .ptable .empty-row span{font-size:14px}
  @media(max-width:640px){.ptable .hide-sm{display:none}}

  .info-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:32px;box-shadow:var(--shadow)}
  .info-card h3{font-family:'Plus Jakarta Sans',sans-serif;font-size:20px;font-weight:700;margin-bottom:8px}
  .info-card p{color:var(--muted);font-size:15px;max-width:50em}

  .narrow{max-width:760px}
  .funder-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:40px 36px;box-shadow:var(--shadow);text-align:center}
  .funder-card .eyebrow{margin-bottom:16px}
  .funder-card h3{font-family:'Plus Jakarta Sans',sans-serif;font-size:clamp(24px,3vw,32px);font-weight:800;margin-bottom:12px}
  .funder-card p{color:var(--muted);font-size:17px;max-width:36em;margin:0 auto 26px}
  .funder-actions{display:flex;gap:14px;justify-content:center;flex-wrap:wrap}
</style>
</Layout>
