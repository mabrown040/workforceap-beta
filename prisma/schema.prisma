enum MessageThreadKind {
  member
  employer
  partner

  @@map("message_thread_kind")
}

// Portal ↔ team chat: member–counselor, employer–admin, partner–admin (Realtime on messages + message_threads)
model MessageThread {
  id                   String            @id @default(uuid())
  kind                 MessageThreadKind @default(member) @map("kind")
  memberId             String?           @unique @map("member_id")
  employerId           String?           @unique @map("employer_id")
  partnerId            String?           @unique @map("partner_id")
  counselorUserId      String?           @map("counselor_user_id")
  memberLastReadAt     DateTime?         @map("member_last_read_at")
  counselorLastReadAt  DateTime?         @map("counselor_last_read_at")
  portalUserLastReadAt DateTime?         @map("portal_user_last_read_at")
  staffLastReadAt      DateTime?         @map("staff_last_read_at")
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")

  member      User?     @relation("MemberMessageThreads", fields: [memberId], references: [id], onDelete: Cascade)
  employer    Employer? @relation(fields: [employerId], references: [id], onDelete: Cascade)
  partner     Partner?  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
