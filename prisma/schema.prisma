/// Tracks nudge emails sent to members for the G5 retention loop so we don't
/// re-fire the same tier within the cooldown window (default 7 days).
/// `tier` matches the at-risk classification: 'yellow' | 'red'.
/// `kind` identifies the specific template ('check_in' | 'come_back' | 'stuck').
model MemberNudgeLog {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tier      String   // 'yellow' | 'red'
  kind      String   // 'check_in' | 'come_back' | 'stuck'
  reasons   Json?    // snapshot of reasons[] from classifyMember()
  sentAt    DateTime @default(now()) @map("sent_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind, sentAt])
  @@index([userId, tier, sentAt])
  @@index([sentAt])
  @@map("member_nudge_logs")
}

enum PlacementSurveyWave {
  thirty_day
  sixty_day
  ninety_day

  // The CREATE TYPE migration (20260513000000_add_placement_survey_wave)
  // names the Postgres enum `placement_survey_wave` (snake_case), but
  // without this @@map Prisma's generated client expects the PascalCase
  // type "PlacementSurveyWave". `prisma migrate deploy` reports drift
  // on every run. Audit (2026-05-15, migration drift P0 #2).
  @@map("placement_survey_wave")
}

model PlacementSurvey {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  placementId     String   @map("placement_id")
  wave            PlacementSurveyWave @default(thirty_day) @map("wave")
  sentAt          DateTime @default(now()) @map("sent_at")
  completedAt     DateTime? @map("completed_at")
  escalatedAt     DateTime? @map("escalated_at")

  // Core questions (1-5 scale)
  jobSatisfaction   Int? @map("job_satisfaction")     // "How satisfied are you with your job?"
  trainingRelevance Int? @map("training_relevance")   // "How relevant was your training?"
  supportQuality    Int? @map("support_quality")      // "How was the counselor support?"

  // Open feedback
  whatHelpedMost    String? @map("what_helped_most") @db.Text
  whatCouldImprove  String? @map("what_could_improve") @db.Text

  // Outcome tracking
  stillEmployed     Boolean? @map("still_employed")
  currentSalary     Int? @map("current_salary")       // annual, updated if changed

  // Consent for testimonial use
  allowTestimonial  Boolean @default(false) @map("allow_testimonial")

  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  placement  PlacementRecord @relation(fields: [placementId], references: [id], onDelete: Cascade)

  @@unique([userId, wave])
  @@index([userId])
  @@index([sentAt])
  @@index([placementId])
  @@map("placement_surveys")
}

