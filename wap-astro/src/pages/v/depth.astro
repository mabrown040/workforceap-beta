---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="WorkforceAP — Empowering People. Advancing Futures.">
<div class="depth">

  <!-- ===== HERO: deep gradient stage with stacked glass ===== -->
  <section class="stage">
    <div class="aura aura--1"></div>
    <div class="aura aura--2"></div>
    <div class="aura aura--3"></div>
    <div class="grain"></div>

    <div class="wrap stage-grid">
      <div class="lede">
        <span class="pill">★ 501(c)(3) nonprofit · Employer-recognized certificates</span>
        <h1>Empowering People.<br><span class="shimmer">Advancing Futures.</span></h1>
        <p class="sub">Employer-aligned training, professional certificates, and real career support — at no cost to qualifying members.</p>
        <div class="acts">
          <a class="dbtn dbtn--solid" href="/apply">Start your application <span>→</span></a>
          <a class="dbtn dbtn--glass" href="/find-your-path">Find your path</a>
        </div>
        <div class="proof">
          <div class="proof-i"><b>25+</b><span>years in workforce development</span></div>
          <div class="proof-i"><b>$0</b><span>for qualifying members</span></div>
          <div class="proof-i"><b>1–2 days</b><span>real-team review</span></div>
        </div>
      </div>

      <!-- stacked translucent cards -->
      <div class="deck">
        <div class="card card--back">
          <div class="card-tag">Recognized credential</div>
          <div class="logos">
            <span>IBM</span><span>Google</span><span>Microsoft</span><span>AWS</span><span>CompTIA</span>
          </div>
        </div>

        <div class="card card--mid">
          <div class="mid-row">
            <small>Your pathway</small>
            <span class="dot-live">Live</span>
          </div>
          <div class="mid-big">From apply to hired</div>
          <div class="track">
            <i class="t-done"></i><i class="t-done"></i><i class="t-now"></i><i></i>
          </div>
          <div class="track-labels"><span>Apply</span><span>Match</span><span>Certify</span><span>Launch</span></div>
        </div>

        <div class="card card--front">
          <div class="front-head">
            <div class="ic">✓</div>
            <div>
              <b>Application reviewed</b>
              <span>A real team follows up in 1–2 business days.</span>
            </div>
          </div>
          <div class="meter">
            <span>Cost to qualifying members</span>
            <strong>$0</strong>
          </div>
          <div class="chips">
            <span>~5 min to apply</span>
            <span>No cost</span>
            <span>Real career support</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== CERT PARTNERS BAND ===== -->
  <section class="creds-band">
    <div class="wrap">
      <p class="creds-lab">Employer-recognized credentials you can earn</p>
      <div class="creds-row">
        <span class="logo">IBM</span><span class="logo">Google</span><span class="logo">Microsoft</span><span class="logo">AWS</span><span class="logo">CompTIA</span>
        <span class="creds-extra">+ CPT &amp; CLT</span>
      </div>
    </div>
  </section>

  <!-- ===== HOW IT WORKS: layered depth cards ===== -->
  <section class="howd">
    <div class="wrap">
      <div class="head">
        <span class="eyebrow-d">The journey</span>
        <h2>Four steps, fully supported</h2>
        <p>From application to a recognized credential and career support — with a real team behind you the whole way.</p>
      </div>
      <div class="flow">
        <div class="fcard">
          <div class="fnum">01</div>
          <h3>Apply</h3>
          <p>Takes about 5 minutes. No cost for qualifying members — a real team reviews it.</p>
        </div>
        <div class="fcard">
          <div class="fnum">02</div>
          <h3>Get matched</h3>
          <p>We match you to the program track that fits your goals and background.</p>
        </div>
        <div class="fcard">
          <div class="fnum">03</div>
          <h3>Train &amp; certify</h3>
          <p>Build job-ready skills and earn an employer-recognized professional certificate.</p>
        </div>
        <div class="fcard">
          <div class="fnum">04</div>
          <h3>Launch</h3>
          <p>Move into the workforce with resume, interview, and mentor support behind you.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== WHO WE SERVE: dark depth band with glass cards ===== -->
  <section class="serve">
    <div class="aura aura--4"></div>
    <div class="wrap">
      <div class="head head--light">
        <span class="eyebrow-d eyebrow-d--light">A connected network</span>
        <h2>Built for members, employers &amp; partners</h2>
      </div>
      <div class="tri">
        <div class="gcard">
          <div class="gic">👥</div>
          <h3>Members</h3>
          <p>No-cost, employer-aligned training, professional certificates, and a team that supports you to job-ready.</p>
          <a href="/apply">Start your application →</a>
        </div>
        <div class="gcard">
          <div class="gic">🏢</div>
          <h3>Employers</h3>
          <p>Build a pipeline of training-aligned candidates for in-demand roles — no per-placement fees.</p>
          <a href="/employers">Talk with us about hiring →</a>
        </div>
        <div class="gcard">
          <div class="gic">🏛️</div>
          <h3>Partners</h3>
          <p>Extend workforce impact in your community through referral and program partnerships.</p>
          <a href="/partners">Explore partnership →</a>
        </div>
      </div>
      <p class="truthnote">We're a nonprofit — so we don't inflate outcomes. We publish verified placement data as cohorts complete, with the methodology shown. <a href="/outcomes">See our outcomes →</a></p>
    </div>
  </section>

  <!-- ===== TRUST FACTS ===== -->
  <section class="facts-d">
    <div class="wrap factsgrid">
      <div class="fct"><div class="k">25+ yrs</div><p>In workforce development</p></div>
      <div class="fct"><div class="k">501(c)(3)</div><p>Nonprofit organization</p></div>
      <div class="fct"><div class="k">$0</div><p>For qualifying members</p></div>
      <div class="fct"><div class="k">5</div><p>Employer-recognized cert tracks</p></div>
    </div>
  </section>

  <!-- ===== CLOSING CTA ===== -->
  <section class="closing">
    <div class="wrap">
      <div class="cta-stage">
        <div class="aura aura--5"></div>
        <div class="cta-inner">
          <h2>Your next step starts with one application.</h2>
          <p>Apply in about 5 minutes — no cost for qualifying members. A real team reviews it and follows up in 1 to 2 business days.</p>
          <div class="acts acts--center">
            <a class="dbtn dbtn--light" href="/apply">Start your application</a>
            <a class="dbtn dbtn--glass" href="/find-your-path">Find your path</a>
            <a class="dbtn dbtn--glass" href="/employers">For employers</a>
          </div>
        </div>
      </div>
    </div>
  </section>

</div>

<style>
  /* ===== DEPTH variant — dramatic, layered, dimensional. ===== */
  .depth{--ink:#2a0d1c;--glass:rgba(255,255,255,.10);--glass-line:rgba(255,255,255,.18)}

  /* ---------- HERO STAGE ---------- */
  .stage{
    position:relative;overflow:hidden;isolation:isolate;
    background:radial-gradient(140% 120% at 80% -10%, #b8334f 0%, var(--accent-dark) 42%, var(--plum) 74%, #4a0e26 100%);
    color:#fff;padding:96px 0 120px;
  }
  .stage-grid{display:grid;grid-template-columns:1.02fr .98fr;gap:60px;align-items:center;position:relative;z-index:2}

  /* soft glows */
  .aura{position:absolute;border-radius:50%;filter:blur(70px);z-index:0;pointer-events:none}
  .aura--1{width:520px;height:520px;top:-160px;right:-120px;background:radial-gradient(circle,rgba(196,154,72,.55),transparent 68%)}
  .aura--2{width:460px;height:460px;bottom:-200px;left:-140px;background:radial-gradient(circle,rgba(173,44,77,.6),transparent 70%)}
  .aura--3{width:380px;height:380px;top:30%;left:42%;background:radial-gradient(circle,rgba(255,255,255,.16),transparent 70%)}
  .grain{position:absolute;inset:0;z-index:1;opacity:.5;mix-blend-mode:overlay;pointer-events:none;
    background-image:url('https://www.workforceap.org/images/hero-people.webp');background-size:cover;background-position:center;
    -webkit-mask-image:linear-gradient(90deg,transparent 0%,transparent 38%,#000 100%);
    mask-image:linear-gradient(90deg,transparent 0%,transparent 38%,#000 100%);opacity:.18}

  /* gold pill — fully visible, not clipped */
  .pill{display:inline-flex;align-items:center;gap:7px;max-width:100%;white-space:nowrap;
    background:linear-gradient(135deg,#e3bd6a,#a47f38);color:#3a2c10;font-weight:800;font-size:12.5px;
    letter-spacing:.02em;line-height:1.1;padding:9px 17px;border-radius:999px;
    box-shadow:0 10px 28px -8px rgba(164,127,56,.6),0 1px 0 rgba(255,255,255,.4) inset}
  @media(max-width:430px){.pill{white-space:normal;text-align:left}}

  .lede h1{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:clamp(42px,6vw,74px);
    line-height:1.02;letter-spacing:-.03em;margin:22px 0 0}
  .shimmer{background:linear-gradient(100deg,#fff 10%,#f3d28f 50%,#fff 90%);
    -webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
  .lede .sub{font-size:20px;line-height:1.55;color:rgba(255,255,255,.82);max-width:30em;margin:22px 0 30px}

  .acts{display:flex;gap:14px;flex-wrap:wrap}
  .acts--center{justify-content:center}
  .dbtn{display:inline-flex;align-items:center;gap:9px;font-weight:700;font-size:16px;padding:15px 28px;
    border-radius:14px;border:1px solid transparent;transition:transform .16s,box-shadow .22s,background .22s}
  .dbtn:hover{transform:translateY(-2px)}
  .dbtn--solid{background:linear-gradient(135deg,#fff,#fbeede);color:var(--accent-dark);
    box-shadow:0 18px 44px -14px rgba(0,0,0,.55),0 1px 0 rgba(255,255,255,.6) inset}
  .dbtn--solid span{transition:transform .2s}
  .dbtn--solid:hover span{transform:translateX(4px)}
  .dbtn--glass{background:rgba(255,255,255,.12);color:#fff;border-color:rgba(255,255,255,.32);backdrop-filter:blur(8px)}
  .dbtn--glass:hover{background:rgba(255,255,255,.2)}
  .dbtn--light{background:#fff;color:var(--accent-dark);box-shadow:0 16px 40px -14px rgba(0,0,0,.45)}

  .proof{display:flex;gap:30px;flex-wrap:wrap;margin-top:38px}
  .proof-i{display:flex;flex-direction:column;gap:2px}
  .proof-i b{font-family:'Plus Jakarta Sans';font-weight:800;font-size:26px;letter-spacing:-.02em}
  .proof-i span{font-size:13px;color:rgba(255,255,255,.7);max-width:13em}

  /* ---------- STACKED DECK ---------- */
  .deck{position:relative;min-height:430px}
  .card{position:absolute;left:0;right:0;border-radius:22px;padding:24px;
    background:var(--glass);border:1px solid var(--glass-line);backdrop-filter:blur(18px);
    box-shadow:0 30px 80px -30px rgba(0,0,0,.7),0 1px 0 rgba(255,255,255,.22) inset;color:#fff}

  .card--back{top:0;transform:rotate(-3deg) translateX(28px);background:rgba(255,255,255,.07);z-index:1}
  .card-tag{font-size:11px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:rgba(255,255,255,.72);margin-bottom:14px}
  .logos{display:flex;flex-wrap:wrap;gap:14px}
  .logos span{font-family:'Plus Jakarta Sans';font-weight:800;font-size:16px;color:rgba(255,255,255,.92);
    background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.16);padding:6px 12px;border-radius:10px}

  .card--mid{top:96px;transform:rotate(1.5deg);z-index:2;background:rgba(255,255,255,.13)}
  .mid-row{display:flex;align-items:center;justify-content:space-between}
  .mid-row small{font-size:12px;text-transform:uppercase;letter-spacing:.08em;color:rgba(255,255,255,.72);font-weight:700}
  .dot-live{display:inline-flex;align-items:center;gap:6px;font-size:12px;font-weight:700;color:#fff;
    background:rgba(74,155,79,.32);border:1px solid rgba(120,220,130,.4);padding:4px 10px;border-radius:999px}
  .dot-live::before{content:"";width:7px;height:7px;border-radius:50%;background:#7fe389;box-shadow:0 0 8px #7fe389}
  .mid-big{font-family:'Plus Jakarta Sans';font-weight:800;font-size:24px;margin:8px 0 18px}
  .track{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}
  .track i{height:8px;border-radius:5px;background:rgba(255,255,255,.2)}
  .track i.t-done{background:linear-gradient(90deg,#e3bd6a,#fff)}
  .track i.t-now{background:#fff;box-shadow:0 0 12px rgba(255,255,255,.8)}
  .track-labels{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:9px}
  .track-labels span{font-size:11px;color:rgba(255,255,255,.7);text-align:center}

  .card--front{top:262px;transform:rotate(-1deg);z-index:3;background:rgba(255,255,255,.16)}
  .front-head{display:flex;align-items:flex-start;gap:13px;margin-bottom:18px}
  .front-head .ic{flex-shrink:0;width:38px;height:38px;border-radius:11px;display:grid;place-items:center;
    background:rgba(74,155,79,.32);border:1px solid rgba(120,220,130,.4);color:#caffce;font-weight:800;font-size:17px}
  .front-head b{display:block;font-weight:700;font-size:15px}
  .front-head span{font-size:13px;color:rgba(255,255,255,.78)}
  .meter{display:flex;align-items:baseline;justify-content:space-between;padding:14px 16px;border-radius:13px;
    background:rgba(0,0,0,.18);border:1px solid rgba(255,255,255,.12);margin-bottom:14px}
  .meter span{font-size:13px;color:rgba(255,255,255,.8)}
  .meter strong{font-family:'Plus Jakarta Sans';font-weight:800;font-size:26px;color:#f3d28f}
  .chips{display:flex;flex-wrap:wrap;gap:8px}
  .chips span{font-size:12px;font-weight:700;padding:6px 12px;border-radius:999px;
    background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.18)}

  @media (prefers-reduced-motion: no-preference){
    .deck{animation:depth-float 8s ease-in-out infinite}
    @keyframes depth-float{0%,100%{transform:translateY(0)}50%{transform:translateY(-10px)}}
  }

  /* ---------- CREDS BAND ---------- */
  .creds-band{background:var(--surface);border-bottom:1px solid var(--border);padding:30px 0}
  .creds-lab{text-align:center;color:var(--muted);font-size:12px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;margin-bottom:14px}
  .creds-row{display:flex;align-items:center;justify-content:center;gap:38px;flex-wrap:wrap}
  .creds-row .logo{font-family:'Plus Jakarta Sans';font-weight:800;font-size:22px;color:#4a4440;opacity:.78}
  .creds-extra{color:var(--gold-dark);font-weight:700;font-size:15px}

  /* ---------- SHARED HEADS ---------- */
  .head{text-align:center;max-width:660px;margin:0 auto 48px}
  .eyebrow-d{display:inline-block;font-size:13px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;
    color:var(--crimson);background:rgba(173,44,77,.09);border:1px solid rgba(173,44,77,.18);padding:7px 15px;border-radius:999px}
  .eyebrow-d--light{color:#f3d28f;background:rgba(255,255,255,.1);border-color:rgba(255,255,255,.22)}
  .head h2{font-family:'Plus Jakarta Sans';font-weight:800;font-size:clamp(30px,4vw,48px);letter-spacing:-.02em;margin:16px 0 12px}
  .head p{color:var(--muted);font-size:19px;line-height:1.55}
  .head--light h2{color:#fff}
  .head--light p{color:rgba(255,255,255,.8)}

  /* ---------- HOW (depth cards) ---------- */
  .howd{background:var(--bg);padding:84px 0}
  .flow{display:grid;grid-template-columns:repeat(4,1fr);gap:20px}
  .fcard{position:relative;background:var(--surface);border:1px solid var(--border);border-radius:22px;padding:30px 26px;
    box-shadow:0 1px 2px rgba(28,20,20,.04),0 22px 48px -26px rgba(109,20,55,.28);transition:transform .22s,box-shadow .26s}
  .fcard:hover{transform:translateY(-6px);box-shadow:0 34px 70px -28px rgba(109,20,55,.4)}
  .fnum{font-family:'Plus Jakarta Sans';font-weight:800;font-size:40px;line-height:1;
    background:var(--grad-text);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;margin-bottom:14px}
  .fcard h3{font-family:'Plus Jakarta Sans';font-size:19px;font-weight:800;margin-bottom:8px}
  .fcard p{color:var(--muted);font-size:15px}

  /* ---------- SERVE (dark depth band) ---------- */
  .serve{position:relative;overflow:hidden;isolation:isolate;padding:90px 0;
    background:radial-gradient(120% 120% at 20% 0%, var(--plum) 0%, var(--accent-dark) 45%, #3c0a1f 100%);color:#fff}
  .aura--4{width:560px;height:560px;top:-180px;right:-160px;background:radial-gradient(circle,rgba(196,154,72,.4),transparent 70%)}
  .serve .wrap{position:relative;z-index:2}
  .tri{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}
  .gcard{background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.16);border-radius:22px;padding:30px;
    backdrop-filter:blur(14px);box-shadow:0 30px 70px -34px rgba(0,0,0,.7),0 1px 0 rgba(255,255,255,.16) inset;
    transition:transform .22s,box-shadow .26s,border-color .2s}
  .gcard:hover{transform:translateY(-6px);border-color:rgba(255,255,255,.34);box-shadow:0 40px 84px -34px rgba(0,0,0,.78)}
  .gic{width:52px;height:52px;border-radius:14px;display:grid;place-items:center;font-size:24px;margin-bottom:16px;
    background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.18)}
  .gcard h3{font-family:'Plus Jakarta Sans';font-size:21px;font-weight:800;margin-bottom:9px}
  .gcard p{color:rgba(255,255,255,.8);font-size:15px;margin-bottom:16px}
  .gcard a{font-weight:700;color:#f3d28f}
  .gcard a:hover{color:#fff}
  .truthnote{max-width:700px;margin:34px auto 0;text-align:center;color:rgba(255,255,255,.74);font-size:14px;
    background:rgba(255,255,255,.06);border:1px dashed rgba(255,255,255,.22);border-radius:14px;padding:16px 22px}
  .truthnote a{color:#f3d28f;font-weight:700}
  @media(max-width:880px){.tri{grid-template-columns:1fr}}

  /* ---------- FACTS ---------- */
  .facts-d{background:var(--surface);padding:64px 0;border-bottom:1px solid var(--border)}
  .factsgrid{display:grid;grid-template-columns:repeat(4,1fr);gap:24px;text-align:center}
  .fct .k{font-family:'Plus Jakarta Sans';font-weight:800;font-size:clamp(28px,3.4vw,42px);
    background:var(--grad-text);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
  .fct p{color:var(--muted);font-size:15px;margin-top:5px}
  @media(max-width:760px){.factsgrid{grid-template-columns:1fr 1fr}}

  /* ---------- CLOSING CTA ---------- */
  .closing{background:var(--bg);padding:30px 0 84px}
  .cta-stage{position:relative;overflow:hidden;isolation:isolate;border-radius:30px;
    background:radial-gradient(130% 130% at 80% 0%, #b8334f 0%, var(--accent-dark) 48%, var(--plum) 100%);
    color:#fff;padding:72px 32px;box-shadow:0 40px 90px -40px rgba(109,20,55,.6)}
  .aura--5{width:480px;height:480px;top:-200px;left:-120px;background:radial-gradient(circle,rgba(196,154,72,.45),transparent 70%)}
  .cta-inner{position:relative;z-index:2;text-align:center;max-width:760px;margin:0 auto}
  .cta-inner h2{font-family:'Plus Jakarta Sans';font-weight:800;font-size:clamp(30px,4.5vw,50px);letter-spacing:-.02em;margin-bottom:14px}
  .cta-inner p{font-size:19px;color:rgba(255,255,255,.88);max-width:34em;margin:0 auto 28px}

  /* ---------- RESPONSIVE ---------- */
  @media(max-width:880px){
    .stage{padding:72px 0 90px}
    .stage-grid{grid-template-columns:1fr;gap:80px}
    .deck{min-height:420px;margin-top:8px}
    .flow{grid-template-columns:1fr 1fr}
    .grain{-webkit-mask-image:none;mask-image:none;opacity:.12}
  }
  @media(max-width:560px){
    .flow{grid-template-columns:1fr}
    .card--back{transform:rotate(-2deg)}
    .card--mid{transform:rotate(1deg)}
    .card--front{transform:rotate(0)}
  }
</style>
</Layout>
