  entityType  String?  @map("entity_type")
  entityId    String?  @map("entity_id")

  employer Employer? @relation(fields: [employerId], references: [id], onDelete: Cascade)
  partner  Partner?  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  actor    User?     @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([employerId, createdAt])
  @@index([partnerId, createdAt])
  @@map("portal_workflow_events")
}

enum AIJobMatchStatus {
  suggested
  employer_notified
  student_notified
  rejected
  contacted
  interviewing
  hired

  @@map("ai_job_match_status")
}

model AIJobMatch {
  id              String           @id @default(uuid())
  jobId           String           @map("job_id")
  studentId       String           @map("student_id")
  matchScore      Int              @map("match_score")
  matchReasons    String[]         @default([]) @map("match_reasons")
  status          AIJobMatchStatus @default(suggested)
  statusUpdatedAt DateTime?        @map("status_updated_at")
  createdAt       DateTime         @default(now()) @map("created_at")

  job     Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([jobId, studentId])
  @@index([jobId])
  @@index([studentId])
  @@map("ai_job_matches")
}

// ─── Mentor Portal ───────────────────────────────────────────────────────────

model MentorSpecialty {
  id       String @id @default(uuid())
  mentorId String @map("mentor_id")
  name     String // e.g. "Resume Review", "Mock Interviews", "Career Pivots"

  mentor Mentor @relation(fields: [mentorId], references: [id], onDelete: Cascade)

  @@index([mentorId])
  @@map("mentor_specialties")
}

model Mentor {
  id                String    @id @default(uuid())
  userId            String    @unique @map("user_id")
  fullName          String    @map("full_name")
  title             String // e.g. "Senior Software Engineer at Google"
  company           String
  industry          String // e.g. "Technology", "Healthcare", "Finance"
  bio               String    @db.Text
  linkedinUrl       String?   @map("linkedin_url")
  availableHours    Int       @default(2) @map("available_hours") // hours/month available
  totalHoursDonated Float     @default(0) @map("total_hours_donated")
  isActive          Boolean   @default(true) @map("is_active")
  approvedAt        DateTime? @map("approved_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions    MentorSession[]
  specialties MentorSpecialty[]

  @@map("mentors")
}

model MentorSession {
  id             String              @id @default(uuid())
  mentorId       String              @map("mentor_id")
  memberId       String              @map("member_id")
  scheduledAt    DateTime            @map("scheduled_at")
  durationMin    Int                 @default(30) @map("duration_min")
  status         MentorSessionStatus @default(PENDING)
  topic          String?             @db.Text
  notes          String?             @db.Text
  memberFeedback String?             @map("member_feedback") @db.Text
  hoursLogged    Float?              @map("hours_logged")
  createdAt      DateTime            @default(now()) @map("created_at")

  mentor Mentor @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  member User   @relation("MentorSessionMember", fields: [memberId], references: [id], onDelete: Cascade)

  @@index([mentorId])
  @@index([memberId])
  @@map("mentor_sessions")
}

enum MentorSessionStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

// --- O*NET career intelligence ---

enum CareerExperienceBand {
  beginner
  some_experience
  experienced

  @@map("career_experience_band")
}

enum CareerRecommendationType {
  primary
  bridge
  stretch

  @@map("career_recommendation_type")
}

model OnetOccupation {
  onetCode        String   @id @map("onet_code")
  title           String
  description     String?  @db.Text
  jobFamily       String?  @map("job_family")
  brightOutlook   Boolean? @map("bright_outlook")
  educationLevel  String?  @map("education_level")
  experienceLevel String?  @map("experience_level")
  trainingLevel   String?  @map("training_level")
  salaryLow       Int?     @map("salary_low")
  salaryMedian    Int?     @map("salary_median")
  salaryHigh      Int?     @map("salary_high")
  outlookSummary  String?  @map("outlook_summary") @db.Text
  isActive        Boolean  @default(true) @map("is_active")
  rawJson         Json?    @map("raw_json")
  updatedAt       DateTime @updatedAt @map("updated_at")

  skills          OnetOccupationSkill[]
  tasks           OnetOccupationTask[]
  technologies    OnetOccupationTech[]
  relatedFrom     OnetRelatedOccupation[] @relation("RelatedFrom")
  relatedTo       OnetRelatedOccupation[] @relation("RelatedTo")
  programMappings CareerProgramMapping[]

  @@map("onet_occupations")
}

model OnetOccupationSkill {
  id         String @id @default(uuid())
  onetCode   String @map("onet_code")
  skillName  String @map("skill_name")
  importance Int?
  level      Int?

  occupation OnetOccupation @relation(fields: [onetCode], references: [onetCode], onDelete: Cascade)

  @@index([onetCode])
  @@map("onet_occupation_skills")
}

model OnetOccupationTask {
  id         String @id @default(uuid())
  onetCode   String @map("onet_code")
  taskText   String @map("task_text") @db.Text
  importance Int?

  occupation OnetOccupation @relation(fields: [onetCode], references: [onetCode], onDelete: Cascade)

  @@index([onetCode])
  @@map("onet_occupation_tasks")
}

model OnetOccupationTech {
  id             String  @id @default(uuid())
  onetCode       String  @map("onet_code")
  technologyName String  @map("technology_name")
  category       String?

  occupation OnetOccupation @relation(fields: [onetCode], references: [onetCode], onDelete: Cascade)

  @@index([onetCode])
  @@map("onet_occupation_tech")
}

model OnetRelatedOccupation {
  id               String  @id @default(uuid())
  onetCode         String  @map("onet_code")
  relatedOnetCode  String  @map("related_onet_code")
  relationshipType String? @map("relationship_type")

  occupation        OnetOccupation @relation("RelatedFrom", fields: [onetCode], references: [onetCode], onDelete: Cascade)
  relatedOccupation OnetOccupation @relation("RelatedTo", fields: [relatedOnetCode], references: [onetCode], onDelete: Cascade)

  @@index([onetCode])
  @@index([relatedOnetCode])
  @@map("onet_related_occupations")
}

model CareerProgramMapping {
  id                 String                   @id @default(uuid())
  onetCode           String                   @map("onet_code")
  programSlug        String                   @map("program_slug")
  priority           Int                      @default(1)
  experienceBand     CareerExperienceBand     @map("experience_band")
  recommendationType CareerRecommendationType @map("recommendation_type")
  whyRecommended     String?                  @map("why_recommended") @db.Text
  isActive           Boolean                  @default(true) @map("is_active")
  createdAt          DateTime                 @default(now()) @map("created_at")
  updatedAt          DateTime                 @updatedAt @map("updated_at")

  occupation OnetOccupation @relation(fields: [onetCode], references: [onetCode], onDelete: Cascade)

  @@index([onetCode])
  @@index([programSlug])
  @@index([isActive])
  @@map("career_program_mappings")
}

model CareerQuizRule {
  id            String   @id @default(uuid())
  ruleKey       String   @unique @map("rule_key")
  inputSignal   Json     @map("input_signal")
  boostOnetCode String   @map("boost_onet_code")
  weight        Int      @default(1)
  reasonText    String?  @map("reason_text") @db.Text
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("career_quiz_rules")
}

model MemberNextBestAction {
  id          String   @id @default(uuid())
  memberId    String   @map("member_id")
  title       String
  description String   @db.Text
  ctaLabel    String   @map("cta_label")
  ctaHref     String   @map("cta_href")
  icon        String?
  priority    Int      @default(0)
  status      String   @default("PENDING") // PENDING, COMPLETED, DISMISSED
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  member      User     @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, status, priority])
  @@map("member_next_best_actions")
}
